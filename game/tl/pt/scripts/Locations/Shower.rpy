translate pt strings:

    # game/scripts/Locations/Shower.rpy:24
    old "You step into the bathroom. Nobody's in here right now."
    new "Você entra no banheiro. Não tem ninguém aqui agora."

    # game/scripts/Locations/Shower.rpy:24
    old "You head to the bathroom with [main_girl.Name]."
    new "Você vai até o banheiro com [main_girl.Name]."

    # game/scripts/Locations/Shower.rpy:24
    old "You open the bathroom door and realize [main_girl.Name] is already inside."
    new "Você abre a porta do banheiro e percebe que [main_girl.Name] já está lá dentro."

    # game/scripts/Locations/Shower.rpy:24
    old "You walk toward the bathroom and notice the door is wide open."
    new "Você vai em direção ao banheiro e percebe que a porta está escancarada."

    # game/scripts/Locations/Shower.rpy:24
    old "The bathroom door is closed, and you can hear the water running inside."
    new "A porta do banheiro está fechada, e você consegue ouvir a água correndo lá dentro."

    # game/scripts/Locations/Shower.rpy:24
    old "You try the handle. The door is locked."
    new "Você tenta a maçaneta. A porta está trancada."

    # game/scripts/Locations/Shower.rpy:24
    old "You leave the bathroom."
    new "Você sai do banheiro."

    # game/scripts/Locations/Shower.rpy:24
    old "You step back from the doorway and leave the bathroom."
    new "Você recua da porta e sai do banheiro."

    # game/scripts/Locations/Shower.rpy:24
    old "You do not hear or see anyone inside the bathroom."
    new "Você não ouve nem vê ninguém dentro do banheiro."

    # game/scripts/Locations/Shower.rpy:24
    old "You walk toward the bathroom and hear the water running."
    new "Você vai em direção ao banheiro e ouve a água correndo."

    # game/scripts/Locations/Shower.rpy:24
    old "You silently back away from the bathroom door."
    new "Você se afasta em silêncio da porta do banheiro."

    # game/scripts/Locations/Shower.rpy:24
    old "Right. Because you always walk into the bathroom for no reason."
    new "Claro. Porque você sempre entra no banheiro sem motivo."

    # game/scripts/Locations/Shower.rpy:24
    old "You 'check on me' in the bathroom a lot, huh?"
    new "Você vive vindo 'ver como eu tô' no banheiro, hein?"

    # game/scripts/Locations/Shower.rpy:24
    old "Here? In the bathroom? ...What did you have in mind?"
    new "Aqui? No banheiro? ...O que você tem em mente?"

    # game/scripts/Locations/Shower.rpy:74
    old "Hey! Occupied!"
    new "Ei! Ocupado!"

    # game/scripts/Locations/Shower.rpy:74
    old "It's locked for a reason! Give me a minute!"
    new "Tá trancada por um motivo! Me dá um minuto!"

    # game/scripts/Locations/Shower.rpy:74
    old "Knock first! I'm in the shower!"
    new "Bate primeiro! Eu tô no banho!"

