translate pt strings:

    # game/scripts/Dialogs/stepmom_flirt_lines.rpy:34
    old "What the hell do you want? I'm busy. Go away."
    new "O que diabos você quer? Estou ocupada. Vá embora."

    # game/scripts/Dialogs/stepmom_flirt_lines.rpy:34
    old "Are you deaf? It's occupied! Get lost, boy."
    new "Você é surdo? Está ocupado! Suma daqui, garoto."

    # game/scripts/Dialogs/stepmom_flirt_lines.rpy:34
    old "I don't care what it is. Walk away before I lose my patience."
    new "Não me importa o que seja. Vá embora antes que eu perca a paciência."

    # game/scripts/Dialogs/stepmom_flirt_lines.rpy:34
    old "Who told you to come bother me? Leave. Now."
    new "Quem mandou você vir me incomodar? Saia. Agora."

    # game/scripts/Dialogs/stepmom_flirt_lines.rpy:34
    old "It's locked. Figure it out. Go away."
    new "Está trancada. Use a cabeça. Vá embora."

    # game/scripts/Dialogs/stepmom_flirt_lines.rpy:34
    old "What part of 'locked' do you not understand? Leave."
    new "Que parte de 'trancada' você não entendeu? Saia."

    # game/scripts/Dialogs/stepmom_flirt_lines.rpy:34
    old "The door is locked for a reason. Walk away, boy."
    new "A porta está trancada por um motivo. Vá embora, garoto."

    # game/scripts/Dialogs/stepmom_flirt_lines.rpy:34
    old "Are you an idiot? I already said it's locked. Go finish your paperwork or something."
    new "Você é idiota? Eu já disse que está trancada. Vá terminar sua papelada ou qualquer coisa."

    # game/scripts/Dialogs/stepmom_flirt_lines.rpy:34
    old "Did you not hear me the first time? It's locked. Go away before I come out there and make you."
    new "Você não me ouviu da primeira vez? Está trancada. Vá embora antes que eu saia e te obrigue."

    # game/scripts/Dialogs/stepmom_flirt_lines.rpy:34
    old "Twice? Are you stupid or just deaf? Get out of my sight."
    new "Duas vezes? Você é burro ou só surdo? Suma da minha frente."

