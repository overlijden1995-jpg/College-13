    # game/scripts/Dialogs/dialogue_bank.rpy:1291
    old "Mm! ...Okay. Whatever you want."
    new "Mm! ...Tá bom. O que você quiser."

    # game/scripts/Dialogs/dialogue_bank.rpy:1291
    old "That's... fine. You can. I won't move."
    new "Tudo... bem. Pode. Não vou me mexer."

    # game/scripts/Dialogs/dialogue_bank.rpy:1291
