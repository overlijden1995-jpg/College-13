translate pt do_shower_60b75ebf:

    # "The door closes hard enough to rattle the mirror."
    "A porta bate com tanta força que o espelho chega a tremer."

# game/scripts/Actions/actions.rpy:917
translate pt do_shower_35235e75_3:

    # "You finish your shower alone."
    "Você termina seu banho sozinho."

