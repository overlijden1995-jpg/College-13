    # game/scripts/Actions/tease.rpy:245
    old "Make her count"
    new "Fazer ela contar"

    # game/scripts/Actions/tease.rpy:245
    old "From now on you count every one. Out loud."
    new "A partir de agora você conta cada um. Em voz alta."

    # game/scripts/Actions/tease.rpy:245
    old "Every time my hand lands, I want to hear the number."
    new "Toda vez que minha mão bater, eu quero ouvir o número."

    # game/scripts/Actions/tease.rpy:245
    old "Count them for me. Don't you dare lose track."
    new "Conta pra mim. Nem pense em perder a conta."

    # game/scripts/Actions/tease.rpy:245
    old "Yes! Make me say every one. I want to hear how far you take me."
    new "Sim! Me faz dizer cada um. Quero ouvir até onde você me leva."

    # game/scripts/Actions/tease.rpy:245
    old "Counting. Please, start now. I want to get to a big number."
    new "Contando. Por favor, começa agora. Quero chegar num número grande."

    # game/scripts/Actions/tease.rpy:245
    old "Counting. I'm good at counting. I won't miss one."
    new "Contando. Eu sou boa em contar. Não vou pular nenhum."

    # game/scripts/Actions/tease.rpy:245
    old "Okay. Out loud. I'll keep an exact tally, you'll see."
    new "Tá bom. Em voz alta. Vou manter a conta exata, você vai ver."

    # game/scripts/Actions/tease.rpy:245
    old "...Yes. I'll count. Every one."
    new "...Sim. Eu conto. Cada um."

    # game/scripts/Actions/tease.rpy:245
    old "Out loud. Okay. ...Please don't go too high."
    new "Em voz alta. Tá bom. ...Por favor, não vai longe demais."

    # game/scripts/Actions/tease.rpy:245
    old "If that's what you want. I'll count."
    new "Se é isso que você quer. Eu conto."

    # game/scripts/Actions/tease.rpy:245
    old "Thank you... I'll keep doing exactly that. Tell me if it changes."
    new "Obrigada... vou continuar fazendo exatamente isso. Me avisa se mudar."

    # game/scripts/Actions/tease.rpy:245
    old "I'm... glad I did it right. Say it again? Only if you want."
    new "Que bom... que eu fiz certo. Fala de novo? Só se você quiser."

    # game/scripts/Actions/tease.rpy:245
    old "Good... I'm good? Then I'll stay like this."
    new "Boa... eu sou boa? Então eu fico assim."

    # game/scripts/Actions/tease.rpy:245
    old "I can't move... so I'll just listen. Say more. Please."
    new "Eu não consigo me mexer... então só vou ouvir. Fala mais. Por favor."

