    # "She immediately freezes and pulls away."
    "Ela congela na hora e se afasta."

translate pt caught_in_public_c904934e:

    # "She covers her face, mortified. She looks like she wants the ground to swallow her."
    "Ela cobre o rosto, mortificada. Parece que quer que o chão a engula."

translate pt caught_in_public_2c2891c5:

    # "She finally pulls away, looking more annoyed than embarrassed."
    "Ela finalmente se afasta, parecendo mais irritada do que envergonhada."

translate pt caught_in_public_30cf0a66:

    # "She pulls away from you immediately, face burning with shame."
    "Ela se afasta de você imediatamente, o rosto queimando de vergonha."

translate pt caught_in_public_600273d6:

    # "There's no way to talk your way out of this."
    "Não tem como sair dessa na conversa."

translate pt caught_in_public_12017017:

