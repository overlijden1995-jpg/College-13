translate pt strings:

    # game/scripts/Events/family_grades.rpy:401
    old "I sent you something for the scare. Spend it on coffee and STUDY. Please."
    new "Mandei uma coisa para você, pelo susto. Gaste com café e ESTUDE. Por favor."

