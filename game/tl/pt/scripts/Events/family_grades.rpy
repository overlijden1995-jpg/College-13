translate pt strings:

    # game/scripts/Events/family_grades.rpy:46
    old "I saw your grade. %s."
    new "Vi a sua nota. %s."

    # game/scripts/Events/family_grades.rpy:46
    old "Acceptable. Don't expect a reward for doing the bare minimum."
    new "Aceitável. Não espere uma recompensa por fazer o mínimo."

    # game/scripts/Events/family_grades.rpy:46
    old "%s. Your father hasn't stopped talking about it."
    new "%s. O seu pai não para de falar nisso."

    # game/scripts/Events/family_grades.rpy:46
    old "I told him not to get used to it. Prove me wrong."
    new "Eu disse a ele para não se acostumar. Prove que estou errada."

    # game/scripts/Events/family_grades.rpy:46
    old "%s. So you CAN study when you're afraid of me."
    new "%s. Então você CONSEGUE estudar quando tem medo de mim."

    # game/scripts/Events/family_grades.rpy:46
    old "Remember that feeling."
    new "Lembre-se dessa sensação."

    # game/scripts/Events/family_grades.rpy:46
    old "%s. Average."
    new "%s. Na média."

    # game/scripts/Events/family_grades.rpy:46
    old "I don't invest in average. Do better."
    new "Eu não invisto em quem fica na média. Faça melhor."

    # game/scripts/Events/family_grades.rpy:46
    old "Not a failure. Not a success either. Mediocrity is just failure taking its time."
    new "Não é um fracasso. Também não é um sucesso. A mediocridade é apenas o fracasso sem pressa."

    # game/scripts/Events/family_grades.rpy:46
    old "Do you have any idea what you cost this family?"
    new "Você faz ideia do quanto custa a esta família?"

    # game/scripts/Events/family_grades.rpy:46
    old "%s. I'm not even surprised."
    new "%s. Nem estou surpresa."

    # game/scripts/Events/family_grades.rpy:46
    old "Your father raised a disappointment. I'm going to fix that."
    new "O seu pai criou uma decepção. Eu vou consertar isso."

    # game/scripts/Events/family_grades.rpy:46
    old "%s?"
    new "%s?"

    # game/scripts/Events/family_grades.rpy:46
    old "You had two weeks. TWO WEEKS. And this is what you bring me?"
    new "Você teve duas semanas. DUAS SEMANAS. E é isso que você me traz?"

    # game/scripts/Events/family_grades.rpy:46
    old "The school called. You didn't even show up to your exam."
    new "A faculdade ligou. Você nem apareceu na prova."

    # game/scripts/Events/family_grades.rpy:46
    old "An automatic F. Do you know how that makes ME look?"
    new "Um F automático. Você sabe a imagem que isso passa de MIM?"

    # game/scripts/Events/family_grades.rpy:46
    old "You skipped your exam."
    new "Você faltou à prova."

    # game/scripts/Events/family_grades.rpy:46
    old "An F for not even showing up. Your father is speechless. I'm not."
    new "Um F por nem sequer aparecer. O seu pai ficou sem palavras. Eu não."

    # game/scripts/Events/family_grades.rpy:46
    old "I just took $%d from your account."
    new "Acabei de tirar $%d da sua conta."

    # game/scripts/Events/family_grades.rpy:46
    old "Consider it a refund on a bad investment."
    new "Considere isso o reembolso de um mau investimento."

    # game/scripts/Events/family_grades.rpy:46
    old "$%d. That's what your little vacation from the books just cost you."
    new "$%d. Foi isso que as suas feriazinhas longe dos livros acabaram de te custar."

    # game/scripts/Events/family_grades.rpy:46
    old "Your father gave me the password. He trusts me with everything."
    new "O seu pai me deu a senha. Ele me confia tudo."

    # game/scripts/Events/family_grades.rpy:46
    old "I went to take your money. There was nothing to take."
    new "Fui pegar o seu dinheiro. Não havia nada para pegar."

    # game/scripts/Events/family_grades.rpy:46
    old "Of course there wasn't."
    new "É claro que não havia."

    # game/scripts/Events/family_grades.rpy:46
    old "And no allowance. %d Fridays."
    new "E sem mesada. %d sextas-feiras."

    # game/scripts/Events/family_grades.rpy:46
    old "Your allowance is frozen. %d Fridays. Learn what things cost."
    new "Sua mesada está congelada. %d sextas-feiras. Aprenda quanto as coisas custam."

    # game/scripts/Events/family_grades.rpy:46
    old "And I know why your grades are falling. %s."
    new "E eu sei por que as suas notas estão caindo. %s."

    # game/scripts/Events/family_grades.rpy:46
    old "You're ending it. Tonight. By text."
    new "Você vai pôr um fim nisso. Hoje à noite. Por mensagem."

    # game/scripts/Events/family_grades.rpy:46
    old "This is that girl's fault. %s."
    new "A culpa é daquela garota. %s."

    # game/scripts/Events/family_grades.rpy:46
    old "Open her chat. You're ending it. Now."
    new "Abra a conversa dela. Você vai pôr um fim nisso. Agora."

    # game/scripts/Events/family_grades.rpy:46
    old "Look at these scores... It's because of that girl! Isn't it!"
    new "Olhe essas notas... É por causa daquela garota! Não é!"

    # game/scripts/Events/family_grades.rpy:46
    old "Break it off. Tonight... Or I'll do it for you... You won't like my methods."
    new "Termine. Hoje à noite... Ou eu termino por você... Você não vai gostar dos meus métodos."

    # game/scripts/Events/family_grades.rpy:46
    old "That girl... Tsk... She's not good enough for you... You're better off ending it..."
    new "Aquela garota... Tsk... Ela não é boa o bastante para você... É melhor você terminar..."

    # game/scripts/Events/family_grades.rpy:46
    old "Tonight. By text. I'll tell you exactly what to write."
    new "Hoje à noite. Por mensagem. Eu vou te dizer exatamente o que escrever."

    # game/scripts/Events/family_grades.rpy:46
    old "Write exactly what I tell you. Not one word more."
    new "Escreva exatamente o que eu disser. Nem uma palavra a mais."

    # game/scripts/Events/family_grades.rpy:46
    old "I can't see you anymore. I need to focus on my studies. It's over."
    new "Não posso mais te ver. Preciso focar nos estudos. Acabou."

    # game/scripts/Events/family_grades.rpy:46
    old "We're done. My grades come first. Please don't text me back."
    new "A gente terminou. Minhas notas vêm primeiro. Por favor, não me responda."

    # game/scripts/Events/family_grades.rpy:46
    old "I'm sorry. My family thinks you're a distraction, and they're right. It's over."
    new "Desculpa. Minha família acha que você é uma distração, e eles têm razão. Acabou."

    # game/scripts/Events/family_grades.rpy:46
    old "Good boy."
    new "Bom garoto."

    # game/scripts/Events/family_grades.rpy:46
    old "See how easy that was? Now study."
    new "Viu como foi fácil? Agora estude."

    # game/scripts/Events/family_grades.rpy:46
    old "Done? Good."
    new "Pronto? Ótimo."

    # game/scripts/Events/family_grades.rpy:46
    old "Your father will be relieved. So am I."
    new "O seu pai vai ficar aliviado. Eu também estou."

    # game/scripts/Events/family_grades.rpy:46
    old "No?"
    new "Não?"

    # game/scripts/Events/family_grades.rpy:46
    old "Then you'll learn what my patience costs."
    new "Então você vai aprender quanto custa a minha paciência."

    # game/scripts/Events/family_grades.rpy:46
    old "You're telling ME no?"
    new "Você está dizendo não para MIM?"

    # game/scripts/Events/family_grades.rpy:46
    old "Fine. Keep her. You'll pay for her too."
    new "Tudo bem. Fique com ela. Você vai pagar por ela também."

    # game/scripts/Events/family_grades.rpy:46
    old "%s. Your father thinks it was a B."
    new "%s. O seu pai acha que foi um B."

    # game/scripts/Events/family_grades.rpy:46
    old "I told him myself. You owe me, and I always collect."
    new "Eu mesma contei a ele. Você me deve, e eu sempre cobro."

    # game/scripts/Events/family_grades.rpy:46
    old "Don't worry about your grade."
    new "Não se preocupe com a sua nota."

    # game/scripts/Events/family_grades.rpy:46
    old "I told your father you've been studying hard. You can thank me tonight."
    new "Eu disse ao seu pai que você tem estudado muito. Pode me agradecer hoje à noite."

    # game/scripts/Events/family_grades.rpy:46
    old "%s. Look at you."
    new "%s. Olhe só para você."

    # game/scripts/Events/family_grades.rpy:46
    old "Maybe I'll let you celebrate with me."
    new "Talvez eu deixe você comemorar comigo."

    # game/scripts/Events/family_grades.rpy:46
    old "Are you still seeing %s?"
    new "Você ainda está saindo com a %s?"

    # game/scripts/Events/family_grades.rpy:46
    old "That girl. %s. Is she the reason you look so tired lately?"
    new "Aquela garota. %s. É por causa dela que você anda tão cansado ultimamente?"

    # game/scripts/Events/family_grades.rpy:46
    old "I asked around about %s. I'm not impressed."
    new "Andei perguntando sobre a %s. Não fiquei impressionada."

    # game/scripts/Events/family_grades.rpy:46
    old "Everything you do is my business. Your father's roof is my roof."
    new "Tudo o que você faz é da minha conta. O teto do seu pai é o meu teto."

    # game/scripts/Events/family_grades.rpy:46
    old "Careful. I'm the one who decides what's my business."
    new "Cuidado. Sou eu quem decide o que é da minha conta."

    # game/scripts/Events/family_grades.rpy:46
    old "Take it slow all the way to the exit."
    new "Vá devagar até a saída, então."

    # game/scripts/Events/family_grades.rpy:46
    old "Slow is good. Slow is easy to stop."
    new "Devagar é bom. Devagar é fácil de parar."

    # game/scripts/Events/family_grades.rpy:169
    old "Shion showed me your grade! That's my boy."
    new "A Shion me mostrou sua nota! Esse é o meu garoto."

    # game/scripts/Events/family_grades.rpy:169
    old "Saw your grade, kid. Proud of you. Even Shion smiled. Almost."
    new "Vi sua nota, garoto. Tenho orgulho de você. Até a Shion sorriu. Quase."

    # game/scripts/Events/family_grades.rpy:169
    old "A C is fine, son. Don't tell Shion I said that."
    new "Um C está bom, filho. Não conte pra Shion que eu disse isso."

    # game/scripts/Events/family_grades.rpy:169
    old "Shion told me about the money. Don't be mad at her, kid."
    new "A Shion me contou sobre o dinheiro. Não fique bravo com ela, garoto."

    # game/scripts/Events/family_grades.rpy:169
    old "She just wants you to take this seriously."
    new "Ela só quer que você leve isso a sério."

    # game/scripts/Events/family_grades.rpy:169
    old "Shion told me about the money. I backed her up."
    new "A Shion me contou sobre o dinheiro. Eu dei razão a ela."

    # game/scripts/Events/family_grades.rpy:169
    old "You brought this on yourself, son."
    new "Você mesmo procurou isso, filho."

    # game/scripts/Events/family_grades.rpy:169
    old "Shion told me about the girl. I know it hurts, kid."
    new "A Shion me contou sobre a garota. Eu sei que dói, garoto."

    # game/scripts/Events/family_grades.rpy:169
    old "She's thinking about your future. We both are."
    new "Ela está pensando no seu futuro. Nós dois estamos."

    # game/scripts/Events/family_grades.rpy:169
    old "Your grades were slipping because of some girl?"
    new "Suas notas estavam caindo por causa de uma garota qualquer?"

    # game/scripts/Events/family_grades.rpy:169
    old "Shion did the right thing. Focus."
    new "A Shion fez a coisa certa. Foco."

    # game/scripts/Events/family_grades.rpy:169
    old "Shion says you talked back to her."
    new "A Shion disse que você respondeu mal pra ela."

    # game/scripts/Events/family_grades.rpy:169
    old "That's not how I raised you, son."
    new "Não foi assim que eu te criei, filho."

    # game/scripts/Events/family_grades.rpy:169
    old "Shion says you've been studying hard. Proud of you, son."
    new "A Shion disse que você tem estudado muito. Tenho orgulho de você, filho."

    # game/scripts/Events/family_grades.rpy:169
    old "Shion told me your grade was great! See? She's good for you."
    new "A Shion me disse que sua nota foi ótima! Viu? Ela te faz bem."

    # game/scripts/Events/family_grades.rpy:169
    old "Shion showed me your grade. Proud of you, son!"
    new "A Shion me mostrou sua nota. Tenho orgulho de você, filho!"

    # game/scripts/Events/family_grades.rpy:441
    old "Fine. I'll do it."
    new "Tudo bem. Eu faço."

    # game/scripts/Events/family_grades.rpy:441
    old "No. I'm not breaking up with her."
    new "Não. Eu não vou terminar com ela."

    # game/scripts/Events/family_grades.rpy:441
    old "No. I'm not breaking up with them."
    new "Não. Eu não vou terminar com elas."

    # game/scripts/Events/family_grades.rpy:482
    old "It's over."
    new "Acabou."

    # game/scripts/Events/family_grades.rpy:618
    old "She's none of your business."
    new "Ela não é da sua conta."

    # game/scripts/Events/family_grades.rpy:618
    old "We're taking it slow."
    new "Estamos indo devagar."

