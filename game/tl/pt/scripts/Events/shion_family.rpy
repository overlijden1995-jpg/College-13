translate pt strings:

    # game/scripts/Events/shion_family.rpy:66
    old "Shion sounded out of breath on the phone last night."
    new "A Shion parecia sem fôlego no telefone ontem à noite."

    # game/scripts/Events/shion_family.rpy:66
    old "Is your dorm too hot or something? Make sure she's comfortable, kid."
    new "O seu dormitório é quente demais ou algo assim? Garanta que ela fique confortável, garoto."

