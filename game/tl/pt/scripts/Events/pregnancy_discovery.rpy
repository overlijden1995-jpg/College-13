    # "[_arrive_line]"
    "[_arrive_line]"

# game/scripts/Events/pregnancy_discovery.rpy:2108
translate pt d028fb86:

    # "The other students can feel the tension. A few of them slow down, watching."
    "Os outros alunos sentem a tensão. Alguns diminuem o passo, observando."

# game/scripts/Events/pregnancy_discovery.rpy:2158
translate pt 63445c99:

    # "[_swing]"
    "[_swing]"

# game/scripts/Events/pregnancy_discovery.rpy:2159
translate pt 3768b447:

    # "But you see it coming a mile away."
    "Mas você vê o golpe vindo de longe."

