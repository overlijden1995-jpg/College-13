    # "You get a series of messages. [_birth_girl.Name] is having another baby."
    "Você recebe uma série de mensagens. [_birth_girl.Name] vai ter outro bebê."

# game/scripts/Events/pregnancy_discovery.rpy:2464
translate pt 1a570ae0:

    # "You get a series of messages. [_birth_girl.Name] is having the baby."
    "Você recebe uma série de mensagens. [_birth_girl.Name] vai ter o bebê."

# game/scripts/Events/pregnancy_discovery.rpy:2465
translate pt 0957a7b1:

    # "She'll be gone for about a week."
    "Ela vai ficar fora por mais ou menos uma semana."

# game/scripts/Events/pregnancy_discovery.rpy:2480
