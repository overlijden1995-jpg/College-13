# game/scripts/Events/pregnancy_discovery.rpy:2193
translate pt 63445c99_1:

    # "[_swing]"
    "[_swing]"

# game/scripts/Events/pregnancy_discovery.rpy:2194
translate pt f08a2d4c:

    # "You don't react fast enough."
    "Você não reage rápido o bastante."

# game/scripts/Events/pregnancy_discovery.rpy:2198
translate pt f4321565:

    # "The fist connects with your jaw. Hard."
    "O soco acerta seu queixo. Com força."

