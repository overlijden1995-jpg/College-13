    "[_npc_birth_narr]"

# game/scripts/Events/pregnancy_discovery.rpy:2505
translate pt 6c2813b4:

    # "You get a message from [_ret_girl.Name]. She's back on campus."
    "Você recebe uma mensagem de [_ret_girl.Name]. Ela voltou pro campus."

# game/scripts/Events/pregnancy_discovery.rpy:2506
translate pt 8bf879e3:

    # "The baby is with her family."
    "O bebê está com a família dela."

