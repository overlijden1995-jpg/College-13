# game/scripts/Events/guess_who.rpy:90
translate pt guess_who_event_dadef1f0:

    # "Someone's hands cover your eyes from behind."
    "As mãos de alguém cobrem seus olhos por trás."

# game/scripts/Events/guess_who.rpy:110
translate pt guess_who_event_a56e068a:

    # "A voice whispers behind you..."
    "Uma voz sussurra atrás de você..."

