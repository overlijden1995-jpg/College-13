# game/scripts/Events/guess_who.rpy:119
translate pt guess_who_event_85bccba0:

    # "The hands feel warm and soft against your face. Who could it be?"
    "As mãos são quentes e macias no seu rosto. Quem será?"

# game/scripts/Events/guess_who.rpy:142
translate pt guess_who_event_4b557312:

    # "The hands pull away and you turn around."
    "As mãos se afastam e você se vira."

# game/scripts/Events/guess_who.rpy:150
translate pt guess_who_event_3ee9ae8f:

    # "A man in a full Santa outfit, complete with a fake beard and a red hat."
    "Um homem com uma fantasia completa de Papai Noel, com barba falsa e chapéu vermelho."

# game/scripts/Events/guess_who.rpy:151
translate pt guess_who_event_d1969fbf:

    # "\"Ho ho ho! You got me! Merry Christmas!\""
    "\"Ho ho ho! Você me pegou! Feliz Natal!\""

# game/scripts/Events/guess_who.rpy:152
translate pt guess_who_event_96bcbb00:

    # "He pats you on the shoulder and walks away humming a carol."
    "Ele dá um tapinha no seu ombro e sai cantarolando uma música de Natal."

# game/scripts/Events/guess_who.rpy:153
translate pt guess_who_event_b3ece2df:

    # "...It's not even December."
    "...Nem é dezembro."

# game/scripts/Events/guess_who.rpy:176
translate pt guess_who_event_ec09f0ef:

    # "She smiles at you, pleased that you recognized her."
    "Ela sorri pra você, feliz que você a reconheceu."

# game/scripts/Events/guess_who.rpy:185
translate pt guess_who_event_95f69c33:

    # "A man in a full Santa outfit stares at you, looking offended."
    "Um homem com uma fantasia completa de Papai Noel olha pra você, parecendo ofendido."

# game/scripts/Events/guess_who.rpy:186
translate pt guess_who_event_934cb22c:

    # "\"I'm SANTA CLAUS! How do you not recognize these hands?!\""
    "\"Eu sou o PAPAI NOEL! Como você não reconhece essas mãos?!\""

# game/scripts/Events/guess_who.rpy:187
translate pt guess_who_event_3029e579:

    # "He storms off, muttering about ungrateful youth."
    "Ele sai furioso, resmungando sobre juventude ingrata."

# game/scripts/Events/guess_who.rpy:211
translate pt guess_who_event_e8af565f:

    # "She looks disappointed."
    "Ela parece decepcionada."

