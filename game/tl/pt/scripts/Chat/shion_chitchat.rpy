translate pt strings:

    # game/scripts/Chat/shion_chitchat.rpy:31
    old "Why are you still standing there?"
    new "Por que você ainda está parado aí?"

    # game/scripts/Chat/shion_chitchat.rpy:31
    old "Find something useful to do. Preferably somewhere else."
    new "Encontre algo útil para fazer. De preferência em outro lugar."

    # game/scripts/Chat/shion_chitchat.rpy:31
    old "Did you wipe your feet?"
    new "Você limpou os pés?"

    # game/scripts/Chat/shion_chitchat.rpy:31
    old "Don't make me ask twice. I hate repeating myself."
    new "Não me faça perguntar duas vezes. Detesto me repetir."

    # game/scripts/Chat/shion_chitchat.rpy:31
    old "Lower your voice. This isn't your dorm."
    new "Fale baixo. Aqui não é o seu dormitório."

    # game/scripts/Chat/shion_chitchat.rpy:31
    old "And take your hands out of your pockets when I'm talking to you."
    new "E tire as mãos dos bolsos quando eu estiver falando com você."

    # game/scripts/Chat/shion_chitchat.rpy:31
    old "Don't touch the wine. That bottle costs more than your tuition."
    new "Não toque no vinho. Essa garrafa custa mais que a sua mensalidade."

    # game/scripts/Chat/shion_chitchat.rpy:31
    old "I'm serious. I count them."
    new "Estou falando sério. Eu conto as garrafas."

    # game/scripts/Chat/shion_chitchat.rpy:31
    old "What do you want? Make it quick."
    new "O que você quer? Seja rápido."

    # game/scripts/Chat/shion_chitchat.rpy:31
    old "My time costs money. Yours doesn't."
    new "O meu tempo custa dinheiro. O seu, não."

    # game/scripts/Chat/shion_chitchat.rpy:31
    old "Sit up straight. You're not at a frat party."
    new "Sente direito. Você não está numa festa de fraternidade."

    # game/scripts/Chat/shion_chitchat.rpy:31
    old "Honestly. Your father raised you in a barn."
    new "Francamente. Seu pai te criou num celeiro."

