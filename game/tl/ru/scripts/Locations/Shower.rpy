translate ru strings:

    # game/scripts/Locations/Shower.rpy:24
    old "You head to the showers. It looks like nobody else is here right now."
    new "Ты идёшь в душевую. Похоже, сейчас здесь больше никого нет."

    # game/scripts/Locations/Shower.rpy:24
    old "You head to the showers with [main_girl.Name]."
    new "Ты идёшь в душевую с {case=ins}[main_girl.Name]{/case}."

    # game/scripts/Locations/Shower.rpy:24
    old "As you step into the showers, you realize [main_girl.Name] is already here."
    new "Войдя в душевую, ты понимаешь, что [main_girl.Name] уже здесь."

    # game/scripts/Locations/Shower.rpy:24
    old "You arrive at the showers and notice the door is already open."
    new "Ты подходишь к душевой и замечаешь, что дверь уже открыта."

    # game/scripts/Locations/Shower.rpy:24
