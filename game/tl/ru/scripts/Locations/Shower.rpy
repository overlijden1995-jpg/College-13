    old "You decide to leave the showers and go back to campus."
    new "Ты решаешь уйти из душевой и вернуться в кампус."

    # game/scripts/Locations/Shower.rpy:24
    old "You step back from the doorway and leave the showers behind."
    new "Ты отступаешь от двери и уходишь из душевой."

    # game/scripts/Locations/Shower.rpy:24
    old "You do not hear or see anyone else inside the showers."
    new "Ты никого не видишь и не слышишь в душевой."

    # game/scripts/Locations/Shower.rpy:24
    old "You head to the showers and hear the water running."
    new "Ты идёшь в душевую и слышишь шум воды."

    # game/scripts/Locations/Shower.rpy:24
    old "You silently back away and leave the showers."
