    # game/scripts/Locations/Shower.rpy:24
    old "Right. Because you always walk into the showers for no reason."
    new "Ну да. Ты же всегда заходишь в душ просто так."

    # game/scripts/Locations/Shower.rpy:24
    old "You 'check on me' in the showers a lot, huh?"
    new "Ты часто «проверяешь, как я» в душе, а?"

    # game/scripts/Locations/Shower.rpy:24
    old "Here? In the showers? ...What did you have in mind?"
    new "Здесь? В душе? ...И что ты задумал?"

    # game/scripts/Locations/Shower.rpy:24
    old "You step into the bathroom. Nobody's in here right now."
    new "Ты заходишь в ванную. Сейчас здесь никого."

    # game/scripts/Locations/Shower.rpy:24
    old "You head to the bathroom with [main_girl.Name]."
    new "Ты идёшь в ванную с {case=ins}[main_girl.Name]{/case}."

    # game/scripts/Locations/Shower.rpy:24
    old "You open the bathroom door and realize [main_girl.Name] is already inside."
    new "Ты открываешь дверь ванной и понимаешь, что [main_girl.Name] уже там."

    # game/scripts/Locations/Shower.rpy:24
    old "You walk toward the bathroom and notice the door is wide open."
    new "Ты идёшь к ванной и замечаешь, что дверь распахнута."

    # game/scripts/Locations/Shower.rpy:24
    old "The bathroom door is closed, and you can hear the water running inside."
    new "Дверь ванной закрыта, внутри слышен шум воды."

    # game/scripts/Locations/Shower.rpy:24
    old "You try the handle. The door is locked."
    new "Ты дёргаешь ручку. Дверь заперта."

    # game/scripts/Locations/Shower.rpy:24
    old "You leave the bathroom."
    new "Ты выходишь из ванной."

    # game/scripts/Locations/Shower.rpy:24
    old "You step back from the doorway and leave the bathroom."
    new "Ты отступаешь от двери и уходишь от ванной."

    # game/scripts/Locations/Shower.rpy:24
    old "You do not hear or see anyone inside the bathroom."
    new "Ты никого не видишь и не слышишь в ванной."

    # game/scripts/Locations/Shower.rpy:24
    old "You walk toward the bathroom and hear the water running."
    new "Ты идёшь к ванной и слышишь шум воды."

    # game/scripts/Locations/Shower.rpy:24
    old "You silently back away from the bathroom door."
    new "Ты тихо отходишь от двери ванной."

    # game/scripts/Locations/Shower.rpy:24
    old "Right. Because you always walk into the bathroom for no reason."
    new "Ну да. Ты же всегда заходишь в ванную просто так."

    # game/scripts/Locations/Shower.rpy:24
    old "You 'check on me' in the bathroom a lot, huh?"
    new "Ты часто «проверяешь, как я» в ванной, а?"

    # game/scripts/Locations/Shower.rpy:24
    old "Here? In the bathroom? ...What did you have in mind?"
    new "Здесь? В ванной? ...И что ты задумал?"

    # game/scripts/Locations/Shower.rpy:74
    old "Hey! Occupied!"
    new "Эй! Занято!"

    # game/scripts/Locations/Shower.rpy:74
    old "It's locked for a reason! Give me a minute!"
    new "Заперто не просто так! Дай мне минуту!"

    # game/scripts/Locations/Shower.rpy:74
    old "Knock first! I'm in the shower!"
    new "Сначала стучись! Я в душе!"

    # game/scripts/Locations/Shower.rpy:117
    old "Get the hell out! I don't care what you've seen, LEAVE!"
    new "Вали отсюда к чёрту! Мне плевать, что ты видел, УХОДИ!"

    # game/scripts/Locations/Shower.rpy:117
    old "You've got three seconds before I throw something at you."
    new "У тебя три секунды, потом я чем-нибудь в тебя запущу."

    # game/scripts/Locations/Shower.rpy:117
    old "KYAA! D-don't look! Please don't look at me!"
    new "КЯА! Н-не смотри! Пожалуйста, не смотри на меня!"

    # game/scripts/Locations/Shower.rpy:117
    old "No no no! This is so embarrassing! Turn around!"
    new "Нет-нет-нет! Как стыдно! Отвернись!"

    # game/scripts/Locations/Shower.rpy:117
    old "What if someone else comes in?! Close the door! GET OUT!"
    new "А если ещё кто-то зайдёт?! Закрой дверь! ВОН!"

    # game/scripts/Locations/Shower.rpy:117
    old "Oh god, did anyone else see?! Please tell me no one saw!"
    new "Боже, кто-нибудь ещё видел?! Скажи, что никто не видел!"

    # game/scripts/Locations/Shower.rpy:117
    old "Again? At this point you're doing it on purpose. Whatever."
    new "Опять? Ты уже явно делаешь это нарочно. Ну и ладно."

    # game/scripts/Locations/Shower.rpy:117
    old "You've seen it all before. Take a picture, it lasts longer."
    new "Ты всё это уже видел. Сфоткай, дольше любоваться будешь."

    # game/scripts/Locations/Shower.rpy:117
    old "I-I'm used to you seeing me by now... just don't stare TOO much."
    new "Я-я уже привыкла, что ты меня видишь... только не пялься СЛИШКОМ сильно."

    # game/scripts/Locations/Shower.rpy:117
    old "You've seen me like this before... it's still embarrassing though."
    new "Ты уже видел меня такой... но мне всё равно стыдно."

    # game/scripts/Locations/Shower.rpy:117
    old "Mmm, enjoy the show? I left the door unlocked on purpose."
    new "Ммм, нравится шоу? Я нарочно не заперла дверь."

    # game/scripts/Locations/Shower.rpy:117
    old "I was hoping you'd walk in. Like what you see?"
    new "Я надеялась, что ты зайдёшь. Нравится то, что видишь?"

    # game/scripts/Locations/Shower.rpy:117
    old "My {hint}boyfriend{/hint} never gets this kind of view. Lucky you."
    new "Мой {hint}парень{/hint} никогда не видит меня такой. Везёт тебе."

    # game/scripts/Locations/Shower.rpy:117
    old "If my {hint}boyfriend{/hint} walked in instead of you, that'd be a problem."
    new "Если бы вместо тебя зашёл мой {hint}парень{/hint}, была бы проблема."

    # game/scripts/Locations/Shower.rpy:117
    old "Like what you see? Get in here or get out."
    new "Нравится то, что видишь? Залезай ко мне или выметайся."

    # game/scripts/Locations/Shower.rpy:117
    old "Stop staring and do something about it."
    new "Хватит пялиться, сделай уже что-нибудь."

    # game/scripts/Locations/Shower.rpy:117
    old "I... I don't mind if it's you seeing me..."
    new "Я... я не против, если меня видишь ты..."

    # game/scripts/Locations/Shower.rpy:117
    old "You make me feel safe even when I'm... like this."
    new "С тобой мне спокойно, даже когда я... вот такая."

    # game/scripts/Locations/Shower.rpy:117
    old "I don't just want you to look. I want you to enjoy it."
    new "Я хочу, чтобы ты не просто смотрел. Я хочу, чтобы ты наслаждался."

    # game/scripts/Locations/Shower.rpy:117
    old "The door wasn't locked for a reason, you know."
    new "Дверь была не заперта не просто так, знаешь ли."

    # game/scripts/Locations/Shower.rpy:117
    old "This is the most anyone has ever seen of me... and it's you."
    new "Никто ещё не видел меня настолько... и это ты."

    # game/scripts/Locations/Shower.rpy:117
    old "I've never been naked in front of someone before... is this okay?"
    new "Я никогда раньше не была голой перед кем-то... это нормально?"

    # game/scripts/Locations/Shower.rpy:117
    old "R-really? You think I look amazing...? *hides face*"
    new "П-правда? Ты думаешь, я выгляжу потрясающе...? *прячет лицо*"

    # game/scripts/Locations/Shower.rpy:117
    old "Don't say things like that when I'm barely dressed..."
    new "Не говори такого, когда я почти раздета..."

    # game/scripts/Locations/Shower.rpy:117
    old "Obviously. Now stop being weird about it."
    new "Само собой. А теперь хватит вести себя странно."

    # game/scripts/Locations/Shower.rpy:117
    old "You'd better remember that view. It doesn't come free."
    new "Запомни этот вид получше. Он не бесплатный."

    # game/scripts/Locations/Shower.rpy:117
    old "I know. And I love that you can't look away."
    new "Знаю. И мне нравится, что ты не можешь отвести взгляд."

    # game/scripts/Locations/Shower.rpy:117
    old "The look on your face is everything I wanted."
    new "Твоё лицо сейчас... именно этого я и хотела."

    # game/scripts/Locations/Shower.rpy:117
    old "Maybe next time I'll give you a private show."
    new "Может, в следующий раз устрою тебе приватное шоу."

    # game/scripts/Locations/Shower.rpy:117
    old "You want more? I can arrange that."
    new "Хочешь ещё? Это можно устроить."

    # game/scripts/Locations/Shower.rpy:117
    old "M-more?! You're so greedy... but maybe... someday."
    new "Е-ещё?! Ты такой жадный... но, может... когда-нибудь."

    # game/scripts/Locations/Shower.rpy:117
    old "That's... a lot to ask... but I'm not saying never."
    new "Это... слишком много просишь... но я не говорю «никогда»."

    # game/scripts/Locations/Shower.rpy:117
    old "I've never shown anyone more than this before..."
    new "Я никогда никому не показывала больше этого..."

    # game/scripts/Locations/Shower.rpy:117
    old "You want to see more of me? I... I'll think about it."
    new "Хочешь увидеть меня больше? Я... я подумаю."

    # game/scripts/Locations/Shower.rpy:117
    old "Are you alone?! Please tell me nobody else is out there!"
    new "Ты один?! Скажи, что там больше никого нет!"

    # game/scripts/Locations/Shower.rpy:117
    old "Close the door! NOW! If anyone else sees me like this I swear..."
    new "Закрой дверь! СЕЙЧАС ЖЕ! Если кто-то ещё увидит меня такой, клянусь..."

    # game/scripts/Locations/Shower.rpy:117
    old "You better not have your phone on you. I mean it."
    new "Надеюсь, у тебя нет с собой телефона. Я серьёзно."

    # game/scripts/Locations/Shower.rpy:117
    old "It's just you, right? ...Okay. Just do not tell anyone you saw me like this."
    new "Здесь только ты, да? ...Ладно. Только никому не говори, что видел меня такой."

    # game/scripts/Locations/Shower.rpy:117
    old "Fine, you've seen me. But if I ever find out you told someone, we're done."
    new "Ладно, ты меня видел. Но если я узнаю, что ты кому-то рассказал, между нами всё кончено."

    # game/scripts/Locations/Shower.rpy:117
    old "This stays between us. No one else gets to see me like this. Only you."
    new "Это останется между нами. Никто больше не увидит меня такой. Только ты."

    # game/scripts/Locations/Shower.rpy:117
    old "I trust you enough to let you look... but if you ever share this, I will end you."
    new "Я доверяю тебе настолько, чтобы позволить смотреть... но если ты кому-то это покажешь, я тебя прикончу."

    # game/scripts/Locations/Shower.rpy:117
    old "T-thanks... just keep it to yourself, okay? I do not want people talking."
    new "С-спасибо... только держи это при себе, ладно? Не хочу, чтобы пошли разговоры."

    # game/scripts/Locations/Shower.rpy:117
    old "You really think so? Just... promise me this stays between us."
    new "Правда так думаешь? Только... пообещай, что это останется между нами."

    # game/scripts/Locations/Shower.rpy:117
    old "More? Maybe... but only if I know for sure no one else will ever find out."
    new "Больше? Может быть... но только если я буду точно знать, что никто никогда не узнает."

    # game/scripts/Locations/Shower.rpy:117
    old "I might show you more someday. Behind a locked door. With the curtains drawn."
    new "Может, когда-нибудь покажу тебе больше. За запертой дверью. С задёрнутыми шторами."

    # game/scripts/Locations/Shower.rpy:117
    old "Hey! At least buy me dinner first... actually, no, just get in here or get out."
    new "Эй! Сначала хоть на ужин своди... хотя нет, либо залезай ко мне, либо выметайся."

    # game/scripts/Locations/Shower.rpy:117
    old "You scared me! But honestly, I do not really care if you see me naked."
    new "Ты меня напугал! Но, честно, мне не особо важно, что ты видишь меня голой."

    # game/scripts/Locations/Shower.rpy:117
    old "Oh please, like a little nudity is going to bother me. Enjoy the view."
    new "Ой, брось, будто меня смутит немного наготы. Наслаждайся видом."

    # game/scripts/Locations/Shower.rpy:117
    old "Bodies are bodies. I am not shy about mine. Are you shy about yours?"
    new "Тело есть тело. Я своего не стесняюсь. А ты своего стесняешься?"

    # game/scripts/Locations/Shower.rpy:117
    old "You act like you have never seen a naked woman before. Relax."
    new "Ведёшь себя так, будто голую женщину никогда не видел. Расслабься."

    # game/scripts/Locations/Shower.rpy:117
    old "Like what you see? Because I can think of a few things we could do about it."
    new "Нравится то, что видишь? Потому что у меня есть пара идей, что мы могли бы с этим сделать."

    # game/scripts/Locations/Shower.rpy:117
    old "Stop pretending to be embarrassed. We both know what you want."
    new "Хватит изображать смущение. Мы оба знаем, чего ты хочешь."

    # game/scripts/Locations/Shower.rpy:117
    old "You know, the shower is big enough for two..."
    new "Знаешь, душ достаточно большой для двоих..."

    # game/scripts/Locations/Shower.rpy:117
    old "I know. And trust me, I look even better up close."
    new "Знаю. И поверь, вблизи я выгляжу ещё лучше."

    # game/scripts/Locations/Shower.rpy:117
    old "Amazing? Honey, you have not seen anything yet."
    new "Потрясающе? Милый, ты ещё ничего не видел."

    # game/scripts/Locations/Shower.rpy:117
    old "More? All you had to do was ask. I have no problem with that."
    new "Больше? Достаточно было просто попросить. Я совсем не против."

    # game/scripts/Locations/Shower.rpy:117
    old "Get in here and I will show you everything you want to see."
    new "Залезай ко мне, и я покажу всё, что ты хочешь увидеть."

    # game/scripts/Locations/Shower.rpy:117
    old "I was hoping you would say that. Come closer."
    new "Я надеялась, что ты это скажешь. Подойди ближе."

    # game/scripts/Locations/Shower.rpy:117
    old "Ew, do NOT look at me! This is a private space! Out! OUT!"
    new "Фу, НЕ смотри на меня! Это личное пространство! Вон! ВОН!"

    # game/scripts/Locations/Shower.rpy:117
    old "This is so gross... you just standing there staring at my body. Leave!"
    new "Это так мерзко... ты просто стоишь и пялишься на моё тело. Уходи!"

    # game/scripts/Locations/Shower.rpy:117
    old "I do not want anyone seeing me like this. It is disgusting. Go away."
    new "Я не хочу, чтобы кто-то видел меня такой. Это отвратительно. Уходи."

    # game/scripts/Locations/Shower.rpy:117
    old "Fine, you have seen me. Can you at least not... leer? It is uncomfortable."
    new "Ладно, ты меня видел. Можешь хотя бы не... пялиться так похабно? Это неприятно."

    # game/scripts/Locations/Shower.rpy:117
    old "I am not thrilled about this, but whatever. Just keep your distance."
    new "Я не в восторге, но ладно. Только держи дистанцию."

    # game/scripts/Locations/Shower.rpy:117
    old "I suppose I do not mind you seeing me... just do not make it weird, okay?"
    new "Наверное, я не против, что ты меня видишь... только без странностей, ладно?"

    # game/scripts/Locations/Shower.rpy:117
    old "Looking is fine. Just... keep your hands and everything else to yourself."
    new "Смотреть можно. Только... руки и всё остальное держи при себе."

    # game/scripts/Locations/Shower.rpy:117
    old "Thanks, I guess. Just do not get any gross ideas about it."
    new "Спасибо, наверное. Только не придумывай себе ничего мерзкого."

    # game/scripts/Locations/Shower.rpy:117
    old "I appreciate the compliment, but please do not make this into something physical."
    new "Спасибо за комплимент, но, пожалуйста, не переводи это во что-то физическое."

    # game/scripts/Locations/Shower.rpy:117
    old "More? Let us not get carried away. Looking is one thing, but that is the line."
    new "Больше? Давай не будем увлекаться. Смотреть это одно, но тут граница."

    # game/scripts/Locations/Shower.rpy:117
    old "I will think about it. But if things get messy, I am done. Literally."
    new "Я подумаю. Но если начнётся что-то липкое, я пас. Буквально."

    # game/scripts/Locations/Shower.rpy:117
    old "I have a {hint}boyfriend{/hint}! You cannot just walk in on me like this!"
    new "У меня есть {hint}парень{/hint}! Ты не можешь вот так ко мне вламываться!"

    # game/scripts/Locations/Shower.rpy:117
    old "What would my {hint}boyfriend{/hint} say if he knew you saw me naked?! Get out!"
    new "Что бы сказал мой {hint}парень{/hint}, если бы узнал, что ты видел меня голой?! Вон!"

    # game/scripts/Locations/Shower.rpy:117
    old "This is so wrong... I should not be seen like this by anyone but him."
    new "Это так неправильно... Никто, кроме него, не должен видеть меня такой."

    # game/scripts/Locations/Shower.rpy:117
    old "My {hint}boyfriend{/hint} would not love this, but... I trust you not to make it weird."
    new "Моему {hint}парню{/hint} это бы не понравилось, но... я верю, что ты не станешь делать из этого что-то странное."

    # game/scripts/Locations/Shower.rpy:117
    old "I know this looks bad, but it was an accident. Let us just forget it happened."
    new "Знаю, это выглядит плохо, но это была случайность. Давай просто забудем."

    # game/scripts/Locations/Shower.rpy:117
    old "I should not be letting you see me like this... but I cannot help it."
    new "Мне не стоит позволять тебе видеть меня такой... но я ничего не могу с собой поделать."

    # game/scripts/Locations/Shower.rpy:117
    old "My {hint}boyfriend{/hint} would hate this. So why does part of me not care right now?"
    new "Мой {hint}парень{/hint} бы это возненавидел. Так почему какой-то части меня сейчас всё равно?"

    # game/scripts/Locations/Shower.rpy:117
    old "This is wrong... but the way you look at me makes me forget that."
    new "Это неправильно... но от того, как ты на меня смотришь, я об этом забываю."

    # game/scripts/Locations/Shower.rpy:117
    old "You... you should not say things like that to me. I am with someone."
    new "Ты... тебе не стоит говорить мне такое. У меня кто-то есть."

