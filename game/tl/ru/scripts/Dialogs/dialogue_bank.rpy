    new "%(girl_name)s? У тебя там всё нормально?"

    # game/scripts/Dialogs/dialogue_bank.rpy:587
    old "Hey. What's going on here?"
    new "Эй. Что тут происходит?"

    # game/scripts/Dialogs/dialogue_bank.rpy:587
    old "Dude. That's my %(pl)s."
    new "Чувак. Это %(r_moi_nom)s %(pl)s."

    # game/scripts/Dialogs/dialogue_bank.rpy:587
