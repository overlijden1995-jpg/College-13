    # game/scripts/Dialogs/dialogue_bank.rpy:1228
    old "I'll keep that in mind."
    new "Буду иметь в виду."

    # game/scripts/Dialogs/dialogue_bank.rpy:1228
    old "Then don't change your mind later."
    new "Тогда потом не передумай."

    # game/scripts/Dialogs/dialogue_bank.rpy:1228
    old "I-I have been working out a little."
    new "Я-я немного занималась спортом."

    # game/scripts/Dialogs/dialogue_bank.rpy:1228
