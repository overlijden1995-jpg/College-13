    new "%(name)s это видел%(r_a)s. %(Pp)s тяжело сглатывает и секунду молчит."

    # game/scripts/Dialogs/dialogue_bank.rpy:565
    old "%(name)s watches openly. %(Pp)s doesn't even try to look away anymore."
    new "%(name)s смотрит в открытую. %(Pp)s даже не пытается отвести взгляд."

