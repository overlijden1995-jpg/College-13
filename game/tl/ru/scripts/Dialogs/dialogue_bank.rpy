    # game/scripts/Dialogs/dialogue_bank.rpy:1228
    old "You'll get them when I decide you've earned them."
    new "Получишь их, когда я решу, что ты заслужил."

    # game/scripts/Dialogs/dialogue_bank.rpy:1228
