    # game/scripts/Dialogs/dialogue_bank.rpy:1228
    old "Watch where your eyes are."
    new "Следи, куда смотришь."

    # game/scripts/Dialogs/dialogue_bank.rpy:1228
    old "That's not how you compliment someone."
    new "Так комплименты не делают."

    # game/scripts/Dialogs/dialogue_bank.rpy:1228
    old "You think so? That's good to hear."
    new "Думаешь? Приятно слышать."

    # game/scripts/Dialogs/dialogue_bank.rpy:1228
    old "I didn't work on it for nothing."
