    # game/scripts/Dialogs/dialogue_bank.rpy:1228
    old "That's one way to say hello."
    new "Ну, можно и так поздороваться."

    # game/scripts/Dialogs/dialogue_bank.rpy:1228
    old "Tone it down a little."
