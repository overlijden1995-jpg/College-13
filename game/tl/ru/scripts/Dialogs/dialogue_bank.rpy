    # game/scripts/Dialogs/dialogue_bank.rpy:1228
    old "Of course I look good today."
    new "Конечно, я сегодня хорошо выгляжу."

    # game/scripts/Dialogs/dialogue_bank.rpy:1228
    old "I did put effort into this, you better notice."
