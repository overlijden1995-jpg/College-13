    # game/scripts/Dialogs/dialogue_bank.rpy:1228
    old "So you didn't like it before?"
    new "То есть раньше тебе не нравилось?"

    # game/scripts/Dialogs/dialogue_bank.rpy:1228
    old "That sounded a bit backhanded."
    new "Звучит как сомнительный комплимент."

    # game/scripts/Dialogs/dialogue_bank.rpy:1228
    old "Don't get used to seeing it."
    new "Не привыкай её видеть."

    # game/scripts/Dialogs/dialogue_bank.rpy:1228
    old "If you make me smile, that's on you."
    new "Если я улыбаюсь, это твоя вина."

    # game/scripts/Dialogs/dialogue_bank.rpy:1228
    old "I'm not a puppy you can just praise."
    new "Я тебе не щенок, чтобы меня хвалить."

    # game/scripts/Dialogs/dialogue_bank.rpy:1228
    old "Don't make it weird."
