    # game/scripts/Dialogs/dialogue_bank.rpy:58
    old "You're seriously one of the smartest people here."
    new "Ты серьёзно одна из самых умных здесь."

    # game/scripts/Dialogs/dialogue_bank.rpy:58
    old "I'm sorry, I got lost in your eyes."
    new "Прости, я утонул в твоих глазах."

    # game/scripts/Dialogs/dialogue_bank.rpy:58
    old "You're looking really toned lately."
    new "Ты в последнее время такая подтянутая."

    # game/scripts/Dialogs/dialogue_bank.rpy:58
    old "I'm so into you."
    new "Я так на тебя запал."

    # game/scripts/Dialogs/dialogue_bank.rpy:58
    old "You have some really nice tits."
