    old "%(name)s just stands there, hands in %(poss)s pockets, watching you two."
    new "%(name)s просто стоит, руки в карманах, и смотрит на вас двоих."

    # game/scripts/Dialogs/dialogue_bank.rpy:565
    old "%(name)s's expression hardens, but %(pp)s doesn't say a word."
    new "Лицо {case=gen}%(name)s{/case} каменеет, но %(pp)s не говорит ни слова."

