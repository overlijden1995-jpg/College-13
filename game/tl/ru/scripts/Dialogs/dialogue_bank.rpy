    # game/scripts/Dialogs/dialogue_bank.rpy:58
    old "Your hair looks amazing today."
    new "Твои волосы сегодня выглядят потрясающе."

    # game/scripts/Dialogs/dialogue_bank.rpy:58
    old "That outfit really suits you."
    new "Тебе очень идёт этот наряд."

    # game/scripts/Dialogs/dialogue_bank.rpy:58
    old "Oh, what's that fragrance? It suits you."
    new "О, что это за аромат? Тебе идёт."

    # game/scripts/Dialogs/dialogue_bank.rpy:58
    old "Great job in class the other day."
    new "Ты отлично выступила на паре на днях."

    # game/scripts/Dialogs/dialogue_bank.rpy:58
    old "Your grades have been really good lately."
    new "У тебя в последнее время отличные оценки."

    # game/scripts/Dialogs/dialogue_bank.rpy:58
    old "You are a nice swimmer."
