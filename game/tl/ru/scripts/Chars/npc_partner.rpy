    # game/scripts/Chars/npc_partner.rpy:1055
    old "Haha you're dumb. But same, bored as hell"
    new "Хаха ты дурак. Но у меня то же самое, скука смертная"

    # game/scripts/Chars/npc_partner.rpy:1055
    old "How's %(girl)s doing?"
    new "Как там %(girl)s?"

