    old "Oh yeah? We should check it out together!"
    new "Правда? Надо будет сходить вместе!"

    # game/scripts/Chars/npc_partner.rpy:1117
    old "%(Pp)s seems genuinely interested."
    new "%(Pp)s, похоже, искренне заинтересован%(r_a)s."

