    # game/scripts/Chars/npc_partner.rpy:1117
    old "You ask %(npc)s how things are with %(girl)s."
    new "Ты спрашиваешь {case=acc}%(npc)s{/case}, как у них дела с {case=ins}%(girl)s{/case}."

    # game/scripts/Chars/npc_partner.rpy:1117
    old "She's great, man. I'm lucky to have her. Don't tell her I said that though."
    new "Она чудо, чувак. Мне с ней повезло. Только ей не говори, что слышал это от меня."

    # game/scripts/Chars/npc_partner.rpy:1117
    old "%(Pp)s grins."
    new "%(Pp)s ухмыляется."

    # game/scripts/Chars/npc_partner.rpy:1117
    old "You ask %(npc)s if he wants to grab food."
    new "Ты предлагаешь {case=dat}%(npc)s{/case} сходить перекусить."

