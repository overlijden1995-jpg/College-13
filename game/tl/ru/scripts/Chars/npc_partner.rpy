translate ru strings:

    # game/scripts/Chars/npc_partner.rpy:716
    old "Ignore him"
    new "Не обращать внимания"

    # game/scripts/Chars/npc_partner.rpy:746
    old "Yeah, cool."
    new "Ага, круто."

    # game/scripts/Chars/npc_partner.rpy:746
    old "Sure, whatever."
    new "Ну да, без разницы."

    # game/scripts/Chars/npc_partner.rpy:746
    old "Why do you care so much about %s?"
    new "Тебе-то какое дело до {case=gen}%s{/case}?"

    # game/scripts/Chars/npc_partner.rpy:746
    old "What's your angle here?"
    new "К чему ты клонишь?"

    # game/scripts/Chars/npc_partner.rpy:746
    old "Yeah... %s is great. What's it to you?"
    new "Ага... %s классная. А тебе-то что?"

    # game/scripts/Chars/npc_partner.rpy:746
    old "I know %s is. I don't need YOU to tell me that."
    new "Я и так знаю, что %s классная. Мне не нужно, чтобы ТЫ мне это говорил."

    # game/scripts/Chars/npc_partner.rpy:746
    old "Cool, I guess."
    new "Круто, наверное."

    # game/scripts/Chars/npc_partner.rpy:746
    old "Yeah, %s is alright."
    new "Ага, %s ничего так."

    # game/scripts/Chars/npc_partner.rpy:746
    old "Thanks, I'll let %s know you said that."
    new "Спасибо, передам {case=dat}%s{/case}, что ты так сказал."

    # game/scripts/Chars/npc_partner.rpy:746
    old "That's nice of you to say."
    new "Приятно слышать."

    # game/scripts/Chars/npc_partner.rpy:746
    old "That's really nice of you. %s will be happy to hear that."
    new "Это очень мило с твоей стороны. %s будет рада это услышать."

    # game/scripts/Chars/npc_partner.rpy:746
    old "You're a good friend. I'll tell %s."
    new "Ты хороший друг. Я передам {case=dat}%s{/case}."

    # game/scripts/Chars/npc_partner.rpy:746
    old "Yeah... things have been weird between us though."
    new "Ага... только у нас в последнее время всё как-то странно."

    # game/scripts/Chars/npc_partner.rpy:746
    old "I appreciate that, but honestly, I don't know where we stand."
    new "Спасибо, конечно, но если честно, я уже не понимаю, что между нами."

    # game/scripts/Chars/npc_partner.rpy:746
    old "Hey, thanks man. That means a lot."
    new "Эй, спасибо, чувак. Это много для меня значит."

    # game/scripts/Chars/npc_partner.rpy:746
    old "%s talks about you too, you know. Says you're a good guy."
    new "%s тоже о тебе говорит, между прочим. Говорит, ты хороший парень."

    # game/scripts/Chars/npc_partner.rpy:746
    old "%s really is amazing, isn't she? I'm lucky."
    new "%s правда потрясающая, да? Мне повезло."

    # game/scripts/Chars/npc_partner.rpy:746
    old "I know, right? I don't know what I did to deserve %s."
    new "Вот-вот! Даже не знаю, за что мне досталась %s."

    # game/scripts/Chars/npc_partner.rpy:746
    old "Are you trying to start something?"
    new "Ты нарываешься?"

    # game/scripts/Chars/npc_partner.rpy:746
    old "Get the hell out of my face."
    new "Пошёл к чёрту с глаз моих."

    # game/scripts/Chars/npc_partner.rpy:746
    old "What the hell are you implying?"
    new "На что это ты, чёрт возьми, намекаешь?"

    # game/scripts/Chars/npc_partner.rpy:746
    old "You think I'm stupid? I see what you're doing."
    new "За идиота меня держишь? Я вижу, что ты задумал."

    # game/scripts/Chars/npc_partner.rpy:746
    old "Stay the fuck away from %s."
    new "Держись, нахрен, подальше от {case=gen}%s{/case}."

    # game/scripts/Chars/npc_partner.rpy:746
    old "If I catch you near %s again, we're going to have a problem."
    new "Если ещё раз увижу тебя рядом с {case=ins}%s{/case}, у нас будут проблемы."

    # game/scripts/Chars/npc_partner.rpy:746
    old "That's... none of your business."
    new "Это... не твоё дело."

    # game/scripts/Chars/npc_partner.rpy:746
    old "Why are you telling me this?"
    new "Зачем ты мне это говоришь?"

    # game/scripts/Chars/npc_partner.rpy:746
    old "Wait, what? %s was at your place?"
    new "Стоп, что? %s была у тебя?"

    # game/scripts/Chars/npc_partner.rpy:746
    old "That's... weird. %s didn't mention that."
    new "Это... странно. %s мне об этом не говорила."

    # game/scripts/Chars/npc_partner.rpy:746
    old "%s... forgot a shirt at your room? Why was %s there?"
    new "%s... забыла у тебя в комнате футболку? А что %s там делала?"

    # game/scripts/Chars/npc_partner.rpy:746
    old "I don't... that doesn't make sense. %s wouldn't do that."
    new "Я не... это какая-то бессмыслица. %s бы так не поступила."

    # game/scripts/Chars/npc_partner.rpy:746
    old "That's a weird thing to say, dude."
    new "Странные вещи ты говоришь, чувак."

    # game/scripts/Chars/npc_partner.rpy:746
    old "I don't really want to hear about that."
    new "Я не очень хочу об этом слушать."

    # game/scripts/Chars/npc_partner.rpy:746
    old "Huh... that doesn't sound like %s. Does it?"
    new "Хм... это не похоже на {case=acc}%s{/case}. Или похоже?"

    # game/scripts/Chars/npc_partner.rpy:746
    old "You're messing with me, right? ...Right?"
    new "Ты же прикалываешься, да? ...Да?"

    # game/scripts/Chars/npc_partner.rpy:746
    old "I thought you were cool, man. Why are you telling me this?"
    new "Мне казалось, ты нормальный, чувак. Зачем ты мне это говоришь?"

    # game/scripts/Chars/npc_partner.rpy:746
    old "...%s would never... but you wouldn't lie to me, would you?"
    new "...%s бы никогда... но ты ведь не стал бы мне врать, правда?"

    # game/scripts/Chars/npc_partner.rpy:992
    old "Hey... can I ask you something? %s has been... distant lately. I don't know if I'm doing something wrong."
    new "Слушай... можно тебя кое о чём спросить? %s в последнее время какая-то... отстранённая. Не знаю, может, я что-то не так делаю."

    # game/scripts/Chars/npc_partner.rpy:992
    old "I need to talk to someone. %s barely looks at me anymore. Do you think something's going on?"
    new "Мне нужно с кем-то поговорить. %s на меня почти не смотрит. Думаешь, что-то происходит?"

    # game/scripts/Chars/npc_partner.rpy:992
    old "You're friends with %s, right? She's been acting different. Avoiding me. I don't know what to think."
    new "Ты же дружишь с {case=ins}%s{/case}, да? Она в последнее время какая-то другая. Избегает меня. Не знаю, что и думать."

    # game/scripts/Chars/npc_partner.rpy:992
    old "Something's off with %s. I can feel it. She's hiding something, I just can't figure out what."
    new "С {case=ins}%s{/case} что-то не так. Я это чувствую. Она что-то скрывает, а я не могу понять что."

    # game/scripts/Chars/npc_partner.rpy:992
    old "I'm not stupid, man. %s has been coming home late, dodging my questions. What the hell is going on?"
    new "Я не идиот, чувак. %s приходит домой поздно, увиливает от моих вопросов. Что, чёрт возьми, происходит?"

    # game/scripts/Chars/npc_partner.rpy:992
    old "Be honest with me. Have you noticed anything weird about %s lately?"
    new "Скажи честно. Ты не замечал за {case=ins}%s{/case} в последнее время ничего странного?"

    # game/scripts/Chars/npc_partner.rpy:992
    old "I think %s is seeing someone. I don't even care that much anymore, I just want to know."
    new "Мне кажется, %s с кем-то встречается. Мне уже даже не так важно, я просто хочу знать."

    # game/scripts/Chars/npc_partner.rpy:992
    old "Pretty sure %s is cheating on me. At this point I'm more tired than mad about it."
    new "Я почти не сомневаюсь, что %s мне изменяет. Сейчас во мне уже больше усталости, чем злости."

    # game/scripts/Chars/npc_partner.rpy:992
    old "Look, I know things between me and %s haven't been great. But if she's messing around, I'd rather just know."
    new "Слушай, я знаю, что у нас с {case=ins}%s{/case} всё не очень. Но если она с кем-то крутит, я лучше буду знать правду."

    # game/scripts/Chars/npc_partner.rpy:1010
    old "Yeah... you're probably right. Thanks, man. I needed to hear that."
    new "Да... наверное, ты прав. Спасибо, чувак. Мне нужно было это услышать."

    # game/scripts/Chars/npc_partner.rpy:1010
    old "I hope so. I just love her, you know? I don't want to lose her."
    new "Надеюсь. Я просто люблю её, понимаешь? Не хочу её потерять."

    # game/scripts/Chars/npc_partner.rpy:1010
    old "Maybe. I don't know. But thanks for hearing me out."
    new "Может быть. Не знаю. Но спасибо, что выслушал."

    # game/scripts/Chars/npc_partner.rpy:1010
    old "I guess you could be right. I'll try not to overthink it."
    new "Может, ты и прав. Постараюсь себя не накручивать."

    # game/scripts/Chars/npc_partner.rpy:1010
    old "If you say so. Doesn't feel like nothing, though."
    new "Как скажешь. Только на пустяки это не похоже."

    # game/scripts/Chars/npc_partner.rpy:1010
    old "Sure. Whatever you say."
    new "Ага. Как скажешь."

    # game/scripts/Chars/npc_partner.rpy:1025
    old "What? What do you mean? You've seen something?"
    new "Что? В смысле? Ты что-то видел?"

    # game/scripts/Chars/npc_partner.rpy:1025
    old "Wait, you noticed too? Oh god... what did you see?"
    new "Подожди, ты тоже заметил? Боже... что ты видел?"

    # game/scripts/Chars/npc_partner.rpy:1025
    old "I knew it. I KNEW something was off. What have you seen?"
    new "Сердце чуяло. ЧУЯЛО, что что-то не так. Что ты видел?"

    # game/scripts/Chars/npc_partner.rpy:1025
    old "Damn it. So it's not just in my head then."
    new "Чёрт. Значит, это не только у меня в голове."

    # game/scripts/Chars/npc_partner.rpy:1025
    old "Figures. At least I'm not crazy."
    new "Кто бы сомневался. Хотя бы я не схожу с ума."

    # game/scripts/Chars/npc_partner.rpy:1025
    old "Yeah, that's what I thought. Whatever."
    new "Ага, чего и следовало ожидать. Плевать."

    # game/scripts/Chars/npc_partner.rpy:1040
    old "You... what? You're joking, right? Tell me you're joking."
    new "Ты... что? Ты шутишь, да? Скажи, что шутишь."

    # game/scripts/Chars/npc_partner.rpy:1040
    old "I... I trusted you. I actually trusted you. Get the hell away from me."
    new "Я... у меня ведь было к тебе доверие. Настоящее доверие. Вали от меня к чёрту."

    # game/scripts/Chars/npc_partner.rpy:1040
    old "You son of a... I should've known. Get the FUCK away from me."
    new "Ах ты сукин... Надо было сразу догадаться. Вали от меня НАХРЕН."

    # game/scripts/Chars/npc_partner.rpy:1040
    old "Are you serious right now? You have the nerve to tell me this to my face?"
    new "Ты это серьёзно? Тебе хватает наглости говорить мне это в лицо?"

    # game/scripts/Chars/npc_partner.rpy:1055
    old "Hey"
    new "Привет"

    # game/scripts/Chars/npc_partner.rpy:1055
    old "What?"
    new "Чего?"

    # game/scripts/Chars/npc_partner.rpy:1055
    old "How's it going?"
    new "Как дела?"

    # game/scripts/Chars/npc_partner.rpy:1055
    old "Busy."
    new "Некогда."

    # game/scripts/Chars/npc_partner.rpy:1055
    old "You around campus?"
    new "Ты где-то на кампусе?"

    # game/scripts/Chars/npc_partner.rpy:1055
    old "Why do you want to know?"
    new "А тебе зачем?"

    # game/scripts/Chars/npc_partner.rpy:1055
    old "What's up"
    new "Как оно"

    # game/scripts/Chars/npc_partner.rpy:1055
    old "Don't text me."
    new "Не пиши мне."

    # game/scripts/Chars/npc_partner.rpy:1055
    old "Hey, just wanted to chat"
    new "Привет, просто хотел поболтать"

    # game/scripts/Chars/npc_partner.rpy:1055
    old "About what exactly?"
    new "О чём именно?"

    # game/scripts/Chars/npc_partner.rpy:1055
    old "Hey, what are you up to?"
    new "Привет, чем занимаешься?"

    # game/scripts/Chars/npc_partner.rpy:1055
    old "Just studying. Nothing exciting."
    new "Учусь. Ничего интересного."

    # game/scripts/Chars/npc_partner.rpy:1055
    old "Same. Campus is dead today."
    new "Аналогично. На кампусе сегодня пусто."

    # game/scripts/Chars/npc_partner.rpy:1055
    old "Tell me about it."
    new "И не говори."

    # game/scripts/Chars/npc_partner.rpy:1055
    old "Not bad. Just got out of class."
    new "Неплохо. Только что с пары."

    # game/scripts/Chars/npc_partner.rpy:1055
    old "Which one? The boring one?"
