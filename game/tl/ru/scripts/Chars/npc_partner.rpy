    new "Ты даже не представляешь. Но я ни на что это не променяю."

    # game/scripts/Chars/npc_partner.rpy:1267
    old "You ask %(npc)s about the kids."
    new "Ты спрашиваешь {case=acc}%(npc)s{/case} о детях."

