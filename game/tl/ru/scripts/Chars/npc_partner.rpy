    # game/scripts/Chars/npc_partner.rpy:3907
    old "%s believed me, but %s said if %s ever finds out I lied, that's it. No second chances."
    new "%s мне верит, но %s говорит: если %s когда-нибудь узнает, что я соврала, всё. Второго шанса не будет."

    # game/scripts/Chars/npc_partner.rpy:3909
