    # game/scripts/Chars/npc_partner.rpy:1055
    old "Will do! She'll appreciate that."
    new "Передам! Ей будет приятно."

    # game/scripts/Chars/npc_partner.rpy:1055
    old "Dude, tried that new place near campus?"
    new "Чувак, как тебе то новое место возле кампуса?"

    # game/scripts/Chars/npc_partner.rpy:1055
    old "Not yet! Is it any good?"
    new "Пока не знаю! Там вкусно?"

    # game/scripts/Chars/npc_partner.rpy:1055
    old "Yeah, the food is great."
    new "Ага, еда там отличная."

    # game/scripts/Chars/npc_partner.rpy:1055
    old "We should go together sometime!"
    new "Надо как-нибудь сходить вместе!"

    # game/scripts/Chars/npc_partner.rpy:1055
    old "Hey, quick question"
    new "Слушай, вопрос есть"

    # game/scripts/Chars/npc_partner.rpy:1055
    old "Shoot!"
    new "Валяй!"

    # game/scripts/Chars/npc_partner.rpy:1055
    old "What time is that thing on Friday?"
    new "Во сколько та штука в пятницу?"

    # game/scripts/Chars/npc_partner.rpy:1055
    old "8 PM. Don't be late this time haha"
    new "В 8 вечера. Только в этот раз не опаздывай хаха"

    # game/scripts/Chars/npc_partner.rpy:1055
