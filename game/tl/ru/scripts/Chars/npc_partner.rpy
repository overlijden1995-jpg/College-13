    # game/scripts/Chars/npc_partner.rpy:3901
    old "So %s brought up your name today. Asked if we were close."
    new "В общем, сегодня в разговоре с {case=ins}%s{/case} всплыло твоё имя. Был вопрос, близки ли мы."

    # game/scripts/Chars/npc_partner.rpy:3902
