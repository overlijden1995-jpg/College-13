    # game/scripts/Chars/npc_partner.rpy:1117
    old "Yeah, cool. Look, I have stuff to do."
    new "Ага, круто. Слушай, у меня дела."

    # game/scripts/Chars/npc_partner.rpy:1117
    old "That went nowhere."
    new "Разговор ни к чему не привёл."

    # game/scripts/Chars/npc_partner.rpy:1117
    old "You ask how things are going."
    new "Ты спрашиваешь, как дела."

    # game/scripts/Chars/npc_partner.rpy:1117
    old "Fine. Everything's fine. Why?"
    new "Нормально. Всё нормально. А что?"

    # game/scripts/Chars/npc_partner.rpy:1117
    old "There's an edge to %(npc)s's words."
    new "В словах {case=gen}%(npc)s{/case} чувствуется напряжение."

    # game/scripts/Chars/npc_partner.rpy:1117
    old "You try to compliment something."
    new "Ты пытаешься сделать комплимент."

    # game/scripts/Chars/npc_partner.rpy:1117
    old "Thanks... I guess? What are you after?"
    new "Спасибо... наверное? Чего ты добиваешься?"

    # game/scripts/Chars/npc_partner.rpy:1117
    old "%(Pp)s watches you as you walk away."
    new "%(Pp)s провожает тебя взглядом, пока ты уходишь."

    # game/scripts/Chars/npc_partner.rpy:1117
    old "You ask about the classes."
    new "Ты спрашиваешь про пары."

    # game/scripts/Chars/npc_partner.rpy:1117
    old "Boring as always. Can't wait for the weekend."
    new "Скучно, как всегда. Скорей бы выходные."

    # game/scripts/Chars/npc_partner.rpy:1117
    old "You chat for a bit about campus life."
    new "Вы немного болтаете о жизни на кампусе."

    # game/scripts/Chars/npc_partner.rpy:1117
    old "You mention something that happened on campus."
    new "Ты рассказываешь о том, что случилось на кампусе."

    # game/scripts/Chars/npc_partner.rpy:1117
    old "Ha, I heard about that too. This place is crazy sometimes."
    new "Ха, до меня тоже дошли слухи. Тут иногда творится какое-то безумие."

    # game/scripts/Chars/npc_partner.rpy:1117
    old "%(Pp)s seems to relax a little."
    new "%(Pp)s, кажется, немного расслабляется."

    # game/scripts/Chars/npc_partner.rpy:1117
    old "You ask about %(girl)s."
    new "Ты спрашиваешь про {case=acc}%(girl)s{/case}."

    # game/scripts/Chars/npc_partner.rpy:1117
    old "%(girl)s? She's good. Busy with her stuff as usual."
    new "%(girl)s? У неё всё хорошо. Как обычно, занята своими делами."

    # game/scripts/Chars/npc_partner.rpy:1117
    old "A normal enough conversation."
    new "Вполне обычный разговор."

    # game/scripts/Chars/npc_partner.rpy:1117
    old "You ask if there's anything fun happening this weekend."
    new "Ты спрашиваешь, не намечается ли на выходных что-нибудь интересное."

    # game/scripts/Chars/npc_partner.rpy:1117
    old "Not sure yet. Might do something with %(girl)s."
    new "Пока не знаю. Может, куда-нибудь сходим с {case=ins}%(girl)s{/case}."

    # game/scripts/Chars/npc_partner.rpy:1117
    old "You nod and say goodbye."
    new "Ты киваешь и прощаешься."

    # game/scripts/Chars/npc_partner.rpy:1117
    old "You complain about the campus food."
    new "Ты жалуешься на еду в столовой."

    # game/scripts/Chars/npc_partner.rpy:1117
    old "Yeah, it's terrible. I miss actual cooking."
    new "Ага, она ужасная. Скучаю по нормальной домашней еде."

    # game/scripts/Chars/npc_partner.rpy:1117
    old "You bond a little over shared complaints."
    new "Общие жалобы вас немного сближают."

    # game/scripts/Chars/npc_partner.rpy:1117
    old "You greet %(npc)s with a fist bump."
    new "Вы с {case=ins}%(npc)s{/case} здороваетесь, стукнувшись кулаками."

    # game/scripts/Chars/npc_partner.rpy:1117
    old "Hey! Good to see you, man."
    new "Привет! Как здорово тебя видеть, чувак."

    # game/scripts/Chars/npc_partner.rpy:1117
    old "You chat for a while. It feels like a genuine friendship."
    new "Вы какое-то время болтаете. Похоже на настоящую дружбу."

    # game/scripts/Chars/npc_partner.rpy:1117
    old "You ask what %(npc)s has been up to."
    new "Ты спрашиваешь, что нового у {case=gen}%(npc)s{/case}."

    # game/scripts/Chars/npc_partner.rpy:1117
    old "%(girl)s and I went out last night. It was fun."
    new "Мы с {case=ins}%(girl)s{/case} вчера вечером ходили гулять. Было весело."

    # game/scripts/Chars/npc_partner.rpy:1117
    old "%(Pp)s seems happy to share."
    new "%(Pp)s с радостью делится."

    # game/scripts/Chars/npc_partner.rpy:1117
    old "You mention a new place that opened near campus."
    new "Ты рассказываешь про новое место, которое открылось возле кампуса."

