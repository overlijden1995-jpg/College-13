    # game/scripts/Chars/npc_partner.rpy:3876
    old "%s showed me something on the phone. It was a video. Of me. With you."
    new "В телефоне у {case=gen}%s{/case} было кое-что. Видео. Со мной. И с тобой."

    # game/scripts/Chars/npc_partner.rpy:3877
    old "I told %s it was someone who looked like me. I don't think %s believed me."
