# TODO: Translation updated at 2026-10-02 11:11

translate ru strings:

    # game/scripts/Events/exam.rpy:669
    old "Yes!"
    new "Да!"

    # game/scripts/Events/exam.rpy:669
    old "Not bad at all!"
    new "Совсем неплохо!"

    # game/scripts/Events/exam.rpy:669
    old "I did it!"
    new "У меня получилось!"

    # game/scripts/Events/exam.rpy:669
    old "Good enough for me."
    new "Меня устраивает."

    # game/scripts/Events/exam.rpy:669
    old "I'll take it."
    new "Сойдёт."

    # game/scripts/Events/exam.rpy:669
    old "Solid."
    new "Достойно."

    # game/scripts/Events/exam.rpy:669
    old "Could be worse, I guess."
    new "Могло быть и хуже, наверное."

    # game/scripts/Events/exam.rpy:669
    old "Eh, whatever."
    new "Эх, да какая разница."

    # game/scripts/Events/exam.rpy:669
    old "Okay, okay..."
    new "Ладно, ладно..."

    # game/scripts/Events/exam.rpy:669
    old "That's... not great."
    new "Это... не очень."

    # game/scripts/Events/exam.rpy:669
    old "Ugh."
    new "Тьфу."

    # game/scripts/Events/exam.rpy:669
    old "I need to do better."
    new "Надо стараться лучше."

    # game/scripts/Events/exam.rpy:669
    old "Oh no..."
    new "О нет..."

    # game/scripts/Events/exam.rpy:669
    old "That's really bad."
    new "Это очень плохо."

    # game/scripts/Events/exam.rpy:669
    old "I don't even want to talk about it."
    new "Даже говорить об этом не хочу."

    # game/scripts/Events/exam.rpy:712
    old "Of course. As expected."
    new "Конечно. Как и ожидалось."

    # game/scripts/Events/exam.rpy:712
    old "Naturally."
    new "Естественно."

    # game/scripts/Events/exam.rpy:712
    old "Was there ever any doubt?"
    new "А были какие-то сомнения?"

    # game/scripts/Events/exam.rpy:712
    old "A B? I can do better than that..."
    new "Оценка B? Я могу и лучше..."

    # game/scripts/Events/exam.rpy:712
    old "A B... that's not me."
    new "Оценка B... это на меня не похоже."

    # game/scripts/Events/exam.rpy:712
    old "Not good enough. I'll fix this."
    new "Недостаточно хорошо. Я это исправлю."

    # game/scripts/Events/exam.rpy:712
    old "A C?! This is unacceptable!"
    new "Оценка C?! Это недопустимо!"

    # game/scripts/Events/exam.rpy:712
    old "This is NOT okay!"
    new "Это НЕ нормально!"

    # game/scripts/Events/exam.rpy:712
    old "How did this happen?!"
    new "Как такое могло случиться?!"

    # game/scripts/Events/exam.rpy:712
    old "A D... this can't be happening!"
    new "Оценка D... этого не может быть!"

    # game/scripts/Events/exam.rpy:712
    old "No, no, no... a D?!"
    new "Нет, нет, нет... D?!"

    # game/scripts/Events/exam.rpy:712
    old "This is a nightmare."
    new "Это кошмар."

    # game/scripts/Events/exam.rpy:712
    old "I... I failed?! No, this can't be right!"
    new "Я... я провалилась?! Нет, тут какая-то ошибка!"

    # game/scripts/Events/exam.rpy:712
    old "An F? AN F?!"
    new "Оценка F? ОЦЕНКА F?!"

    # game/scripts/Events/exam.rpy:712
    old "This... this isn't real."
    new "Это... это происходит не со мной."

    # game/scripts/Events/exam.rpy:777
    old "Head to the exam"
    new "Пойти на экзамен"

    # game/scripts/Events/exam.rpy:781
    old "Skip it"
    new "Прогулять"

    # game/scripts/Events/exam.rpy:787
    old "You decide not to show up. It'll catch up with you eventually."
    new "Ты решаешь не идти. Рано или поздно это тебе аукнется."

    # game/scripts/Events/exam.rpy:797
    old "Sure, let's go"
    new "Конечно, пошли"

    # game/scripts/Events/exam.rpy:801
    old "Not right now"
    new "Не сейчас"

    # game/scripts/Events/exam.rpy:819
    old "Alright, let's go"
    new "Ладно, пошли"

    # game/scripts/Events/exam.rpy:823
    old "Maybe we skip it…"
    new "Может, прогуляем…"

    # game/scripts/Events/exam.rpy:827
    old "I'm not going"
    new "Я не пойду"

    # game/scripts/Events/exam.rpy:842
    old "It's exam day. The classroom is filling up... are you going?"
    new "Сегодня экзамен. Аудитория заполняется... ты идёшь?"

    # game/scripts/Events/exam.rpy:859
    old "Come on, let's just skip it. We'll make up for it later."
    new "Да ладно, давай просто прогуляем. Потом наверстаем."

    # game/scripts/Events/exam.rpy:864
    old "Trust me, it'll be fine"
    new "Поверь, всё будет нормально"

    # game/scripts/Events/exam.rpy:869
    old "The two of you decide to stay. Hopefully it won't cost you."
    new "Вы вдвоём решаете остаться. Надеюсь, вам это не дорого обойдётся."

    # game/scripts/Events/exam.rpy:873
    old "Just kidding... let's go"
    new "Шучу... пошли"

    # game/scripts/Events/exam.rpy:900
    old "The classroom fills up. Pencils out."
    new "Аудитория заполняется. Карандаши наготове."

    # game/scripts/Events/exam.rpy:912
    old "Exam results:"
    new "Результаты экзамена:"

    # game/scripts/Events/exam.rpy:917
    old "You... [Player.study_level] pts... Grade: [_player_grade]."
    new "Ты... баллы: [Player.study_level]... Оценка: [_player_grade]."

    # game/scripts/Events/exam.rpy:940
    old "[_rg.Name]... [_rg_lvl] pts... Grade: [_rg_grade]."
    new "[_rg.Name]... баллы: [_rg_lvl]... Оценка: [_rg_grade]."

    # game/scripts/Events/exam.rpy:956
    old "Exam over. Study levels reset."
    new "Экзамен окончен. Уровни учёбы сброшены."

    # game/scripts/Events/exam.rpy:1014
    old "AN F! Did you see that?! I NEVER got below an A before I met you! I'm freaking out!"
    new "ОЦЕНКА F! Ты видел?! До встречи с тобой у меня НИКОГДА не было ниже A! Я в панике!"

    # game/scripts/Events/exam.rpy:1017
    old "Life is more than a grade on a report card."
    new "Жизнь не сводится к оценкам в табеле."

    # game/scripts/Events/exam.rpy:1019
    old "Do you think I'm taking this too seriously? I know I can recover this grade, but do you think I should be less obsessed about grades?"
    new "Думаешь, я отношусь к этому слишком серьёзно? Я знаю, что могу исправить оценку, но, по-твоему, мне стоит меньше зацикливаться на оценках?"

    # game/scripts/Events/exam.rpy:1024
    old "Maybe you're right. I've been so focused on grades that I forgot to actually enjoy being here. I'll try to relax a little."
    new "Может, ты и прав. Я так зациклилась на оценках, что забыла просто радоваться жизни здесь. Постараюсь немного расслабиться."

    # game/scripts/Events/exam.rpy:1033
    old "No, you can focus more next time"
    new "Нет, просто в следующий раз сосредоточься получше"

    # game/scripts/Events/exam.rpy:1035
    old "You're right. This was just a bad week. I'll make sure it doesn't happen again."
    new "Ты прав. Просто неделя выдалась неудачная. Я позабочусь, чтобы такое не повторилось."

    # game/scripts/Events/exam.rpy:1039
    old "Yeah, we really dropped the ball this week."
    new "Да, на этой неделе мы реально облажались."

    # game/scripts/Events/exam.rpy:1041
    old "Thanks for agreeing. We can still see each other, but let's focus more on studying this week, okay?"
    new "Спасибо, что согласен. Мы всё равно можем видеться, но давай на этой неделе больше займёмся учёбой, хорошо?"

    # game/scripts/Events/exam.rpy:1046
    old "You skipped because you wanted to."
    new "Ты прогуляла, потому что сама хотела."

    # game/scripts/Events/exam.rpy:1048
    old "Excuse me?! YOU are the one who kept asking me to stay! This is YOUR fault!"
    new "Прошу прощения?! Это ТЫ всё уговаривал меня остаться! Это ТВОЯ вина!"

    # game/scripts/Events/exam.rpy:1052
    old "She storms off toward her room. She does not look happy at all."
    new "Она в ярости уходит к себе в комнату. Вид у неё совсем не радостный."

    # game/scripts/Events/exam.rpy:1062
    old "AGAIN! Another F! One more and I lose my spot, do you understand how serious this is?!"
    new "ОПЯТЬ! Снова F! Ещё одна, и я потеряю место, ты понимаешь, насколько это серьёзно?!"

    # game/scripts/Events/exam.rpy:1068
    old "You said that last time! And look where it got me!"
    new "Ты то же самое говорил в прошлый раз! И посмотри, к чему это привело!"

    # game/scripts/Events/exam.rpy:1071
    old "Yes, and I still mean it"
    new "Да, и я по-прежнему так думаю"

    # game/scripts/Events/exam.rpy:1073
    old "... Maybe you're right. Maybe I've been killing myself over something that doesn't matter that much. Fine. I'll stop obsessing."
    new "... Может, ты и прав. Может, я убиваюсь из-за того, что не так уж важно. Ладно. Перестану зацикливаться."

    # game/scripts/Events/exam.rpy:1082
    old "No, let's buckle down this time"
    new "Нет, в этот раз давай возьмёмся всерьёз"

    # game/scripts/Events/exam.rpy:1084
    old "Okay. No more skipping. I mean it. Not even once."
    new "Хорошо. Больше никаких прогулов. Я серьёзно. Ни разу."

    # game/scripts/Events/exam.rpy:1088
    old "Yeah, we really messed up again."
    new "Да, мы опять сильно облажались."

    # game/scripts/Events/exam.rpy:1090
    old "This can't keep happening. We need to study EVERY day this week. Promise me."
    new "Так больше не может продолжаться. На этой неделе нужно заниматься КАЖДЫЙ день. Обещай мне."

    # game/scripts/Events/exam.rpy:1097
    old "AGAIN with that?! I can't believe you! Get out of my sight!"
    new "ОПЯТЬ ты за своё?! Поверить не могу! Убирайся с глаз моих!"

