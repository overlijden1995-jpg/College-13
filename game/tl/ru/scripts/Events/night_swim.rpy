# TODO: Translation updated at 2026-10-02 11:11

# game/scripts/Events/night_swim.rpy:191
translate ru debug_night_swim_ef12c47e:

    # "No girls available."
    "Нет доступных девушек."

translate ru strings:

    # game/scripts/Events/night_swim.rpy:43
    old "W-what?! Who is there?!"
    new "Ч-что?! Кто здесь?!"

    # game/scripts/Events/night_swim.rpy:43
    old "Oh my god! You scared me!"
    new "Боже мой! Ты меня напугал!"

    # game/scripts/Events/night_swim.rpy:43
    old "Ah! How long have you been standing there?!"
    new "Ах! Давно ты тут стоишь?!"

    # game/scripts/Events/night_swim.rpy:43
    old "Hey! Do not sneak up on someone like that!"
    new "Эй! Нельзя так подкрадываться к людям!"

    # game/scripts/Events/night_swim.rpy:50
    old "I could not sleep. It was too hot, so I came out for some air. Then I heard splashing."
    new "Я не могла уснуть. Было слишком жарко, вот я и вышла подышать. А потом услышала плеск."

    # game/scripts/Events/night_swim.rpy:50
    old "The heat was killing me. I came to cool off and heard someone in the water."
    new "Жара меня просто убивала. Я пришла охладиться и услышала, что кто-то в воде."

    # game/scripts/Events/night_swim.rpy:50
    old "I was just taking a walk. The heat is unbearable tonight. Then I noticed someone swimming."
    new "Я просто гуляла. Сегодня невыносимая жара. А потом заметила, что кто-то плавает."

    # game/scripts/Events/night_swim.rpy:56
    old "Same here... it is so hot tonight. I figured nobody would be around, so I went for a swim. Without... you know."
    new "Я тоже... сегодня так жарко. Я думала, вокруг никого не будет, вот и пошла поплавать. Без... ну, ты понял."

    # game/scripts/Events/night_swim.rpy:56
    old "The heat was driving me crazy too. I thought I had the pool to myself, so I decided to swim... naturally."
    new "Меня жара тоже с ума сводила. Я думала, бассейн весь мой, и решила поплавать... в натуральном виде."

    # game/scripts/Events/night_swim.rpy:56
    old "I could not take the heat anymore. It is the middle of the night, so I thought... why bother with a swimsuit?"
    new "Я больше не могла терпеть жару. Середина ночи, вот я и подумала... зачем вообще купальник?"

    # game/scripts/Events/night_swim.rpy:64
    old "This is so embarrassing... please do not stare."
    new "Как же стыдно... пожалуйста, не пялься."

    # game/scripts/Events/night_swim.rpy:64
    old "I cannot believe you caught me like this..."
    new "Не могу поверить, что ты застал меня вот так..."

    # game/scripts/Events/night_swim.rpy:64
    old "Of all the people to walk in on me... it had to be you."
    new "Из всех, кто мог на меня наткнуться... это должен был быть именно ты."

    # game/scripts/Events/night_swim.rpy:70
    old "Well, you have already seen me. No point hiding now."
    new "Ну, ты меня уже видел. Прятаться нет смысла."

    # game/scripts/Events/night_swim.rpy:70
    old "I guess the secret is out. I am a midnight swimmer."
    new "Похоже, секрет раскрыт. Я ночная пловчиха."

    # game/scripts/Events/night_swim.rpy:70
    old "Not exactly how I planned my evening, but here we are."
    new "Не совсем так я планировала свой вечер, но что есть, то есть."

    # game/scripts/Events/night_swim.rpy:78
    old "Could you... turn around? I need to get out and put something on."
    new "Можешь... отвернуться? Мне нужно вылезти и что-нибудь надеть."

    # game/scripts/Events/night_swim.rpy:78
    old "Do you mind looking away? I want to get dressed."
    new "Не против отвернуться? Я хочу одеться."

    # game/scripts/Events/night_swim.rpy:78
    old "Just... give me a minute to get out of here, okay? No peeking."
    new "Просто... дай мне минутку выбраться отсюда, ладно? Не подглядывай."

    # game/scripts/Events/night_swim.rpy:78
    old "Close your eyes. I am getting out."
    new "Закрой глаза. Я вылезаю."

    # game/scripts/Events/night_swim.rpy:85
    old "You turn around and wait while she climbs out and wraps herself in a towel."
    new "Ты отворачиваешься и ждёшь, пока она выбирается из воды и заворачивается в полотенце."

    # game/scripts/Events/night_swim.rpy:85
    old "You look away as you hear the water shift and the sound of fabric rustling."
    new "Ты отводишь взгляд и слышишь, как плещется вода и шуршит ткань."

    # game/scripts/Events/night_swim.rpy:85
    old "You give her space. After a moment, she taps your shoulder. She is dressed in a towel."
    new "Ты даёшь ей побыть одной. Через минуту она хлопает тебя по плечу. На ней одно полотенце."

    # game/scripts/Events/night_swim.rpy:91
    old "Thanks for not being weird about it."
    new "Спасибо, что не стал вести себя странно."

    # game/scripts/Events/night_swim.rpy:91
    old "You are surprisingly decent, you know that?"
    new "А ты на удивление порядочный, знаешь?"

    # game/scripts/Events/night_swim.rpy:91
    old "I appreciate you not making this awkward. Well... more awkward."
    new "Спасибо, что не сделал всё неловким. Ну... ещё более неловким."

    # game/scripts/Events/night_swim.rpy:91
    old "Okay. Crisis averted. We never speak of this again."
    new "Ладно. Кризис миновал. Больше мы об этом никогда не говорим."

    # game/scripts/Events/night_swim.rpy:100
    old "I... you know what, the water is really nice. Do you want to join me?"
    new "Я... знаешь что, вода просто чудесная. Хочешь ко мне?"

    # game/scripts/Events/night_swim.rpy:100
    old "Since you are already here... do you want to get in? It is actually really refreshing."
    new "Раз уж ты здесь... хочешь залезть? Вода правда очень освежает."

    # game/scripts/Events/night_swim.rpy:100
    old "Well, you have already seen everything. You might as well come in."
    new "Ну, ты уже всё видел. Можешь и залезать."

    # game/scripts/Events/night_swim.rpy:106
    old "The water feels amazing. Why don't you get in? Unless you are scared."
    new "Вода потрясающая. Почему бы тебе не залезть? Если, конечно, не боишься."

    # game/scripts/Events/night_swim.rpy:106
    old "Are you just going to stand there, or are you going to join me? Clothes off."
    new "Так и будешь стоять или присоединишься? Одежду долой."

    # game/scripts/Events/night_swim.rpy:106
    old "Come on, get in. The night is too hot and the pool is too nice to waste. Leave the shorts on the chair."
    new "Давай, залезай. Ночь слишком жаркая, а бассейн слишком хорош, чтобы его упускать. Шорты оставь на шезлонге."

    # game/scripts/Events/night_swim.rpy:106
    old "You look like you need to cool off too. Get in here. No swimsuit required."
    new "Похоже, тебе тоже надо остыть. Залезай. Плавки не обязательны."

    # game/scripts/Events/night_swim.rpy:113
    old "Mmm, I was hoping someone would show up. Get in here, the water is perfect."
    new "Ммм, я надеялась, что кто-нибудь появится. Залезай, вода идеальная."

    # game/scripts/Events/night_swim.rpy:113
    old "I left the lights off for a reason, you know. Come join me... all of you."
    new "Я не просто так оставила свет выключенным, знаешь ли. Иди ко мне... весь, целиком."

    # game/scripts/Events/night_swim.rpy:113
    old "Looks like my little midnight adventure just got more interesting. Strip down and get in."
    new "Похоже, моё маленькое ночное приключение стало интереснее. Раздевайся и залезай."

    # game/scripts/Events/night_swim.rpy:121
    old "You undress and slip into the pool. The cool water is a relief from the heat."
    new "Ты раздеваешься и скользишь в бассейн. Прохладная вода спасает от жары."

    # game/scripts/Events/night_swim.rpy:121
    old "You set your clothes aside and step into the water. She watches you with a soft smile."
    new "Ты откладываешь одежду и заходишь в воду. Она смотрит на тебя с мягкой улыбкой."

    # game/scripts/Events/night_swim.rpy:121
    old "The water wraps around you as you lower yourself in. Much better than tossing in bed."
    new "Вода обволакивает тебя, пока ты опускаешься в неё. Куда лучше, чем ворочаться в кровати."

    # game/scripts/Events/night_swim.rpy:127
    old "This is nice, right? Just the two of us, the water, the stars..."
    new "Хорошо ведь, правда? Только мы вдвоём, вода, звёзды..."

    # game/scripts/Events/night_swim.rpy:127
    old "I have to admit, this is way better with company."
    new "Признаю, с компанией так намного лучше."

    # game/scripts/Events/night_swim.rpy:127
    old "You know, I was a little bored swimming alone. This is much better."
    new "Знаешь, мне было немного скучно плавать одной. Так гораздо лучше."

    # game/scripts/Events/night_swim.rpy:127
    old "The moonlight on the water is beautiful. I am glad you showed up."
    new "Лунный свет на воде такой красивый. Я рада, что ты пришёл."

    # game/scripts/Events/night_swim.rpy:134
    old "You know, it is hard to keep my distance when you are right there... like that."
    new "Знаешь, трудно держать дистанцию, когда ты вот тут... вот такой."

    # game/scripts/Events/night_swim.rpy:134
    old "The water is not the only thing making me feel warm right now."
    new "Сейчас меня согревает не только вода."

    # game/scripts/Events/night_swim.rpy:134
    old "Eyes up here. ...Or not. I do not really mind."
    new "Глаза выше. ...Или нет. Я не особо против."

    # game/scripts/Events/night_swim.rpy:134
    old "I can feel you looking at me. And honestly? I kind of like it."
    new "Я чувствую, как ты на меня смотришь. И честно? Мне это даже нравится."

    # game/scripts/Events/night_swim.rpy:143
    old "I will let you enjoy your swim. I should head back before someone notices."
    new "Не буду мешать тебе плавать. Мне пора назад, пока никто не заметил."

    # game/scripts/Events/night_swim.rpy:143
    old "Tempting, but I think I will just enjoy the view from here. Good night."
    new "Заманчиво, но я лучше полюбуюсь видом отсюда. Спокойной ночи."

    # game/scripts/Events/night_swim.rpy:143
    old "I better not. But your secret is safe with me."
    new "Лучше не стоит. Но твой секрет со мной в безопасности."

    # game/scripts/Events/night_swim.rpy:149
    old "Suit yourself. Your loss."
    new "Как хочешь. Тебе же хуже."

    # game/scripts/Events/night_swim.rpy:149
    old "Smart. Or boring. I have not decided which."
    new "Умно. Или скучно. Я ещё не решила."

    # game/scripts/Events/night_swim.rpy:149
    old "Fair enough. But the offer had an expiration date, just so you know."
    new "Справедливо. Но, чтоб ты знал, у предложения был срок годности."

    # game/scripts/Events/night_swim.rpy:157
    old "She drifts closer, the water lapping gently between you. The heat is not just from the weather anymore."
    new "Она подплывает ближе, вода мягко плещется между вами. Жар уже не только от погоды."

    # game/scripts/Events/night_swim.rpy:157
    old "Your bodies drift together in the warm night air. The water between you feels charged."
    new "Ваши тела сближаются в тёплом ночном воздухе. Вода между вами будто наэлектризована."

    # game/scripts/Events/night_swim.rpy:157
    old "Under the surface, her hand finds yours. Neither of you pulls away."
    new "Под водой её рука находит твою. Никто из вас не отстраняется."

    # game/scripts/Events/night_swim.rpy:163
    old "You know... since we are already here, already like this... maybe we do not have to stop at just swimming."
    new "Знаешь... раз уж мы здесь, раз уж мы вот так... может, нам не обязательно ограничиваться плаванием."

    # game/scripts/Events/night_swim.rpy:163
    old "I did not plan for company tonight. But now that you are here... I do not want to just swim."
    new "Я не ждала сегодня компании. Но раз уж ты здесь... мне не хочется просто плавать."

    # game/scripts/Events/night_swim.rpy:163
    old "The heat is not going away. And I do not think it is just the weather."
    new "Жара никуда не уходит. И, по-моему, дело не только в погоде."

    # game/scripts/Events/night_swim.rpy:169
    old "I... my heart is beating so fast right now. Is it the cold water or... you?"
    new "Я... у меня сейчас так быстро бьётся сердце. Это от холодной воды или... от тебя?"

    # game/scripts/Events/night_swim.rpy:169
    old "We probably should not be doing this... but I do not want to stop."
    new "Нам, наверное, не стоит этого делать... но я не хочу останавливаться."

    # game/scripts/Events/night_swim.rpy:169
    old "This feels like a dream. The kind I would never tell anyone about."
    new "Это как сон. Из тех, о которых я никогда никому не расскажу."

    # game/scripts/Events/night_swim.rpy:249
    old "As you approach the pool, you hear the faint sound of water splashing. Someone is here."
    new "Подходя к бассейну, ты слышишь тихий плеск воды. Здесь кто-то есть."

    # game/scripts/Events/night_swim.rpy:249
    old "You step outside and hear some splashing from the pool. At this hour?"
    new "Ты выходишь на улицу и слышишь плеск из бассейна. В такой час?"

    # game/scripts/Events/night_swim.rpy:249
    old "The pool comes into view, and you notice ripples in the water. You are not alone."
    new "Показывается бассейн, и ты замечаешь рябь на воде. Ты не один."

    # game/scripts/Events/night_swim.rpy:256
    old "You move closer and realize someone is swimming in the dark. No lights, no swimsuit."
    new "Ты подходишь ближе и понимаешь, что кто-то плавает в темноте. Без света, без купальника."

    # game/scripts/Events/night_swim.rpy:354
    old "Join her in the pool."
    new "Присоединиться к ней в бассейне."

    # game/scripts/Events/night_swim.rpy:355
    old "Give me a second."
    new "Дай мне секунду."

    # game/scripts/Events/night_swim.rpy:406
    old "Pull her closer."
    new "Притянуть её ближе."

    # game/scripts/Events/night_swim.rpy:407
    old "Come here..."
    new "Иди сюда..."

    # game/scripts/Events/night_swim.rpy:408
    old "She does not resist. Under the water, the distance between you vanishes."
    new "Она не сопротивляется. Под водой расстояние между вами исчезает."

    # game/scripts/Events/night_swim.rpy:414
    old "Just enjoy the moment."
    new "Просто наслаждаться моментом."

    # game/scripts/Events/night_swim.rpy:416
    old "You float side by side, watching the stars. Some moments do not need anything more."
    new "Вы лежите на воде бок о бок и смотрите на звёзды. Некоторым моментам больше ничего не нужно."

    # game/scripts/Events/night_swim.rpy:416
    old "You stay close, enjoying the silence and the cool water. Not everything has to escalate."
    new "Ты держишься рядом, наслаждаясь тишиной и прохладной водой. Не всё должно заходить дальше."

    # game/scripts/Events/night_swim.rpy:416
    old "The two of you drift together quietly. The night feels endless in the best way."
    new "Вы вдвоём тихо дрейфуете рядом. Ночь кажется бесконечной, в самом лучшем смысле."

    # game/scripts/Events/night_swim.rpy:428
    old "You swim together for a while, enjoying the cool water and the quiet night."
    new "Вы какое-то время плаваете вместе, наслаждаясь прохладной водой и тихой ночью."

    # game/scripts/Events/night_swim.rpy:428
    old "The two of you float around, talking softly. It feels natural, like this was always the plan."
    new "Вы вдвоём плаваете и тихо разговариваете. Всё так естественно, будто так и было задумано."

    # game/scripts/Events/night_swim.rpy:428
    old "Time passes quickly. The heat fades, replaced by the calm of the pool and good company."
    new "Время летит быстро. Жара спадает, уступая место спокойствию бассейна и хорошей компании."

    # game/scripts/Events/night_swim.rpy:439
    old "Eventually, you both climb out and dry off. The night air feels cooler now."
    new "В конце концов вы оба вылезаете и вытираетесь. Ночной воздух теперь кажется прохладнее."

    # game/scripts/Events/night_swim.rpy:439
    old "After a while, you get out of the water. She wraps herself in a towel, smiling."
    new "Через какое-то время ты выходишь из воды. Она заворачивается в полотенце и улыбается."

    # game/scripts/Events/night_swim.rpy:439
    old "The swim ends as quietly as it started. You both get dressed under the stars."
    new "Купание заканчивается так же тихо, как началось. Вы оба одеваетесь под звёздами."

    # game/scripts/Events/night_swim.rpy:447
    old "Tonight was... unexpected. But I am glad it happened."
    new "Сегодняшняя ночь была... неожиданной. Но я рада, что так вышло."

    # game/scripts/Events/night_swim.rpy:447
    old "Best midnight swim I have ever had. Do not tell anyone, though."
    new "Лучшее ночное купание в моей жизни. Только никому не говори."

    # game/scripts/Events/night_swim.rpy:447
    old "Same time tomorrow? ...I am kidding. Maybe."
    new "Завтра в то же время? ...Шучу. Может быть."

    # game/scripts/Events/night_swim.rpy:447
    old "If you tell anyone about this, I will deny everything."
    new "Если ты кому-нибудь расскажешь, я буду всё отрицать."

    # game/scripts/Events/night_swim.rpy:456
    old "Stay and watch from the edge."
    new "Остаться и смотреть с бортика."

    # game/scripts/Events/night_swim.rpy:458
    old "You sit at the edge of the pool, feet in the water, trying not to stare too obviously."
    new "Ты садишься на край бассейна, опустив ноги в воду, и стараешься пялиться не слишком откровенно."

    # game/scripts/Events/night_swim.rpy:458
    old "You settle on the pool edge. The moonlight on the water, and on her, is hard to ignore."
    new "Ты устраиваешься на бортике. Лунный свет на воде, и на ней, трудно не замечать."

    # game/scripts/Events/night_swim.rpy:458
    old "You take a seat nearby. She notices you watching but does not seem to mind."
    new "Ты садишься неподалёку. Она замечает, что ты смотришь, но, похоже, не против."

    # game/scripts/Events/night_swim.rpy:468
    old "Enjoying the show from there?"
    new "Нравится шоу оттуда?"

    # game/scripts/Events/night_swim.rpy:468
    old "You are staring. I can tell, even in the dark."
    new "Ты пялишься. Я вижу, даже в темноте."

    # game/scripts/Events/night_swim.rpy:468
    old "If you are going to watch, at least say something nice."
    new "Если уж смотришь, скажи хоть что-нибудь приятное."

    # game/scripts/Events/night_swim.rpy:481
    old "After a while, she climbs out and wraps a towel around herself."
    new "Через какое-то время она вылезает и заворачивается в полотенце."

    # game/scripts/Events/night_swim.rpy:481
    old "Eventually she gets out of the water, casually drying off next to you."
    new "В конце концов она выходит из воды и спокойно вытирается рядом с тобой."

    # game/scripts/Events/night_swim.rpy:481
    old "She finishes her swim and steps out, not in any rush to cover up."
    new "Она заканчивает плавать и выходит, не особо торопясь прикрыться."

    # game/scripts/Events/night_swim.rpy:489
    old "Thanks for the company. Even if you just sat there."
    new "Спасибо за компанию. Даже если ты просто сидел."

    # game/scripts/Events/night_swim.rpy:489
    old "Next time, get in the water. It is better than watching."
    new "В следующий раз залезай в воду. Это лучше, чем смотреть."

    # game/scripts/Events/night_swim.rpy:489
    old "Not bad for a surprise audience. Good night."
    new "Неплохо для неожиданного зрителя. Спокойной ночи."

    # game/scripts/Events/night_swim.rpy:497
    old "Decline and give her privacy."
    new "Отказаться и оставить её одну."

    # game/scripts/Events/night_swim.rpy:518
    old "Turn around and let her get dressed."
    new "Отвернуться и дать ей одеться."

    # game/scripts/Events/night_swim.rpy:519
    old "Of course. Take your time."
    new "Конечно. Не торопись."

    # game/scripts/Events/night_swim.rpy:532
    old "Tease her a little before turning around."
    new "Немного подразнить её, прежде чем отвернуться."

    # game/scripts/Events/night_swim.rpy:534
    old "Relax, it is nothing I have not imagined before."
    new "Расслабься, ничего такого, чего я раньше не представлял."

    # game/scripts/Events/night_swim.rpy:534
    old "For what it is worth, you have nothing to be embarrassed about."
    new "Если что, тебе нечего стесняться."

    # game/scripts/Events/night_swim.rpy:534
    old "I will turn around. But you should know, the view was worth the walk."
    new "Я отвернусь. Но знай, ради такого вида стоило прогуляться."

    # game/scripts/Events/night_swim.rpy:544
    old "You are impossible. ...But thanks, I guess."
    new "Ты невозможный. ...Но спасибо, наверное."

    # game/scripts/Events/night_swim.rpy:544
    old "Shut up and turn around already. ...But that was sweet."
    new "Заткнись и отвернись уже. ...Но это было мило."

    # game/scripts/Events/night_swim.rpy:544
    old "I cannot believe you just said that. ...Do not make me smile right now."
    new "Не верю, что ты это сказал. ...Не заставляй меня сейчас улыбаться."

    # game/scripts/Events/night_swim.rpy:556
    old "That is NOT funny right now. Turn around!"
    new "Это сейчас НЕ смешно. Отвернись!"

    # game/scripts/Events/night_swim.rpy:556
    old "Seriously?! Just look away!"
    new "Серьёзно?! Просто отвернись!"

    # game/scripts/Events/night_swim.rpy:556
    old "You are making this so much worse. TURN. AROUND."
    new "Ты делаешь только хуже. ОТВЕР. НИСЬ."

    # game/scripts/Events/night_swim.rpy:570
    old "Let us just pretend this did not happen."
    new "Давай просто сделаем вид, что этого не было."

    # game/scripts/Events/night_swim.rpy:570
    old "Okay. I am dressed. You can look now."
    new "Так. Я одета. Можешь смотреть."

    # game/scripts/Events/night_swim.rpy:570
    old "There. Crisis over. We do not speak of this."
    new "Всё. Кризис позади. Об этом мы не говорим."

