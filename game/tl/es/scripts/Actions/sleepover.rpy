translate es strings:

    # game/scripts/Actions/sleepover.rpy:155
    old "I'm married. I sleep at home, in my own bed. Don't ask me that again."
    new "Estoy casada. Duermo en casa, en mi propia cama. No vuelvas a pedirme eso."

    # game/scripts/Actions/sleepover.rpy:155
    old "Every night? I have a husband and a house. The answer is no."
    new "¿Todas las noches? Tengo un esposo y una casa. La respuesta es no."

