    "Te despiertas solo. La cama ya está fría."

# game/scripts/Actions/sleepover.rpy:871
translate es sleepover_multi_accept_sleepover_duo_1bdf1e5d:

    # "You wake up to find one side of the bed empty and already cold."
    "Te despiertas y encuentras un lado de la cama vacío y ya frío."

# game/scripts/Actions/sleepover.rpy:988
translate es sleepover_multi_wake_up_duo_done_23f01cd2:

    # "You leave the room."
    "Sales del cuarto."

# game/scripts/Actions/sleepover.rpy:1085
translate es sleepover_multi_wake_up_duo_done_78a34b3f:

    # "There's a knock at the door. Before you can answer, it opens."
    "Alguien toca la puerta. Antes de que puedas responder, se abre."

# game/scripts/Actions/sleepover.rpy:1131
translate es sleepover_multi_wake_up_duo_done_d0206e04:

    # "[_so_mv_npc_name] nods and heads out."
    "[_so_mv_npc_name] asiente y sale."

# game/scripts/Actions/sleepover.rpy:1133
translate es sleepover_multi_wake_up_duo_done_430b3ffc:

    # "[_so_mv_npc_name] gives you a long look before leaving."
    "[_so_mv_npc_name] te da una larga mirada antes de irse."

# game/scripts/Actions/sleepover.rpy:1135
translate es sleepover_multi_wake_up_duo_done_a82123b6:

    # "[_so_mv_npc_name] slams the door on the way out."
    "[_so_mv_npc_name] cierra la puerta de un golpe al salir."

translate es strings:

    # game/scripts/Actions/sleepover.rpy:1022
    old "You know... my %(pl)s is going to wonder where I am tonight."
    new "Sabes... mi %(pl)s se va a preguntar dónde estoy esta noche."

    # game/scripts/Actions/sleepover.rpy:1033
    old "This is the second night in a row... my %(pl)s is definitely going to start asking questions."
    new "Es la segunda noche seguida... mi %(pl)s definitivamente va a empezar a hacer preguntas."

    # game/scripts/Actions/sleepover.rpy:1044
    old "This will be three nights in a row... I'm sure my %(pl)s is going to show up looking for me tomorrow."
    new "Van a ser tres noches seguidas... estoy segura de que mi %(pl)s va a aparecer buscándome mañana."

# TODO: Translation updated at 2026-09-30 00:35

translate es strings:

    # game/scripts/Actions/sleepover.rpy:120
    old "Of course! I'd love that."
    new "¡Claro! Me encantaría."

    # game/scripts/Actions/sleepover.rpy:120
    old "You don't even have to ask. I'll be there."
    new "Ni siquiera tienes que pedirlo. Ahí estaré."

    # game/scripts/Actions/sleepover.rpy:120
    old "Finally! I was hoping you'd ask."
    new "¡Por fin! Esperaba que me lo pidieras."

    # game/scripts/Actions/sleepover.rpy:126
    old "That's risky... but okay. I'll sneak in when %(pp)s is not around."
    new "Es arriesgado... pero está bien. Me escaparé cuando %(pp)s no esté cerca."

    # game/scripts/Actions/sleepover.rpy:126
    old "If %(pp)s finds out, we're both dead. But... yeah, I'll come."
    new "Si %(pp)s se entera, estamos muertos. Pero... sí, iré."

    # game/scripts/Actions/sleepover.rpy:131
    old "Sure, I don't mind. Your room is comfy anyway."
    new "Claro, no me molesta. Tu cuarto es cómodo de todos modos."

    # game/scripts/Actions/sleepover.rpy:131
    old "Okay... but don't get any ideas. Or do. Whatever."
    new "Está bien... pero no te hagas ideas. O sí. Da igual."

    # game/scripts/Actions/sleepover.rpy:131
    old "Alright. I'll start coming over at night."
    new "Está bien. Empezaré a venir en las noches."

    # game/scripts/Actions/sleepover.rpy:142
    old "We're not that close yet. Maybe someday."
    new "Todavía no somos tan cercanos. Tal vez algún día."

    # game/scripts/Actions/sleepover.rpy:142
    old "I appreciate the offer, but... not yet."
    new "Agradezco la oferta, pero... todavía no."

    # game/scripts/Actions/sleepover.rpy:148
    old "I can't do that. %(Pp)s would notice if I'm gone every night."
    new "No puedo. %(Pp)s notaría si desaparezco todas las noches."

    # game/scripts/Actions/sleepover.rpy:148
    old "That's way too risky. %(Pp)s would find out."
    new "Eso es demasiado arriesgado. %(Pp)s se enteraría."

    # game/scripts/Actions/sleepover.rpy:154
    old "Sleep in a guy's room every night? No thanks."
    new "¿Dormir en el cuarto de un chico todas las noches? No, gracias."

    # game/scripts/Actions/sleepover.rpy:160
    old "I'm not ready for that yet. Give me some time."
    new "Todavía no estoy lista para eso. Dame un tiempo."

    # game/scripts/Actions/sleepover.rpy:160
    old "Let's take things slower, okay?"
    new "Vamos más despacio, ¿sí?"

    # game/scripts/Actions/sleepover.rpy:173
    old "Oh... okay. I'll go back to my room then."
    new "Oh... está bien. Entonces vuelvo a mi cuarto."

    # game/scripts/Actions/sleepover.rpy:173
    old "If that's what you want. Fine."
    new "Si eso es lo que quieres. Está bien."

    # game/scripts/Actions/sleepover.rpy:173
    old "Alright, I'll stop coming over."
    new "Está bien, dejaré de venir."

