    # game/scripts/Actions/sleepover.rpy:62
    old "%s doesn't like %s enough"
    new "A %s no le cae lo suficientemente bien %s"

    # game/scripts/Actions/sleepover.rpy:64
    old "%s is too jealous right now"
    new "%s está demasiado celosa ahora"

