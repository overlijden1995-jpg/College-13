translate es caught_in_public_02c518ed:

    # "Later that day, you notice [_cap_gf.Name] looking at her phone with a strange expression."
    "Mas tarde ese dia, notas a [_cap_gf.Name] mirando su celular con una expresion extrana."

translate es caught_in_public_11677716:

    # "Word travels fast around campus. Your girlfriend has heard some... rumors about you."
    "Las noticias viajan rapido por el campus. Tu novia ha escuchado algunos... rumores sobre ti."

translate es caught_in_public_6af1a3c3:

    # "By evening, [_cap_gf.Name] is unusually quiet. Someone must have told her what happened."
    "Para la noche, [_cap_gf.Name] esta inusualmente callada. Alguien debio contarle lo que paso."

translate es caught_in_public_9e3064ad:

    # "You catch her glancing at you with a mix of hurt and suspicion."
    "La pillas mirandote con una mezcla de dolor y desconfianza."

translate es caught_in_public_942e53e1:

    # "A classmate whispers something to [_cap_gf.Name] in the hallway. She turns to look at you."
    "Un companero de clase le susurra algo a [_cap_gf.Name] en el pasillo. Ella se voltea a mirarte."

translate es caught_in_public_64e56d5e:

    # "Her eyes narrow. She's definitely heard something."
    "Sus ojos se estrechan. Definitivamente escucho algo."

translate es caught_in_public_35d53185:

    # "You overhear someone in the hall: \"Did you hear about [Player.Name] and [girl.Name]?\""
    "Escuchas a alguien en el pasillo: \"Te enteraste de [Player.Name] y [girl.Name]?\""

translate es caught_in_public_941c8533:

    # "If that reached your ears, it definitely reached [_cap_gf.Name]'s."
    "Si eso llego a tus oidos, definitivamente llego a los de [_cap_gf.Name]."

translate es caught_in_public_01bbddbb:

    # "[_cap_gf.Name] sends you a cold text: \"We need to talk later.\""
    "[_cap_gf.Name] te manda un mensaje frio: \"Tenemos que hablar despues.\""

translate es caught_in_public_2c140439:

    # "Rumors spread like wildfire on campus. She knows something happened."
    "Los rumores se esparcen como fuego en el campus. Ella sabe que algo paso."

translate es strings:

    # === CROWD CONFIG / CATCH CONFIG ===
    old "Teacher"
    new "Profesor"

    old "Coach"
    new "Entrenador"

    old "Security Guard"
    new "Guardia de Seguridad"

    old "Supervisor"
    new "Supervisor"

    old "Attendant"
    new "Empleada"

    old "Waiter"
    new "Mesero"

    # === ATTENTION WARNINGS — campus ===
    old "A few students walking by glance in your direction."
    new "Algunos estudiantes que pasan miran en tu direccion."

    old "People nearby are whispering and looking over at you two."
    new "Personas cercanas estan susurrando y mirandolos a ustedes dos."

    old "A small crowd has gathered. Someone pulls out their phone. This is getting dangerous."
    new "Se junto una pequena multitud. Alguien saca su celular. Esto se esta poniendo peligroso."

    # === ATTENTION WARNINGS — pool ===
    old "The sound of splashing echoes. Someone at the far end of the pool looks your way."
    new "El sonido de salpicaduras resuena. Alguien al otro lado de la piscina mira hacia ti."

    old "A couple of swimmers have stopped to stare. The water has gone quiet."
    new "Un par de nadadores se detuvieron a mirar. El agua se quedo en silencio."

    old "Everyone at the pool is watching. You hear someone say 'Is that...?' You need to stop."
    new "Todos en la piscina estan mirando. Escuchas a alguien decir 'Ese es...?' Necesitas parar."

    # === ATTENTION WARNINGS — gym ===
    old "Someone on the treadmill takes their earbuds out, looking confused."
    new "Alguien en la caminadora se quita los audifonos, con cara de confusion."

    old "Several gym-goers have stopped their workouts. The weight room has gone oddly silent."
    new "Varios de los que estan en el gimnasio dejaron de entrenar. La sala de pesas quedo extranamente en silencio."

    old "Almost everyone in the gym is staring. Someone just left in a hurry, probably to tell someone."
    new "Casi todos en el gimnasio estan mirando. Alguien acaba de salir corriendo, probablemente a contarle a alguien."

    # === ATTENTION WARNINGS — classroom ===
    old "A student in the back row turns around, eyes wide."
    new "Un estudiante en la ultima fila se voltea, con los ojos abiertos."

    old "Half the class is pretending not to watch. The other half isn't pretending."
    new "La mitad de la clase finge no estar mirando. La otra mitad ni finge."

    old "The entire classroom is dead silent. Everyone is staring. You hear footsteps in the hallway."
    new "El salon entero esta en silencio total. Todos estan mirando fijo. Escuchas pasos en el pasillo."

    # === ATTENTION WARNINGS — hall ===
    old "A passing student does a double take."
    new "Un estudiante que pasa mira dos veces."

    old "People in the hallway are slowing down, pretending to check their phones."
    new "La gente en el pasillo esta bajando el paso, fingiendo revisar sus celulares."

    old "A group of students has stopped completely. One of them is giggling nervously. This won't stay quiet."
    new "Un grupo de estudiantes se detuvo completamente. Uno de ellos se rie nerviosamente. Esto no va a quedar en secreto."

    # === ATTENTION WARNINGS — mall ===
    old "A shopper passing by does a double take and walks faster."
    new "Un comprador que pasa mira dos veces y camina mas rapido."

    old "Several people have stopped browsing. A store clerk is watching with wide eyes."
    new "Varias personas dejaron de mirar las tiendas. Un empleado observa con los ojos muy abiertos."

    old "The entire area has gone quiet. Someone is pointing. A security guard reaches for his radio."
    new "Toda el area se quedo en silencio. Alguien esta senalando. Un guardia de seguridad toma su radio."

    # === ATTENTION WARNINGS — showers ===
    old "You hear the water in the next stall turn off. There's a pause... then it turns back on."
    new "Escuchas el agua en la regadera de al lado detenerse. Una pausa... y vuelve a correr."

    old "The shower curtain in the neighboring stall shifts slightly. Was someone peeking?"
    new "La cortina de la regadera de al lado se mueve ligeramente. Alguien estaba espiando?"

    old "The showers have gone quiet. It feels like everyone stopped to listen. You hear whispers near the entrance."
    new "Las regaderas se quedaron en silencio. Se siente como si todos se hubieran detenido a escuchar. Escuchas susurros cerca de la entrada."

    # === ATTENTION WARNINGS — dressing_room ===
    old "You hear the click of heels outside the curtain. Someone pauses nearby."
    new "Escuchas el clic de tacones afuera de la cortina. Alguien se detiene cerca."

    old "A knock on the dressing room wall. 'Everything okay in there?' the attendant calls out."
    new "Un golpe en la pared del probador. 'Todo bien ahi adentro?' llama la empleada."

    old "The attendant is right outside. 'Other customers are complaining. I need you to finish up in there.'"
    new "La empleada esta justo afuera. 'Otros clientes se estan quejando. Necesito que terminen ahi adentro.'"

    # === OBSERVER ARRIVAL — campus ===
    old "A professor walking across the quad spots you and marches over furiously."
    new "Un profesor cruzando el patio te ve y se acerca furioso."

    old "A professor rounds the corner and freezes. Then his face goes red with anger."
    new "Un profesor dobla la esquina y se congela. Despues su cara se pone roja de enojo."

    old "A teacher on their way to the parking lot stops dead in their tracks."
    new "Un profesor camino al estacionamiento se detiene en seco."

    # === OBSERVER ARRIVAL — pool ===
    old "The pool supervisor bursts through the locker room door, whistle in hand."
    new "El supervisor de la piscina irrumpe por la puerta del vestidor, silbato en mano."

    old "Coach walks out of his office and sees you through the glass. He storms over."
    new "El entrenador sale de su oficina y te ve a traves del vidrio. Viene furioso."

    old "The lifeguard blows her whistle so hard it echoes off the walls."
    new "La salvavidas sopla su silbato tan fuerte que retumba en las paredes."

    # === OBSERVER ARRIVAL — gym ===
    old "Coach slams the equipment room door open. He was in there the whole time."
    new "El entrenador abre la puerta del cuarto de equipos de golpe. Estuvo ahi todo el tiempo."

    old "The PE teacher walks in carrying new dumbbells. They hit the floor with a clang."
    new "El profesor de educacion fisica entra cargando mancuernas nuevas. Se le caen al piso con un estruendo."

    old "A teacher doing their evening jog stops at the gym entrance, jaw dropping."
    new "Un profesor haciendo su trote nocturno se detiene en la entrada del gimnasio, con la mandibula caida."

    # === OBSERVER ARRIVAL — classroom ===
    old "The classroom door swings open. The professor walks in early for the next class."
    new "La puerta del salon se abre. El profesor llega temprano para la siguiente clase."

    old "A teacher passing by hears the noise, opens the door, and finds you mid-act."
    new "Un profesor que pasa escucha el ruido, abre la puerta, y los encuentra en el acto."

    old "The janitor opens the door to clean the room. His mop clatters to the floor."
    new "El conserje abre la puerta para limpiar el salon. Su trapeador cae al suelo con estruendo."

    # === OBSERVER ARRIVAL — hall ===
    old "A professor steps out of their office and catches you right there in the hallway."
    new "Un profesor sale de su oficina y los pilla ahi mismo en el pasillo."

    old "The vice-principal rounds the corner carrying a stack of papers. They scatter everywhere."
    new "El subdirector dobla la esquina cargando una pila de papeles. Se le esparcen por todos lados."

    old "A teacher coming back from lunch spots you and nearly drops their coffee."
    new "Un profesor volviendo del almuerzo te ve y casi tira su cafe."

    # === OBSERVER ARRIVAL — mall ===
    old "A mall security guard rounds the corner and stops dead. His walkie-talkie crackles."
    new "Un guardia de seguridad del centro comercial da la vuelta y se detiene en seco. Su radio crepita."

    old "The store manager steps out and catches you. She reaches for the phone immediately."
    new "La gerente de la tienda sale y te atrapa. Toma el telefono de inmediato."

    old "A security guard shines his flashlight your way. 'Hey! What the hell are you doing?!'"
    new "Un guardia de seguridad apunta su linterna hacia ustedes. 'Oigan! Que diablos estan haciendo?!'"

    # === OBSERVER ARRIVAL — showers ===
    old "The dorm supervisor barges into the shower area after students reported the noise."
    new "El supervisor del dormitorio irrumpe en el area de regaderas despues de que estudiantes reportaron el ruido."

    old "A student runs to get the supervisor. Moments later, the stall door is pulled open."
    new "Un estudiante corre a buscar al supervisor. Momentos despues, la puerta de la regadera se abre."

    old "The shower attendant storms in after hearing complaints. She finds you two mid-act."
    new "La encargada de las regaderas entra furiosa despues de escuchar quejas. Los encuentra a los dos en el acto."

    # === OBSERVER ARRIVAL — dressing_room ===
    old "The attendant pulls the curtain open after repeated complaints from other customers."
    new "La empleada abre la cortina despues de quejas repetidas de otros clientes."

    old "The store manager herself comes over and yanks the dressing room curtain aside."
    new "La propia gerente de la tienda viene y jala la cortina del probador."

    old "An attendant knocks hard on the door. 'That's IT. I'm opening this.' She does."
    new "Una empleada golpea fuerte la puerta. 'Ya basta. Voy a abrir esto.' Y lo hace."

    # === OBSERVER ARRIVAL — fallback ===
    old "Someone spots you and storms over."
    new "Alguien te ve y viene furioso."

    # === OBSERVER REACTIONS ===
    old "What on EARTH do you two think you're doing?!"
    new "Que DEMONIOS creen que estan haciendo ustedes dos?!"

    old "Are you SERIOUS right now?! HERE of all places?!"
    new "Estan hablando en SERIO?! AQUI de todos los lugares?!"

    old "I cannot believe what I'm seeing. This is absolutely unacceptable!"
    new "No puedo creer lo que estoy viendo. Esto es absolutamente inaceptable!"

    old "You two! Stop that RIGHT NOW!"
    new "Ustedes dos! Dejen eso AHORA MISMO!"

    # === OBSERVER DISMISS ===
    old "Both of you, get dressed and go to your rooms. NOW."
    new "Ambos, vistanse y vayan a sus cuartos. AHORA."

    old "Both of you, get dressed and get out of here. NOW."
    new "Ambos, vistanse y salgan de aqui. AHORA."

    # === OBSERVER PENALTIES ===
    old "Your grades on the next exam will be reduced as punishment. Don't let this happen again."
    new "Sus notas en el proximo examen seran reducidas como castigo. Que no vuelva a pasar."

    old "You're banned from this place for the rest of the day. Don't come back."
    new "Estan vetados de este lugar por el resto del dia. No regresen."

    old "This is the SECOND time I've had to deal with you two. The penalty will be much harsher."
    new "Esta es la SEGUNDA vez que tengo que lidiar con ustedes dos. El castigo sera mucho mas severo."

    old "This is the SECOND time?! I'm calling the police if it happens again."
    new "Es la SEGUNDA vez?! Voy a llamar a la policia si pasa de nuevo."

    old "AGAIN?! I'm running out of patience. One more time and I'm taking this to the dean."
    new "OTRA VEZ?! Se me esta acabando la paciencia. Una vez mas y lo llevo al decano."

    old "AGAIN?! That's it. Security, escort them out. You're done here."
    new "OTRA VEZ?! Ya basta. Seguridad, saquenlos. Aqui se acabo para ustedes."

    # === EXHIB/FETISH NARRATION with %s ===
    old "She doesn't stop. She heard the %s, but she keeps going as if nothing happened."
    new "Ella no para. Escucho al %s, pero sigue como si nada hubiera pasado."

    old "The %s's face turns an even deeper shade of red."
    new "La cara del %s se pone de un tono aun mas rojo."

    old "The %s stares in disbelief."
    new "El %s se queda mirando, incredulo."

    # === EXHIB YELL TEMPLATES ===
    old "{0}! Take your {1} off {2} RIGHT NOW! WHAT THE HELL?!"
    new "{0}! Quita tu {1} de {2} AHORA MISMO! QUE DIABLOS?!"

    old "{0}! Get your {1} off of him THIS INSTANT! ARE YOU OUT OF YOUR MIND?!"
    new "{0}! Quita tu {1} de el EN ESTE INSTANTE! PERDISTE LA CABEZA?!"

    old "{0}! Remove your {1} from that boy IMMEDIATELY! I SAID NOW!"
    new "{0}! Quita tu {1} de ese chico INMEDIATAMENTE! DIJE AHORA!"

    # === EXHIB CAUGHT LINES ===
    old "Oh, sorry... I was almost there. Could you give us like two more minutes?"
    new "Ay, perdon... ya casi llegaba. Nos puede dar como dos minutitos mas?"

    old "Ugh, really? Right when it was getting good... Fine, fine."
    new "Ugh, en serio? Justo cuando se estaba poniendo bueno... Bueno, bueno."

    old "Sorry... just a few more seconds would have been nice."
    new "Perdon... solo unos segunditos mas hubiera estado bien."

    old "Aww, come on! We were putting on such a good show for everyone..."
    new "Ay, vamos! Les estabamos dando un show tan bueno a todos..."

    old "You couldn't have waited just a LITTLE longer? I was so close..."
    new "No podias haber esperado solo UN POQUITO mas? Estaba tan cerca..."

    # === FETISH CAUGHT LINES ===
    old "Mmm... getting caught is kind of the best part though, isn't it?"
    new "Mmm... que nos pillen es como la mejor parte, no?"

    old "Oh no, we got caught... my heart is racing so fast right now..."
    new "Ay no, nos pillaron... mi corazon esta latiendo muy rapido ahora..."

    old "Sorry... the risk of someone seeing us just made it feel SO much better..."
    new "Perdon... el riesgo de que alguien nos viera lo hizo sentir MUCHO mejor..."

    old "I knew someone would catch us eventually... and honestly? Worth it."
    new "Sabia que alguien nos iba a pillar en algun momento... y sinceramente? Valio la pena."

    old "I... I can't help it. The thrill of doing it here is just..."
    new "Yo... no puedo evitarlo. La adrenalina de hacerlo aqui es..."

    # === GIRL REACTIONS ===
    old "Oh god... oh no no no..."
    new "Dios mio... no no no..."

    old "I can't believe we did this... I TOLD you this was risky!"
    new "No puedo creer que hicimos esto... TE DIJE que era arriesgado!"

    old "Seriously?! We were just getting started and THIS happens?! Ugh, what a waste."
    new "¿¡En serio?! ¡Apenas estábamos empezando y pasa ESTO! Ugh, qué desperdicio."

    old "Oh god, that was so embarrassing... but... it was kind of exciting too, wasn't it?"
    new "Dios mio, eso fue tan vergonzoso... pero... también fue algo emocionante, ¿no?"

    old "I knew this was a bad idea... I KNEW it. What were we thinking?!"
    new "Sabía que era mala idea... LO SABÍA. ¿¡En qué estábamos pensando?!"

    old "This is YOUR fault. I never should have let you talk me into this."
    new "Esto es TU culpa. Nunca debi dejarte convencerme."

    # === SEMI-PRIVATE GIRL REACTIONS ===
    old "shhh! Someone's going to hear us!"
    new "shhh! Alguien nos va a escuchar!"

    old "Wait... did you hear that? I think someone's there..."
    new "Espera... escuchaste eso? Creo que hay alguien ahi..."

    old "Keep it down! These walls are thin!"
    new "Haz menos ruido! Estas paredes son delgadas!"

    old "Oh god, what if someone walks in?!"
    new "Dios mio, y si alguien entra?!"

    old "Let them listen~"
    new "Que escuchen~"

    old "Mmm... I don't care if someone hears."
    new "Mmm... no me importa si alguien escucha."

    old "The steam hides everything. Probably."
    new "El vapor esconde todo. Probablemente."

    old "Someone peeking? Good for them."
    new "Alguien espiando? Bien por ellos."

    # === SEMI-PRIVATE AMBIENT ===
    old "A soft giggle echoes from nearby. Someone definitely heard that."
    new "Una risita resuena desde cerca. Alguien definitivamente escucho eso."

    old "You hear whispered voices near the entrance. 'Did you hear that?' 'Hear what?'"
    new "Escuchas voces susurrando cerca de la entrada. 'Escuchaste eso?' 'Escuchar que?'"

    old "Someone drops something nearby. The timing feels... suspicious."
    new "Alguien tira algo cerca. El momento se siente... sospechoso."

    old "A girl walks past and does a quick double take before hurrying away."
    new "Una chica pasa y mira dos veces antes de irse apurada."

    old "You catch a glimpse of someone's shadow lingering outside for a moment too long."
    new "Notas la sombra de alguien demorando afuera por demasiado tiempo."

    old "Through the steam, you notice someone peeking around the corner before ducking away."
    new "A traves del vapor, notas a alguien espiando por la esquina antes de esconderse."

    old "It's hard to tell if anyone else is still here."
    new "Es dificil saber si alguien mas sigue aqui."

    old "You hear footsteps approaching... then retreating. False alarm."
    new "Escuchas pasos acercandose... y alejandose. Falsa alarma."

    old "The background noise drowns out most sounds. At least you hope it does."
    new "El ruido de fondo ahoga la mayoria de los sonidos. Al menos eso esperas."

    # === DISMISS ===
    old "You get dressed as fast as you can and leave, alone."
    new "Te vistes lo mas rapido que puedes y te vas, solo."
