    # "She immediately freezes and pulls away."
    "Ella se congela de inmediato y se aparta."

translate es caught_in_public_c904934e:

    # "She covers her face, mortified. She looks like she wants the ground to swallow her."
    "Se cubre la cara, mortificada. Parece que quiere que la tierra la trague."

translate es caught_in_public_2c2891c5:

    # "She finally pulls away, looking more annoyed than embarrassed."
    "Finalmente se aparta, viendose mas molesta que avergonzada."

translate es caught_in_public_30cf0a66:

    # "She pulls away from you immediately, face burning with shame."
    "Se aparta de ti inmediatamente, la cara ardiendo de verguenza."

translate es caught_in_public_600273d6:

    # "There's no way to talk your way out of this."
    "No hay forma de salir de esta hablando."

