# game/scripts/Actions/actions.rpy:1784
translate es gym_event_bench_press_719f9fae:

    # "You unrack four plates per side and push through the set with raw effort."
    "Descuelgas la barra con cuatro discos por lado y sacas la serie a pura fuerza."

# game/scripts/Actions/actions.rpy:1785
translate es gym_event_bench_press_0ed1576f:

    # "Your face is twisted with strain, but you don't stop. She watches every single rep."
    "Tienes la cara desencajada por el esfuerzo, pero no paras. Ella mira cada repetición."

# game/scripts/Actions/actions.rpy:1788
translate es gym_event_bench_press_416b445a:

    # "She nods slowly, genuine respect in her eyes."
    "Asiente despacio, con respeto genuino en la mirada."

# game/scripts/Actions/actions.rpy:1795
translate es gym_event_bench_press_8c3c5a99_1:

    # "You unrack the bar and immediately feel the weight crushing down on you."
    "Descuelgas la barra y de inmediato sientes el peso aplastándote."

# game/scripts/Actions/actions.rpy:1796
translate es gym_event_bench_press_34146543_1:

    # "Your arms tremble. The bar starts sinking toward your chest."
    "Te tiemblan los brazos. La barra empieza a bajar hacia tu pecho."

# game/scripts/Actions/actions.rpy:1839
translate es gym_event_leg_swap_b963e72e:

    # "You trade sets back and forth. She pushes heavy weight with zero hesitation."
    "Se turnan las series. Ella levanta mucho peso sin dudar ni un segundo."

# game/scripts/Actions/actions.rpy:1840
translate es gym_event_leg_swap_3ee0626e:

    # "By the end, you're both drenched in sweat."
    "Al final, los dos están empapados de sudor."

# game/scripts/Actions/actions.rpy:1849
translate es gym_event_leg_swap_b9a667f4:

    # "She leans against the wall, watching your form while she waits."
    "Se apoya en la pared, observando tu técnica mientras espera."

# game/scripts/Actions/actions.rpy:1857
translate es gym_event_leg_swap_d3b21a91:

    # "She loads more weight on without a second glance at you."
    "Pone más peso sin volver a mirarte."

# game/scripts/Actions/actions.rpy:1896
translate es gym_event_squat_form_398caa4d:

    # "She's at the squat rack, crushing a heavy set with perfect form."
    "Está en el rack de sentadillas, aplastando una serie pesada con técnica perfecta."

# game/scripts/Actions/actions.rpy:1897
translate es gym_event_squat_form_cd885077:

    # "She racks the bar and catches you watching."
    "Deja la barra en el soporte y te descubre mirando."

# game/scripts/Actions/actions.rpy:1905
translate es gym_event_squat_form_6637b2be:

    # "She loads another plate on each side."
    "Pone otro disco de cada lado."

# game/scripts/Actions/actions.rpy:1914
translate es gym_event_squat_form_7e5c82be:

    # "She spends five minutes fixing your stance, hip hinge, and depth."
    "Pasa cinco minutos corrigiendo tu postura, la bisagra de cadera y la profundidad."

# game/scripts/Actions/actions.rpy:1920
translate es gym_event_squat_form_103293bd:

    # "You position yourself behind her for the next set."
    "Te colocas detrás de ella para la siguiente serie."

# game/scripts/Actions/actions.rpy:1921
translate es gym_event_squat_form_a1beb0a9:

    # "She catches your gaze in the mirror immediately."
    "Te descubre mirándola en el espejo al instante."

# game/scripts/Actions/actions.rpy:1983
translate es gym_event_stretching_help_3beb5feb:

    # "After her workout, she's doing a full split on the mat like it's nothing."
    "Después de entrenar, hace un split completo en la colchoneta como si nada."

# game/scripts/Actions/actions.rpy:1984
translate es gym_event_stretching_help_87405293:

    # "She notices you watching and smirks."
    "Nota que la miras y sonríe de lado."

# game/scripts/Actions/actions.rpy:1991
translate es gym_event_stretching_help_0db659a6:

    # "She stands up and crosses her arms."
    "Se levanta y se cruza de brazos."

# game/scripts/Actions/actions.rpy:2000
translate es gym_event_stretching_help_bf6beb66:

    # "You try to match her stretch. Your hamstrings scream."
    "Intentas igualar su estiramiento. Tus isquiotibiales gritan."

# game/scripts/Actions/actions.rpy:2004
translate es gym_event_stretching_help_de5b1103:

    # "You manage a decent stretch, not matching her but not embarrassing either."
    "Logras un estiramiento decente. No igualas el de ella, pero tampoco das vergüenza."

# game/scripts/Actions/actions.rpy:2009
translate es gym_event_stretching_help_2e4b1e4c:

    # "You barely get halfway. She watches with visible disappointment."
    "Apenas llegas a la mitad. Ella mira con evidente decepción."

# game/scripts/Actions/actions.rpy:2017
translate es gym_event_stretching_help_003f7bd6:

    # "She turns back to her mat, dismissing you."
    "Vuelve a su colchoneta, ignorándote."

# game/scripts/Actions/actions.rpy:2087
translate es gym_event_squat_watch_a464501f:

    # "She looks at your legs pointedly."
    "Te mira las piernas de forma muy intencionada."

# game/scripts/Actions/actions.rpy:2102
translate es gym_event_squat_watch_01d112ed:

    # "She loads an extra plate on each side and crushes three reps."
    "Pone un disco extra de cada lado y aplasta tres repeticiones."

# game/scripts/Actions/actions.rpy:2103
translate es gym_event_squat_watch_55276f7f:

    # "She racks the bar and turns to you, barely winded."
    "Deja la barra en el soporte y se voltea hacia ti, apenas agitada."

# game/scripts/Actions/actions.rpy:2108
translate es gym_event_squat_watch_4b2d2854:

    # "You step up and manage two solid reps. It's ugly, but you don't fail."
    "Te pones en posición y logras dos repeticiones sólidas. No es bonito, pero no fallas."

# game/scripts/Actions/actions.rpy:2113
translate es gym_event_squat_watch_513ca361:

    # "You step up and the bar nearly buries you on the first rep. She has to help you rerack."
    "Te pones en posición y la barra casi te aplasta en la primera repetición. Ella tiene que ayudarte a dejarla en el soporte."

# game/scripts/Actions/actions.rpy:2122
translate es gym_event_squat_watch_7c820a9b_1:

    # "You glance away and continue your own workout."
    "Apartas la mirada y sigues con tu propio entrenamiento."

# game/scripts/Actions/actions.rpy:2229
translate es gym_event_exercise_help_eb16e128:

    # "She walks off and finds another spotter in seconds."
    "Se va y encuentra a otra persona que la asista en segundos."

# game/scripts/Actions/actions.rpy:2255
translate es gym_event_exercise_help_586982a1:

    # "She grits her teeth and grinds through it by pure determination."
    "Aprieta los dientes y lo saca a pura determinación."

# game/scripts/Actions/actions.rpy:2256
translate es gym_event_exercise_help_3bad8581:

    # "She racks the weight and stands up, glaring at you."
    "Deja el peso en el soporte y se levanta, fulminándote con la mirada."

# game/scripts/Actions/actions.rpy:2296
translate es gym_event_exercise_help_cb9974fa:

    # "She's breathing hard but grinning."
    "Respira con dificultad, pero sonríe."

# game/scripts/Actions/actions.rpy:2329
translate es gym_event_squat_behind_3523547f:

    # "She catches your eye in the mirror without breaking her form."
    "Cruza la mirada contigo en el espejo sin perder la técnica."

# game/scripts/Actions/actions.rpy:2357
translate es gym_event_squat_behind_3213a69a:

    # "You nod and get back to your own workout."
    "Asientes y vuelves a tu propio entrenamiento."

# game/scripts/Actions/actions.rpy:2358
translate es gym_event_squat_behind_47e84d00:

    # "She watches you in the mirror for a moment before continuing her set."
    "Te observa en el espejo un momento antes de seguir con su serie."

