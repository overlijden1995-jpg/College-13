# game/scripts/Actions/actions.rpy:794
translate es do_shower_60b75ebf:

    # "The door closes hard enough to rattle the mirror."
    "La puerta se cierra con tanta fuerza que hace temblar el espejo."

# game/scripts/Actions/actions.rpy:917
translate es do_shower_35235e75_3:

    # "You finish your shower alone."
    "Terminas tu ducha solo."

