translate es class_event_obvious_interruption_7b7fe4e6:

    # "The professor clears his throat and moves on."
    "O professor limpa a garganta y segue em frente."

# game/scripts/Actions/actions.rpy:1322
translate es class_event_obvious_interruption_7e3e951a:

    # "She tries to stifle a laugh."
    "Ella tenta segurar o riso."

# game/scripts/Actions/actions.rpy:1328
translate es class_event_obvious_interruption_40761418:

    # "You bite your tongue and let the moment pass."
    "Tu morde a língua y deja o momento passar."

# game/scripts/Actions/actions.rpy:1329
translate es class_event_obvious_interruption_2881e8a9:

    # "The professor handles it with a polite nod and continues. The student looks pleased with themselves."
    "O professor lida con un aceno educado y continua. O aluno parece satisfeito consigo mesmo."

# game/scripts/Actions/actions.rpy:1330
translate es class_event_obvious_interruption_0c9f284b:

    # "You exchange a brief glance with her. She rolls her eyes."
    "Ustedes trocam un olhar rápido. Ella revira os ojos."

# game/scripts/Actions/actions.rpy:1334
translate es class_event_obvious_interruption_49701497:

    # "A few people nearby snicker. The student looks confused, then offended."
    "Algumas pessoas perto riem. O aluno parece confuso, despues ofendido."

# game/scripts/Actions/actions.rpy:1337
translate es class_event_obvious_interruption_f37e0e9d:

    # "She covers her mouth, trying not to laugh."
    "Ella cobre a boca, tentando no rir."

# game/scripts/Actions/actions.rpy:1346
translate es class_event_obvious_interruption_294326dc:

    # "She presses her lips together, fighting a grin."
    "Ella aperta os lábios, lutando contra un sorriso."

# game/scripts/Actions/actions.rpy:1359
translate es do_workout_b3520a47:

    # "The gym is closed at this hour."
    "A gimnasio esta fechada nesse horário."

# game/scripts/Actions/actions.rpy:1363
translate es do_workout_eec614b8:

    # "It's getting a bit late to work out, maybe it's better to wait for the next time slot."
    "Esta ficando un pouco tarde para malhar, tal vez seja melhor esperar o próximo horário."

# game/scripts/Actions/actions.rpy:1367
translate es do_workout_011cb5d8:

    # "[_workout_line]"
    "[_workout_line]"

# game/scripts/Actions/actions.rpy:1372
translate es do_workout_58eebc9f:

    # "All that hard work is paying off. You feel stronger... like you could last longer. {b}Max Energy up!{/b} (Max Energy: [Player.energy_max]/5)"
    "Todo aquele esforço esta valendo a pena. Tu se sente pero forte... como se pudesse aguentar mais. {b}Energia Máxima aumentou!{/b} (Energia Máxima: [Player.energy_max]/5)"

# game/scripts/Actions/actions.rpy:1425
translate es do_wait_30bbed72:

    # "You spend some time just waiting around."
    "Tu passa un tempo só esperando por aí."

# game/scripts/Actions/actions.rpy:1482
translate es gym_event_arm_suggestion_74547e2f:

    # "She grabs a pair of dumbbells and follows your instructions."
    "Ella pega un par de halteres y segue suas instruções."

# game/scripts/Actions/actions.rpy:1489
translate es gym_event_arm_suggestion_c62d8983:

    # "You demonstrate the movement. She watches carefully and copies you."
    "Tu demonstra o movimento. Ella observa atentamente y te copia."

# game/scripts/Actions/actions.rpy:1496
translate es gym_event_arm_suggestion_451e1fc6:

    # "She gives you a skeptical look."
    "Ella te mira con ceticismo."

# game/scripts/Actions/actions.rpy:1502
translate es gym_event_arm_suggestion_793ef35d:

    # "She looks at you, unimpressed."
    "Ella te olha, nada impressionada."

# game/scripts/Actions/actions.rpy:1514
translate es gym_event_bench_press_ca52f7f0:

    # "You head over to the bench press. She's nearby, stretching between sets."
    "Tu va al supino. Ella esta perto, alongando entre as séries."

# game/scripts/Actions/actions.rpy:1515
translate es gym_event_bench_press_38ddc466:

    # "You load the bar and notice her glancing over."
    "Tu carrega a barra y percebe ella olhando."

# game/scripts/Actions/actions.rpy:1536
translate es gym_event_bench_press_8c3c5a99:

    # "You unrack the bar and immediately feel the weight crushing down on you."
    "Tu tira a barra do suporte y imediatamente sente o peso te esmagando."

# game/scripts/Actions/actions.rpy:1537
translate es gym_event_bench_press_34146543:

    # "Your arms tremble. The bar starts sinking toward your chest."
    "Seus braços tremem. A barra começa a descer al tu pecho."

# game/scripts/Actions/actions.rpy:1539
translate es gym_event_bench_press_c706c916:

    # "She rushes over and helps you rerack the bar. You sit up, gasping."
    "Ella corre y te ajuda a colocar a barra de vuelta. Tu senta, ofegante."

# game/scripts/Actions/actions.rpy:1541
translate es gym_event_bench_press_78707016:

    # "She looks more annoyed than worried. Trying to show off clearly backfired."
    "Parece mas molesta que preocupada. Tratar de lucirte claramente te salio mal."

# game/scripts/Actions/actions.rpy:1546
translate es gym_event_bench_press_4f736bde:

    # "You push through the set with visible effort. Your muscles burn, but you keep solid form."
    "Tu completa a série con esforço visível. Seus músculos queimam, pero tu mantém a forma."

# game/scripts/Actions/actions.rpy:1547
translate es gym_event_bench_press_6ab28b98:

    # "You rack the bar and sit up, breathing hard."
    "Tu coloca a barra de vuelta y senta, respirando pesado."

# game/scripts/Actions/actions.rpy:1549
translate es gym_event_bench_press_681eb443:

    # "She watched the whole set. There's a hint of admiration in her eyes."
    "Ella assistiu a série inteira. Há un toque de admiração nos ojos de ella."

# game/scripts/Actions/actions.rpy:1555
translate es gym_event_bench_press_de672c6f:

    # "You breeze through the set without breaking a sweat."
    "Tu completa a série sin nem suar."

# game/scripts/Actions/actions.rpy:1556
translate es gym_event_bench_press_c5b0b925:

    # "She glances over briefly but doesn't seem particularly impressed."
    "Ella mira de relance pero no parece particularmente impressionada."

# game/scripts/Actions/actions.rpy:1572
translate es gym_event_leg_swap_e1270164:

    # "You're in the middle of using [_exercise] when she walks over."
    "Tu esta no meio de usar [_exercise] cuando ella se aproxima."

# game/scripts/Actions/actions.rpy:1580
translate es gym_event_leg_swap_ed5ad01a:

    # "She adjusts the weight and does her set. You wait, watching her form."
    "Ella ajusta o peso y hace a série. Tu espera, observando a forma de ella."

# game/scripts/Actions/actions.rpy:1581
translate es gym_event_leg_swap_32de4590:

    # "When she's done, she steps aside with a smile."
    "Cuando termina, ella sai de lado con un sorriso."

# game/scripts/Actions/actions.rpy:1588
translate es gym_event_leg_swap_246c3f54:

    # "She crosses her arms, clearly not thrilled."
    "Ella cruza os braços, claramente no empolgada."

# game/scripts/Actions/actions.rpy:1590
translate es gym_event_leg_swap_e6f2fc28:

    # "She walks off to do something else. You finish your sets in peace."
    "Ella va hacer outra coisa. Tu termina suas séries em paz."

# game/scripts/Actions/actions.rpy:1598
translate es gym_event_leg_swap_69a730d3:

    # "She gives you a flat look and walks away to use something else."
    "Ella te mira sin expressão y va usar outra coisa."

# game/scripts/Actions/actions.rpy:1599
translate es gym_event_leg_swap_6b052961:

    # "Note to self: don't mansplain at the gym."
    "Nota mental: no fique dando lição na gimnasio."

# game/scripts/Actions/actions.rpy:1610
translate es gym_event_squat_form_31df5b10:

    # "She's at the squat rack, mid-set, when she pauses and turns to you."
    "Ella esta no rack de agachamento, no meio da série, cuando para y se vira para tu."

# game/scripts/Actions/actions.rpy:1616
translate es gym_event_squat_form_56494fd0:

    # "She does another rep, focusing on your instructions."
    "Ella hace pero una repetição, focando nas suas instruções."

# game/scripts/Actions/actions.rpy:1620
translate es gym_event_squat_form_6e925320:

    # "She finishes her set with a grateful smile."
    "Ella termina a série con un sorriso agradecido."

# game/scripts/Actions/actions.rpy:1625
translate es gym_event_squat_form_995baf03:

    # "You position yourself behind her for a... better angle."
    "Tu se posiciona atrás de ella para um... ângulo melhor."

# game/scripts/Actions/actions.rpy:1626
translate es gym_event_squat_form_6115a92c:

    # "She does a few reps. You're definitely not looking at her knees."
    "Ella hace algumas repetições. Tu definitivamente no esta olhando pros joelhos de ella."

# game/scripts/Actions/actions.rpy:1633
translate es gym_event_squat_form_eaa7b858:

    # "She catches your gaze in the mirror and stops mid-rep."
    "Ella percebe tu olhar no espejo y para no meio da repetição."

# game/scripts/Actions/actions.rpy:1641
translate es gym_event_squat_form_39754306:

    # "She catches your gaze in the mirror... and smirks."
    "Ella percebe tu olhar no espejo... y dá un sorrisinho."

# game/scripts/Actions/actions.rpy:1649
translate es gym_event_squat_form_3934ad8d:

    # "She doesn't seem to notice where you're actually looking."
    "Ella no parece perceber para donde tu realmente esta olhando."

# game/scripts/Actions/actions.rpy:1663
translate es gym_event_stretching_help_b54abd24:

    # "After her workout, she's on the mat trying to stretch her legs."
    "Despues do treino, ella esta no tapete tentando alongar as pernas."

# game/scripts/Actions/actions.rpy:1665
translate es gym_event_stretching_help_4561d1a3:

    # "She looks at you."
    "Ella mira para tu."

# game/scripts/Actions/actions.rpy:1670
translate es gym_event_stretching_help_f1dc4d3a:

    # "You kneel behind her and gently press on her upper back as she reaches forward."
    "Tu se ajoelha atrás de ella y pressiona gentilmente a parte de cima das espalda enquanto ella se inclina hacia adelante."

# game/scripts/Actions/actions.rpy:1672
translate es gym_event_stretching_help_5d88fab4:

    # "You push a bit further. She groans as the stretch deepens."
    "Tu pressiona un pouco mais. Ella geme enquanto o alongamento se aprofunda."

# game/scripts/Actions/actions.rpy:1674
translate es gym_event_stretching_help_9d2e4600:

    # "She sits back up, looking relieved."
    "Ella se senta de vuelta, parecendo aliviada."

# game/scripts/Actions/actions.rpy:1680
translate es gym_event_stretching_help_86bd6df4:

    # "You move in close, pressing your hands on her lower back."
    "Tu se aproxima, pressionando as manos na lombar de ella."

# game/scripts/Actions/actions.rpy:1681
translate es gym_event_stretching_help_ec9b6bae:

    # "Your body is practically against hers as you push her forward."
    "Tu cuerpo esta praticamente colado no de ella enquanto tu a empurra hacia adelante."

# game/scripts/Actions/actions.rpy:1690
translate es gym_event_stretching_help_4ee59d83:

    # "She doesn't pull away. If anything, she leans back into you slightly."
    "Ella no se afasta. En realidad, ella se encosta levemente em tu."

# game/scripts/Actions/actions.rpy:1696
translate es gym_event_stretching_help_b64c2dfc:

    # "She tenses up immediately."
    "Ella se tensa imediatamente."

# game/scripts/Actions/actions.rpy:1699
translate es gym_event_stretching_help_5cf63ee0:

    # "You step back awkwardly."
    "Tu se afasta sin graça."

# game/scripts/Actions/actions.rpy:1707
translate es gym_event_stretching_help_04a107f7:

    # "She goes back to stretching alone. A missed opportunity, but no harm done."
    "Ella volta a alongar sola. Uma oportunidade perdida, pero sin danos."

# game/scripts/Actions/actions.rpy:1715
translate es gym_event_squat_watch_52287321:

    # "She's at the squat rack doing a heavy set. You can see her legs trembling on the last rep."
    "Ella esta no rack de agachamento fazendo una série pesada. Dá para ver as pernas de ella tremendo na última repetição."

# game/scripts/Actions/actions.rpy:1716
translate es gym_event_squat_watch_c1d0ad8e:

    # "She racks the bar and catches her breath, stretching between sets."
    "Ella coloca a barra de vuelta y recupera o fôlego, alongando entre as séries."

# game/scripts/Actions/actions.rpy:1720
translate es gym_event_squat_watch_7c820a9b:

    # "You glance away and continue your own workout."
    "Tu desvia o olhar y continua tu treino."

# game/scripts/Actions/actions.rpy:1723
translate es gym_event_squat_watch_5e549658:

    # "You walk up behind her and give her a firm slap on the ass."
    "Tu va por trás de ella y dá un tapa firme na culo."

# game/scripts/Actions/actions.rpy:1734
translate es gym_event_squat_watch_a04894a4:

    # "She shoves your shoulder, but she's smirking."
    "Ella empurra tu ombro, pero esta con un sorrisinho."

# game/scripts/Actions/actions.rpy:1746
translate es gym_event_squat_watch_a348e0cc:

    # "Her eyes are watering. She covers herself with both hands."
    "Os ojos de ella estan lacrimejando. Ella se cobre con as duas manos."

# game/scripts/Actions/actions.rpy:1752
translate es gym_event_squat_watch_f3cf8fa0:

    # "She turns away, but you catch a faint smile."
    "Ella se vira, pero tu percebe un sorriso discreto."

# game/scripts/Actions/actions.rpy:1759
translate es gym_event_squat_watch_e79f5644:

    # "Her face turns bright red. She practically runs to the locker room."
    "O cara de ella fica vermelho. Ella praticamente corre al vestiário."

# game/scripts/Actions/actions.rpy:1766
translate es gym_event_squat_watch_dfbb50e8:

    # "She swats your hand away, but can't quite hide the flush on her cheeks."
    "Ella afasta tu mão, pero no consegue esconder o rubor nas bochechas."

# game/scripts/Actions/actions.rpy:1772
translate es gym_event_squat_watch_bd5d4c03:

    # "A few people nearby glance over. She's furious."
    "Algumas pessoas perto olham. Ella esta furiosa."

# game/scripts/Actions/actions.rpy:1781
translate es gym_event_squat_watch_6213de4e:

    # "She fidgets with the hem of her shirt, clearly flustered."
    "Ella mexe na barra da camiseta, claramente desconcertada."

# game/scripts/Actions/actions.rpy:1785
translate es gym_event_squat_watch_b233b337:

    # "She cracks a small smile despite the tough front."
    "Ella deja escapar un sorriso apesar da pose de durona."

# game/scripts/Actions/actions.rpy:1789
translate es gym_event_squat_watch_62180bd2:

    # "She winks and goes back to her set."
    "Ella pisca y volta para série."

# game/scripts/Actions/actions.rpy:1793
translate es gym_event_squat_watch_534fc62a:

    # "She glances around nervously."
    "Ella mira ao redor nervosamente."

# game/scripts/Actions/actions.rpy:1797
translate es gym_event_squat_watch_8a0b18ca:

    # "She adjusts her ponytail, trying to act casual."
    "Ella ajusta o rabo de cavalo, tentando parecer casual."

# game/scripts/Actions/actions.rpy:1815
translate es gym_event_exercise_help_f4486df6:

    # "[_ex_desc]"
    "[_ex_desc]"

# game/scripts/Actions/actions.rpy:1829
translate es gym_event_exercise_help_4f3759c8:

    # "She quietly lowers the weight, visibly deflated."
    "Ella abaixa o peso silenciosamente, visivelmente desanimada."

# game/scripts/Actions/actions.rpy:1833
translate es gym_event_exercise_help_8c6f94bd:

    # "She loads even more weight on the bar out of spite."
    "Ella coloca todavia pero peso na barra por pirraça."

# game/scripts/Actions/actions.rpy:1836
translate es gym_event_exercise_help_dc88be9b:

    # "She lowers the weight, looking disappointed."
    "Ella abaixa o peso, parecendo decepcionada."

# game/scripts/Actions/actions.rpy:1842
translate es gym_event_exercise_help_f8fa9e9b:

    # "She starts the lift. It's clearly too heavy, and she struggles from the first rep."
    "Ella começa o levantamento. Esta claramente pesado demais, y ella já luta desde a primeira repetição."

# game/scripts/Actions/actions.rpy:1843
translate es gym_event_exercise_help_c1375fd9:

    # "You stand there with your arms crossed, watching."
    "Tu fica ali de braços cruzados, observando."

# game/scripts/Actions/actions.rpy:1846
translate es gym_event_exercise_help_a026ae23:

    # "You wait a few more seconds before stepping in. She sets the weight down, trembling."
    "Tu espera pero alguns segundos antes de intervir. Ella coloca o peso no chão, tremendo."

# game/scripts/Actions/actions.rpy:1849
translate es gym_event_exercise_help_396262a9:

    # "Her eyes are glassy. She wipes her face with her sleeve."
    "Sus ojos están vidriosos. Se limpia la cara con la manga."

# game/scripts/Actions/actions.rpy:1854
translate es gym_event_exercise_help_cb79474e:

    # "She grinds through the rep by sheer willpower, face twisted with effort."
    "Ella completa a repetição por pura força de vontade, cara contorcido de esforço."

# game/scripts/Actions/actions.rpy:1855
translate es gym_event_exercise_help_6e893708:

    # "She racks the weight and turns to you, breathing hard."
    "Ella coloca o peso de vuelta y se vira para tu, respirando pesado."

# game/scripts/Actions/actions.rpy:1858
translate es gym_event_exercise_help_f4291ea3:

    # "She's furious. But there's a spark of pride in her eyes."
    "Ella esta furiosa. Pero tem una faísca de orgulho nos ojos de ella."

# game/scripts/Actions/actions.rpy:1863
translate es gym_event_exercise_help_c42fef95:

    # "You let her fight it for a few more seconds before finally stepping in."
    "Tu a deja lutar por pero alguns segundos antes de finalmente intervir."

# game/scripts/Actions/actions.rpy:1864
translate es gym_event_exercise_help_6da3e22b:

    # "She racks the weight, arms shaking, and stares at you."
    "Ella coloca o peso de vuelta, braços tremendo, y te encara."

# game/scripts/Actions/actions.rpy:1867
translate es gym_event_exercise_help_39583354:

    # "She's pissed... but she pushed through something she thought she couldn't."
    "Ella esta puta... pero superou algo que achava que no conseguia."

# game/scripts/Actions/actions.rpy:1873
translate es gym_event_exercise_help_62c3441e:

    # "You position yourself correctly and guide her through the set."
    "Tu se posiciona corretamente y a guia durante a série."

# game/scripts/Actions/actions.rpy:1874
translate es gym_event_exercise_help_68e596a4:

    # "She pushes through three solid reps with your support."
    "Ella completa três repetições firmes con tu apoio."

# game/scripts/Actions/actions.rpy:1878
translate es gym_event_exercise_help_05f47a6b:

    # "She looks like she might hug you, but catches herself at the last second."
    "Ella parece que va te abraçar, pero se contém no último segundo."

# game/scripts/Actions/actions.rpy:1884
translate es gym_event_exercise_help_80444c2f:

    # "She bumps your fist without asking."
    "Ella bate no tu punho sin perguntar."

# game/scripts/Actions/actions.rpy:1901
translate es gym_event_squat_behind_7acff993:

    # "She's at the squat rack with her back to you, doing slow, controlled reps."
    "Ella esta no rack de agachamento de espalda para tu, fazendo repetições lentas y controladas."

# game/scripts/Actions/actions.rpy:1902
translate es gym_event_squat_behind_8b2860e6:

    # "The view from behind is... hard to ignore. There's a large mirror right in front of her."
    "A vista por trás é... difícil de ignorar. Tem un espejo grande bem na frente de ella."

# game/scripts/Actions/actions.rpy:1906
translate es gym_event_squat_behind_4ae72387:

    # "You look away and get back to your workout."
    "Tu desvia o olhar y volta al tu treino."

# game/scripts/Actions/actions.rpy:1909
translate es gym_event_squat_behind_b01fb97c:

    # "You pull out your phone and discreetly angle it toward her."
    "Tu pega o celular y discretamente aponta para ela."

# game/scripts/Actions/actions.rpy:1910
translate es gym_event_squat_behind_28779596:

    # "You tap the screen... and at that exact moment, her eyes meet yours in the mirror."
    "Tu toca na tela... y nesse exato momento, os ojos de ella encontram os seus no espejo."

# game/scripts/Actions/actions.rpy:1916
translate es gym_event_squat_behind_162e7114:

    # "She poses slightly, adjusting her stance."
    "Ella posa levemente, ajustando a postura."

# game/scripts/Actions/actions.rpy:1924
translate es gym_event_squat_behind_c29ec7a8:

    # "She storms over and reaches for your phone."
    "Ella vem furiosa y tenta pegar tu celular."

# game/scripts/Actions/actions.rpy:1926
translate es gym_event_squat_behind_a60c3b4d:

    # "You pretend to delete it. She watches, shaking with anger."
    "Tu finge apagar. Ella observa, tremendo de raiva."

# game/scripts/Actions/actions.rpy:1933
translate es gym_event_squat_behind_4fff1d31:

    # "She turns back to the mirror with a faint smirk."
    "Ella se vira de vuelta al espejo con un sorrisinho discreto."

# game/scripts/Actions/actions.rpy:1941
translate es gym_event_squat_behind_3529fe64:

    # "She looks around frantically, terrified someone noticed."
    "Ella mira ao redor freneticamente, con medo de alguien ter visto."

# game/scripts/Actions/actions.rpy:1949
translate es gym_event_squat_behind_3a4d094e:

    # "She hugs herself, looking small."
    "Ella se abraça, parecendo pequena."

# game/scripts/Actions/actions.rpy:1957
translate es gym_event_squat_behind_29a8bb19:

    # "You pocket it. She cracks her knuckles but doesn't follow through."
    "Tu guarda no bolso. Ella estala os dedos, pero no va até o fim."

# game/scripts/Actions/actions.rpy:1967
translate es gym_event_squat_behind_97d2bdb0:

    # "She looks away, too intimidated to press the issue."
    "Ella desvia o olhar, intimidada demais para insistir."

# game/scripts/Actions/actions.rpy:1969
translate es gym_event_squat_behind_534e48bb:

    # "She doesn't believe you. But she doesn't push it."
    "Ella no acredita em tu. Pero no insiste."

# game/scripts/Actions/actions.rpy:1975
translate es gym_event_squat_behind_48a0bcc1:

    # "You pocket your phone. She glares, but eventually goes back to her set."
    "Tu guarda o celular. Ella te fuzila con o olhar, pero eventualmente volta para série."

# game/scripts/Actions/actions.rpy:1980
translate es gym_event_squat_behind_3b1a9ec1:

    # "You catch her eye in the mirror."
    "Tu cruza o olhar de ella no espejo."

# game/scripts/Actions/actions.rpy:1986
translate es gym_event_squat_behind_85c136c7:

    # "She finishes her set, face burning red."
    "Ella termina a série, cara vermelho."

# game/scripts/Actions/actions.rpy:1993
translate es gym_event_squat_behind_48fff940:

    # "She racks the bar and flexes."
    "Ella coloca a barra de vuelta y hace pose."

# game/scripts/Actions/actions.rpy:2000
translate es gym_event_squat_behind_9bfd0b5f:

    # "She does one more slow rep, making sure you're watching."
    "Ella hace pero una repetição lenta, garantindo que tu esta olhando."

# game/scripts/Actions/actions.rpy:2007
translate es gym_event_squat_behind_e15e8737:

    # "She racks the bar and moves closer, whispering."
    "Ella coloca a barra de vuelta y se aproxima, sussurrando."

# game/scripts/Actions/actions.rpy:2017
translate es gym_event_squat_behind_d526137a:

    # "She racks the bar and stretches, hiding a smile."
