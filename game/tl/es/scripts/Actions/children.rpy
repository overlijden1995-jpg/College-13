    # game/scripts/Actions/children.rpy:138
    old "Newborn"
    new "Recién nacido"

    # game/scripts/Actions/children.rpy:138
    old "Infant"
    new "Lactante"

    # game/scripts/Actions/children.rpy:138
    old "Baby"
    new "Bebé"

    # game/scripts/Actions/children.rpy:138
    old "Toddler"
    new "Infante"

