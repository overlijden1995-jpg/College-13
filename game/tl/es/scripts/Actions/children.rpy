    # game/scripts/Actions/children.rpy:168
    old "her husband"
    new "su esposo"

    # game/scripts/Actions/children.rpy:711
    old "She tagged her husband in it. The comments are full of congratulations for the happy couple."
    new "Etiquetó a su esposo en la publicación. Los comentarios están llenos de felicitaciones para la feliz pareja."

