    # "You get a series of messages. [_birth_girl.Name] is having another baby."
    "Recibes una serie de mensajes. [_birth_girl.Name] va a tener otro bebé."

# game/scripts/Events/pregnancy_discovery.rpy:2464
translate es 1a570ae0:

    # "You get a series of messages. [_birth_girl.Name] is having the baby."
    "Recibes una serie de mensajes. [_birth_girl.Name] va a tener al bebé."

# game/scripts/Events/pregnancy_discovery.rpy:2465
translate es 0957a7b1:

    # "She'll be gone for about a week."
    "Estará fuera más o menos una semana."

