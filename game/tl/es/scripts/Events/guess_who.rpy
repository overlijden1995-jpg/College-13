translate es guess_who_event_85bccba0:

    # "The hands feel warm and soft against your face. Who could it be?"
    "Las manos se sienten cálidas y suaves contra tu cara. ¿Quién será?"

# game/scripts/Events/guess_who.rpy:142
translate es guess_who_event_4b557312:

    # "The hands pull away and you turn around."
    "Las manos se apartan y te das la vuelta."

# game/scripts/Events/guess_who.rpy:150
translate es guess_who_event_3ee9ae8f:

    # "A man in a full Santa outfit, complete with a fake beard and a red hat."
    "Un hombre con un disfraz completo de Santa Claus, con barba falsa y gorro rojo."

# game/scripts/Events/guess_who.rpy:151
translate es guess_who_event_d1969fbf:

    # "\"Ho ho ho! You got me! Merry Christmas!\""
    "\"¡Jo jo jo! ¡Me descubriste! ¡Feliz Navidad!\""

# game/scripts/Events/guess_who.rpy:152
translate es guess_who_event_96bcbb00:

    # "He pats you on the shoulder and walks away humming a carol."
    "Te da una palmadita en el hombro y se va tarareando un villancico."

# game/scripts/Events/guess_who.rpy:153
translate es guess_who_event_b3ece2df:

    # "...It's not even December."
    "...Ni siquiera es diciembre."

# game/scripts/Events/guess_who.rpy:176
translate es guess_who_event_ec09f0ef:

    # "She smiles at you, pleased that you recognized her."
    "Ella te sonríe, contenta de que la reconocieras."

# game/scripts/Events/guess_who.rpy:185
translate es guess_who_event_95f69c33:

    # "A man in a full Santa outfit stares at you, looking offended."
    "Un hombre con un disfraz completo de Santa Claus te mira, viéndose ofendido."

# game/scripts/Events/guess_who.rpy:186
translate es guess_who_event_934cb22c:

    # "\"I'm SANTA CLAUS! How do you not recognize these hands?!\""
    "\"¡Soy SANTA CLAUS! ¿¡Cómo no reconoces estas manos!?\""

# game/scripts/Events/guess_who.rpy:187
translate es guess_who_event_3029e579:

    # "He storms off, muttering about ungrateful youth."
    "Se va furioso, murmurando sobre la juventud ingrata."

# game/scripts/Events/guess_who.rpy:211
translate es guess_who_event_e8af565f:

    # "She looks disappointed."
    "Se ve decepcionada."

