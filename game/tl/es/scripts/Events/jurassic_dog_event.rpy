translate es cjohnson_shady_intro_ffaf4b2e:

    # CJohnsonChar "NO! HELP NO NEED! Oops, is you little buddy. Of course, help me here."
    CJohnsonChar "¡NO! ¡AYUDA NO NECESITAR! Ups, ser tú amiguito. Claro, ayudar aquí."

# game/scripts/Events/jurassic_dog_event.rpy:301
translate es cjohnson_shady_intro_16895ff8:

    # "You hear a crack in your back as you try to lift the boxes."
    "Escuchas un crujido en tu espalda al intentar levantar las cajas."

# game/scripts/Events/jurassic_dog_event.rpy:303
translate es cjohnson_shady_intro_8833ebc9:

    # PlayerChar "Damn, what do you have in here? Rocks?"
    PlayerChar "Carajo, ¿qué tienes aquí? ¿Piedras?"

# game/scripts/Events/jurassic_dog_event.rpy:305
translate es cjohnson_shady_intro_c95de9ff:

    # CJohnsonChar "Yes, there have rock collection mine. But take other ones, they lighter. Hot dog not giving so much money, me need side business. Got rare things from my friend who wear dress at other college."
    CJohnsonChar "Sí, ahí tener colección de piedras mía. Pero tomar las otras, ser más livianas. Perro caliente no dar tanto dinero, yo necesitar negocio extra. Conseguir cosas raras de amigo mío que usar vestido en otra universidad."

# game/scripts/Events/jurassic_dog_event.rpy:307
translate es cjohnson_shady_intro_a2844de6:

    # PlayerChar "Rare? What kind?"
    PlayerChar "¿Raras? ¿De qué tipo?"

# game/scripts/Events/jurassic_dog_event.rpy:309
translate es cjohnson_shady_intro_a47a5c24:

    # CJohnsonChar "Look little buddy, world is hard, some decisions made on impulse charge child support. If want to make change, talk to me."
    CJohnsonChar "Mira amiguito, mundo ser difícil, algunas decisiones hechas por impulso cobrar pensión. Si querer cambiar, hablar conmigo."

# game/scripts/Events/jurassic_dog_event.rpy:311
translate es cjohnson_shady_intro_2bf60bc2:

    # PlayerChar "I didn't understand a word of that."
    PlayerChar "No entendí ni una palabra de eso."

# game/scripts/Events/jurassic_dog_event.rpy:313
translate es cjohnson_shady_intro_39b4c223:

    # CJohnsonChar "5 thousand green papers and kaboom, no more kid, nobody remember nothing."
    CJohnsonChar "5 mil papeles verdes y kaboom, no más niño, nadie recordar nada."

# game/scripts/Events/jurassic_dog_event.rpy:315
translate es cjohnson_shady_intro_40648e2a:

    # PlayerChar "What?!"
    PlayerChar "¡¿Qué?!"

# game/scripts/Events/jurassic_dog_event.rpy:317
translate es cjohnson_shady_intro_c10364b0:

    # CJohnsonChar "Me have other suspicious things soon. Trust me. You understand when older."
    CJohnsonChar "Yo tener otras cosas sospechosas pronto. Confiar en mí. Tú entender cuando ser mayor."

# game/scripts/Events/jurassic_dog_event.rpy:319
translate es cjohnson_shady_intro_19240551:

    # "You decide to leave CJ alone. Apparently he now has items that change decisions that should be permanent in the real world."
    "Decides dejar a CJ en paz. Aparentemente ahora tiene artículos que cambian decisiones que deberían ser permanentes en el mundo real."

# game/scripts/Events/jurassic_dog_event.rpy:321
translate es cjohnson_shady_intro_97fe1529:

    # "Also saves you from starting a new save file. Very useful."
    "También te ahorra empezar un archivo de guardado nuevo. Muy útil."

# game/scripts/Events/jurassic_dog_event.rpy:331
translate es cjohnson_harem_hint_faeb59ff:

    # CJohnsonChar "Hey little buddy. Here, take hot dog. Me find out you got girl. Many congratulation."
    CJohnsonChar "Hey amiguito. Toma, agarrar hot dog. Yo descubrir que tú tener chica. Muchas felicitaciones."

# game/scripts/Events/jurassic_dog_event.rpy:333
translate es cjohnson_harem_hint_04943c27:

    # CJohnsonChar "But you know, life too short for just one girl. If want another, me think you can. Talk to girlfriend, me sure they would like have someone like you!"
    CJohnsonChar "Pero tú saber, vida muy corta para solo una chica. Si querer otra, yo creer que tú poder. Hablar con novia, yo estar seguro que ellas gustar tener alguien como tú."

# game/scripts/Events/jurassic_dog_event.rpy:340
translate es cjohnson_harem_hint_bd0b3e1c:

    # CJohnsonChar "Heh, me understand everything about women. Young people today weak, call it open relationship. But only for them, you smart and never share."
    CJohnsonChar "Heh, yo entender todo sobre mujeres. Jóvenes de hoy débiles, llamar relación abierta. Pero solo para ellos, tú listo y nunca compartir."

# game/scripts/Events/jurassic_dog_event.rpy:342
translate es cjohnson_harem_hint_eb932be5:

    # CJohnsonChar "Talk to girlfriend to see if she okay with it, make things easier. Or go straight and ask other girl to be girlfriend, they sort it out."
    CJohnsonChar "Hablar con novia para ver si ella estar de acuerdo, hacer cosas más fácil. O ir directo y pedir a otra chica ser novia, ellas resolver."

# game/scripts/Events/jurassic_dog_event.rpy:344
translate es cjohnson_harem_hint_a515ad63:

    # CJohnsonChar "You too busy with hot dog to worry about this."
    CJohnsonChar "Tú muy ocupado con hot dog para preocupar por esto."

# game/scripts/Events/jurassic_dog_event.rpy:363
translate es cj_suspicious_items_5f972fd3:

    # CJohnsonChar "Ah, little buddy want the special menu. What you need?"
    CJohnsonChar "Ah, amiguito querer menú especial. ¿Qué necesitar?"

# game/scripts/Events/jurassic_dog_event.rpy:395
translate es cj_suspicious_items_4fc77cea:

    # CJohnsonChar "Come back when you need something, little buddy."
    CJohnsonChar "Volver cuando necesitar algo, amiguito."

# game/scripts/Events/jurassic_dog_event.rpy:403
translate es cj_instant_preg_test_fee8de7d:

    # CJohnsonChar "Yes, friend! At the level of tiny cells. If you have this, you know right away if girl got pregnant!"
    CJohnsonChar "¡Sí, amigo! A nivel de célula chiquitita. ¡Si tú tener esto, saber al instante si chica quedar embarazada!"

# game/scripts/Events/jurassic_dog_event.rpy:405
translate es cj_instant_preg_test_36520f51:

    # CJohnsonChar "100 green papers. You want?"
    CJohnsonChar "100 papeles verdes. ¿Tú querer?"

