    # PlayerChar "I don't have enough money right now."
    PlayerChar "No tengo suficiente dinero ahora."

# game/scripts/Events/jurassic_dog_event.rpy:409
translate es cj_instant_preg_test_af4bd65d:

    # CJohnsonChar "Okay. You come back when pocket is full, little buddy."
    CJohnsonChar "Okay. Tú volver cuando bolsillo estar lleno, amiguito."

# game/scripts/Events/jurassic_dog_event.rpy:416
translate es cj_instant_preg_test_69e81a6d:

    # CJohnsonChar "Done. Now when you do the thing... if baby start, you see special animation. Science is beautiful, little buddy."
    CJohnsonChar "Listo. Ahora cuando tú hacer la cosa... si bebé empezar, tú ver animación especial. Ciencia ser hermosa, amiguito."

# game/scripts/Events/jurassic_dog_event.rpy:419
translate es cj_instant_preg_test_d17c9093:

    # CJohnsonChar "Okay. You come back when curiosity win, little buddy."
    CJohnsonChar "Okay. Tú volver cuando curiosidad ganar, amiguito."

# game/scripts/Events/jurassic_dog_event.rpy:427
translate es cj_baby_eraser_306e9d2a:

    # CJohnsonChar "Ah, you want the baby go-away thing. Which pretty lady need to forget?"
    CJohnsonChar "Ah, tú querer la cosa de bebé desaparecer. ¿Cuál señorita bonita necesitar olvidar?"

# game/scripts/Events/jurassic_dog_event.rpy:442
translate es cj_baby_eraser_671e8dec:

    # CJohnsonChar "Okay, you think about it."
    CJohnsonChar "Okay, tú pensar bien."

# game/scripts/Events/jurassic_dog_event.rpy:452
translate es cj_baby_eraser_b0d64f9f:

    # CJohnsonChar "5 thousand green papers, little buddy. No refund, no receipt, no questions."
    CJohnsonChar "5 mil papeles verdes, amiguito. No devolución, no recibo, no preguntas."

# game/scripts/Events/jurassic_dog_event.rpy:455
translate es cj_baby_eraser_dabb520a:

    # PlayerChar "I don't have that kind of money right now."
    PlayerChar "No tengo esa cantidad de dinero ahora."

# game/scripts/Events/jurassic_dog_event.rpy:456
translate es cj_baby_eraser_8e911211:

    # CJohnsonChar "You come back when pocket is full, little buddy."
    CJohnsonChar "Tú volver cuando bolsillo estar lleno, amiguito."

