translate es cj_baby_eraser_14251d15:

    # CJohnsonChar "You come back when you ready."
    CJohnsonChar "Tú volver cuando estar listo."

# game/scripts/Events/jurassic_dog_event.rpy:468
translate es cj_baby_eraser_68709e93:

    # CJohnsonChar "Here, take this."
    CJohnsonChar "Toma, agarrar esto."

# game/scripts/Events/jurassic_dog_event.rpy:470
translate es cj_baby_eraser_9ada88db:

    # "CJ hands you... a coat hanger tied to a watch with twine."
    "CJ te entrega... un gancho de ropa atado a un reloj con cordel."

# game/scripts/Events/jurassic_dog_event.rpy:472
translate es cj_baby_eraser_a4df0074:

    # PlayerChar "What the hell is this?"
    PlayerChar "¿Qué demonios es esto?"

# game/scripts/Events/jurassic_dog_event.rpy:474
translate es cj_baby_eraser_ba84d522:

    # CJohnsonChar "Is Baby Eraser. Very advanced technology. You press button on watch and point at direction of pretty lady. Poof. She no remember baby, no remember nothing. Like time travel but cheap."
    CJohnsonChar "Ser Borrador de Bebé. Tecnología muy avanzada. Tú presionar botón de reloj y apuntar en dirección de señorita bonita. Puf. Ella no recordar bebé, no recordar nada. Como viaje en el tiempo pero barato."

# game/scripts/Events/jurassic_dog_event.rpy:476
translate es cj_baby_eraser_c6390514:

    # PlayerChar "This can't possibly work."
    PlayerChar "Esto no puede funcionar."

# game/scripts/Events/jurassic_dog_event.rpy:478
translate es cj_baby_eraser_a73fa9fa:

    # CJohnsonChar "5 thousand green papers say it work. Trust CJ."
    CJohnsonChar "5 mil papeles verdes decir que funcionar. Confiar en CJ."

# game/scripts/Events/jurassic_dog_event.rpy:480
translate es cj_baby_eraser_bd8448c4:

    # "You press the button on the watch. The coat hanger vibrates slightly."
    "Presionas el botón del reloj. El gancho de ropa vibra ligeramente."

# game/scripts/Events/jurassic_dog_event.rpy:482
translate es cj_baby_eraser_0bb2bbe8:

    # "Nothing seems to happen."
    "Nada parece suceder."

# game/scripts/Events/jurassic_dog_event.rpy:484
translate es cj_baby_eraser_27cb8257:

    # CJohnsonChar "Is done. She no remember nothing now. Magic of science."
    CJohnsonChar "Estar hecho. Ella no recordar nada ahora. Magia de ciencia."

# game/scripts/Events/jurassic_dog_event.rpy:486
translate es cj_baby_eraser_683f384d:

    # PlayerChar "There's no way that actually..."
    PlayerChar "No hay forma de que en serio..."

# game/scripts/Events/jurassic_dog_event.rpy:488
translate es cj_baby_eraser_de1e0c7c:

    # CJohnsonChar "You go check. CJ never lie. Well, CJ sometimes lie. But not about this."
    CJohnsonChar "Tú ir a verificar. CJ nunca mentir. Bueno, CJ a veces mentir. Pero no sobre esto."

# game/scripts/Events/jurassic_dog_event.rpy:490
translate es cj_baby_eraser_345911bb:

    # "Against all logic, you have a feeling he might be right."
    "Contra toda lógica, tienes el presentimiento de que podría tener razón."

# game/scripts/Events/jurassic_dog_event.rpy:505
translate es cj_girls_tracker_3926a275:

