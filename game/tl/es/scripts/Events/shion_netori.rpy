    # game/scripts/Events/shion_netori.rpy:33
    old "Not a sound. I mean it."
    new "Ni un sonido. Lo digo en serio."

    # game/scripts/Events/shion_netori.rpy:33
    old "Don't. Move. It's your father."
    new "No. Te. Muevas. Es tu padre."

    # game/scripts/Events/shion_netori.rpy:33
    old "I needed some air, honey. I'm just driving around."
    new "Necesitaba aire, cariño. Solo estoy dando una vuelta en el auto."

    # game/scripts/Events/shion_netori.rpy:33
    old "I'm fine. I couldn't sleep, so I went for a drive."
    new "Estoy bien. No podía dormir, así que salí a manejar."

    # game/scripts/Events/shion_netori.rpy:33
    old "Just clearing my head. You know how I get."
    new "Solo despejando la cabeza. Ya sabes cómo me pongo."

    # game/scripts/Events/shion_netori.rpy:33
    old "Nothing's wrong. I just needed to be alone for a while."
    new "No pasa nada. Solo necesitaba estar sola un rato."

    # game/scripts/Events/shion_netori.rpy:33
    old "No, I'm alone. It's just the radio."
    new "No, estoy sola. Es solo la radio."

    # game/scripts/Events/shion_netori.rpy:33
    old "I'm parked. It's quiet here. I'm fine."
    new "Estoy estacionada. Aquí está tranquilo. Estoy bien."

    # game/scripts/Events/shion_netori.rpy:33
    old "I'm... mmh... fine. The road is just... bumpy."
    new "Estoy... mmh... bien. El camino solo está... lleno de baches."

    # game/scripts/Events/shion_netori.rpy:33
    old "Nothing, honey... I'm just... tired."
    new "Nada, cariño... solo estoy... cansada."

    # game/scripts/Events/shion_netori.rpy:33
    old "Ah-! ...No, it's nothing. A pothole. I hit a pothole."
    new "¡Ah-! ...No, no es nada. Un bache. Caí en un bache."

    # game/scripts/Events/shion_netori.rpy:33
    old "Nnh-! ...Sorry. Somebody cut me off."
    new "¡Nnh-! ...Perdón. Alguien se me cerró."

    # game/scripts/Events/shion_netori.rpy:33
    old "I'll be home soon. Go back to sleep."
    new "Llego pronto a casa. Vuelve a dormir."

    # game/scripts/Events/shion_netori.rpy:33
    old "Don't wait up, honey. I won't be long."
    new "No me esperes despierto, cariño. No voy a tardar."

    # game/scripts/Events/shion_netori.rpy:33
    old "I have to go. I'm... driving. Bye."
    new "Tengo que colgar. Estoy... manejando. Adiós."

    # game/scripts/Events/shion_netori.rpy:33
    old "...If he ever finds out, we're both dead. Don't stop."
    new "...Si alguna vez se entera, los dos estamos muertos. No te detengas."

    # game/scripts/Events/shion_netori.rpy:33
    old "He believed it. Of course he did. He always does."
    new "Se lo creyó. Claro que se lo creyó. Siempre se lo cree."

    # game/scripts/Events/shion_netori.rpy:33
    old "Are you insane? He almost heard you! ...God. Again."
    new "¿Estás loco? ¡Casi te oye! ...Dios. Otra vez."

    # game/scripts/Events/shion_netori.rpy:33
    old "You did that on purpose. ...I hate that I liked it."
    new "Lo hiciste a propósito. ...Odio que me haya gustado."

    # game/scripts/Events/shion_netori.rpy:119
    old "Honey? Where are you? It's almost midnight."
    new "¿Cariño? ¿Dónde estás? Ya es casi medianoche."

    # game/scripts/Events/shion_netori.rpy:119
    old "Shion? I woke up and you were gone. Where are you?"
    new "¿Shion? Me desperté y no estabas. ¿Dónde estás?"

    # game/scripts/Events/shion_netori.rpy:119
    old "Okay... I'm sorry about earlier. I shouldn't have said that."
    new "Está bien... Perdón por lo de antes. No debí decir eso."

    # game/scripts/Events/shion_netori.rpy:119
    old "Alright. Drive safe. I hate it when you go out this late."
    new "De acuerdo. Maneja con cuidado. Odio cuando sales tan tarde."

    # game/scripts/Events/shion_netori.rpy:119
    old "Okay. Come home soon. Love you."
    new "Está bien. Vuelve pronto. Te quiero."

    # game/scripts/Events/shion_netori.rpy:119
    old "Alright, alright. Don't stay out too late. Love you."
    new "Bueno, bueno. No te quedes fuera hasta muy tarde. Te quiero."

    # game/scripts/Events/shion_netori.rpy:119
    old "...Shion, you sound strange. Where are you, really? ...Fine. Just come home."
    new "...Shion, te noto rara. ¿Dónde estás de verdad? ...Está bien. Solo vuelve a casa."

    # game/scripts/Events/shion_netori.rpy:160
    old "Her phone buzzes on your nightstand. She looks at the screen and goes still. It's your father."
    new "Su teléfono vibra en tu mesita de noche. Mira la pantalla y se queda inmóvil. Es tu padre."

