translate es strings:

    # game/scripts/Events/stepmom_story.rpy:219
    old "Her fork stops halfway. She removes your foot with one precise push of her heel."
    new "Su tenedor se detiene a medio camino. Aparta tu pie con un empujón preciso del talón."

    # game/scripts/Events/stepmom_story.rpy:219
    old "Your father asked you a question, [Player.Name]. Answer him."
    new "Tu padre te hizo una pregunta, [Player.Name]. Respóndele."

    # game/scripts/Events/stepmom_story.rpy:219
    old "She stares back the way she must stare down a boardroom, one eyebrow up, until you blink first."
    new "Te sostiene la mirada como seguramente se la sostiene a toda una junta directiva, con una ceja arqueada, hasta que tú parpadeas primero."

    # game/scripts/Events/stepmom_story.rpy:219
    old "Drink your wine, boy."
    new "Bebe tu vino, chico."

    # game/scripts/Events/stepmom_story.rpy:219
    old "She goes still for half a second. Then she plants a dripping plate flat against your chest."
    new "Se queda inmóvil medio segundo. Luego te planta un plato chorreando contra el pecho."

    # game/scripts/Events/stepmom_story.rpy:219
    old "Towel. Dry. Two steps back while you do it."
    new "Toalla. Seca. Dos pasos atrás mientras lo haces."

    # game/scripts/Events/stepmom_story.rpy:745
    old "Is it alright if I text you right now?"
    new "¿Está bien si te escribo ahora mismo?"

    # game/scripts/Events/stepmom_story.rpy:745
    old "I keep rereading our chat. Tell me what you're doing."
    new "No dejo de releer nuestro chat. Dime qué estás haciendo."

    # game/scripts/Events/stepmom_story.rpy:745
    old "Thinking about you, actually."
    new "Pensando en ti, la verdad."

    # game/scripts/Events/stepmom_story.rpy:745
    old "...Good."
    new "...Qué bueno."

    # game/scripts/Events/stepmom_story.rpy:745
    old "I read that three times. Keep it."
    new "Lo leí tres veces. Sigue pensando en mí."

    # game/scripts/Events/stepmom_story.rpy:745
    old "Okay. I'll stop bothering you."
    new "Está bien. Dejo de molestarte."

    # game/scripts/Events/stepmom_story.rpy:745
    old "Studying. Keep the phone warm until I'm done."
    new "Estudiando. Mantén el celular calentito hasta que termine."

    # game/scripts/Events/stepmom_story.rpy:745
    old "Yes. ...Tell me when. I'll be here."
    new "Sí. ...Avísame cuándo. Aquí voy a estar."

    # game/scripts/Events/stepmom_story.rpy:745
    old "Alright. Study well."
    new "Está bien. Que estudies bien."

    # game/scripts/Events/stepmom_story.rpy:745
    old "Why, were you about to misbehave?"
    new "¿Por qué, ibas a portarte mal?"

    # game/scripts/Events/stepmom_story.rpy:745
    old "I don't do anything you don't know about. Not anymore."
    new "No hago nada que tú no sepas. Ya no."

    # game/scripts/Events/stepmom_story.rpy:745
    old "...Ask me that in person."
    new "...Pregúntamelo en persona."

    # game/scripts/Events/stepmom_story.rpy:745
    old "No. Goodnight."
    new "No. Buenas noches."

    # game/scripts/Events/stepmom_story.rpy:745
    old "I took one of your shirts. I should have asked first."
    new "Tomé una de tus camisas. Debí pedírtela primero."

    # game/scripts/Events/stepmom_story.rpy:745
    old "May I keep it? Please."
    new "¿Puedo quedármela? Por favor."

    # game/scripts/Events/stepmom_story.rpy:745
    old "Thank you. Really."
    new "Gracias. De verdad."

    # game/scripts/Events/stepmom_story.rpy:745
    old "...As you want. Tomorrow."
    new "...Como tú quieras. Mañana."

    # game/scripts/Events/stepmom_story.rpy:745
    old "Yes. Tomorrow. Sorry for taking it."
    new "Sí. Mañana. Perdón por tomarla."

    # game/scripts/Events/stepmom_story.rpy:745
    old "...You'll have to imagine it. Goodnight."
    new "...Vas a tener que imaginarlo. Buenas noches."

