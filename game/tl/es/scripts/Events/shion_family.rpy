translate es strings:

    # game/scripts/Events/shion_family.rpy:74
    old "Your father's voice comes from the bedroom. He's home."
    new "La voz de tu papá viene del cuarto. Está en casa."

    # game/scripts/Events/shion_family.rpy:74
    old "You hear the shower running. Your father is home."
    new "Oyes la regadera abierta. Tu papá está en casa."

    # game/scripts/Events/shion_family.rpy:74
    old "The apartment is quiet. Your father went out."
    new "El departamento está en silencio. Tu papá salió."

