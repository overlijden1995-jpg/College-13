    new "¿Aquí? ¿En el baño? ...¿Qué tenías en mente?"

    # game/scripts/Locations/Shower.rpy:74
    old "Hey! Occupied!"
    new "¡Oye! ¡Ocupado!"

    # game/scripts/Locations/Shower.rpy:74
    old "It's locked for a reason! Give me a minute!"
    new "¡Está cerrada por algo! ¡Dame un minuto!"

    # game/scripts/Locations/Shower.rpy:74
    old "Knock first! I'm in the shower!"
    new "¡Toca primero! ¡Me estoy bañando!"

