    def _credit_tier_cfg(key):
        for t in _CREDIT_TIERS:
            if t[0] == key:
                return t
        return ("unknown", "Unknown", "#666", 16, None)

# ── Credits screen ─────────────────────────────────────────

init python:
    CREDITS_FEATURED = "dean"               # the tier shown big: its own card, its names at full _CREDIT_TIERS size

    def credits_view():
        """The tiers the credits screen shows, in _CREDIT_SUPPORTERS order, empty ones left out: label, color,
        glow and the names' size (the featured tier at its _CREDIT_TIERS size, the others scaled down to chips)."""
        _rows = []
        for _key, _names in _CREDIT_SUPPORTERS:
            if not _names:
                continue
            _cfg = _credit_tier_cfg(_key)
            _featured = _key == CREDITS_FEATURED
            _rows.append({"label": _cfg[1], "color": _cfg[2], "glow": _cfg[4], "names": _names, "featured": _featured,
                          "size": _cfg[3] if _featured else int(round(16 + (_cfg[3] - 20) * 0.55))})
        return _rows

screen credits_screen():

    tag menu

    use navigation

    use menu_panel():

        vbox:
            spacing 14

            use menu_header(_("Patreon Supporters")):
                imagebutton:
                    idle Transform("images/menus/Patreon.png", zoom=0.075)
                    hover Transform("images/menus/Patreon.png", zoom=0.075, matrixcolor=BrightnessMatrix(0.15))
                    action OpenURL("https://patreon.com/RodProjectsDev")

            text _("Thank you to everyone who supports the project!") style "menu_subtitle"

            viewport:
                style_prefix "menu"                     # its scrollbar = menu_vscrollbar
                yfill True
                mousewheel True
                draggable True
                scrollbars "vertical"

                vbox:
                    xsize MENU_INNER_W - 22
                    spacing 16

                    for _tier in credits_view():
                        use credits_tier(_tier)

screen credits_tier(tier):
    $ _big = tier["featured"]

    frame:
        style ("credits_card_featured" if _big else "menu_card")

        vbox:
            spacing (20 if _big else 14)

            hbox:
                spacing 10
                if _big:
                    add _pk_icon("star", tier["color"]) zoom 1.5 yalign 0.5
                else:
                    add _pk_tint(_PK_DISC, tier["color"]) xysize (12, 12) yalign 0.5
                text tier["label"] style ("credits_tier_featured" if _big else "credits_tier") color tier["color"]

            hbox:
                box_wrap True
                box_wrap_spacing (14 if _big else 10)
                spacing (14 if _big else 10)

                for _name in tier["names"]:
                    frame:
                        style ("credits_chip_featured" if _big else "credits_chip")
                        background _pk_pill(tier["color"], (0.16 if _big else 0.12))
                        # a name is shown as written: substitute False = no translation lookup (a supporter called
                        # "black" came out "preto") and no [ ] interpolation
                        text _name:
                            substitute False
                            style ("credits_name_featured" if _big else "credits_name")
                            size tier["size"]
                            color tier["color"]
                            outlines ([((2 if _big else 1), tier["glow"], 0, 0)] if tier["glow"] else [])

init 1:
    style credits_card_featured is menu_card:
        padding (30, 24, 30, 28)
        background _pk_pill(ROD_ACCENT_WARM, 0.09)

    style credits_tier is text:
        font "fonts/WorkSans-Bold.ttf"
        size 22
        yalign 0.5

    style credits_tier_featured is credits_tier:
        size 32

    style credits_chip is frame:
        padding (16, 7, 16, 8)
        xmargin 0
        ymargin 0

    style credits_chip_featured is credits_chip:
        padding (26, 10, 26, 12)

    style credits_name_featured is text:
        font "fonts/WorkSans-Bold.ttf"

    style credits_name is text:
        font "fonts/WorkSans-SemiBold.ttf"
