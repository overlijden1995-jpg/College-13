    def bf_denial_line(girl, action):
        """Returns a {hint}%(pl)s{/hint}-aware denial line based on CheatAttitude and tier escalation."""
        _discover_partner(girl)
        girl.discover("discovered_relationship")
        att = get_effective_cheat_attitude(girl, action=action)
        raw_att = get_effective_cheat_attitude(girl)  # without tier reduction
        cat = _bf_action_cat(action)

        # Lesbian: use dedicated pools (skip BF history — doesn't apply to GF context)
        if girl.has_trait("lesbian"):
            girl.discover("discovered_trait_lesbian")
            _tempt = int(getattr(girl, "Temptation", 0))
            _den_count = getattr(girl, "_les_denial_count", 0)
            girl._les_denial_count = _den_count + 1

            if _den_count >= 3:
                if _tempt >= 4:
                    _pool = LESBIAN_DENIAL_ANNOYED if renpy.random.random() < 0.60 else LESBIAN_DENIAL_CONFLICTED
                else:
                    _pool = LESBIAN_DENIAL_ANNOYED
            else:
                if _tempt >= 4:
                    _pool = LESBIAN_DENIAL_CONFLICTED
                else:
                    _pool = LESBIAN_DENIAL_FIRM

            _ld_lines = list(_pool.get(cat, _pool["sexual"]))
            if not girl.has_npc_partner():
                _ld_lines = [l for l in _ld_lines if "%(pl)s" not in l and "%(pp)s" not in l and "%(Pp)s" not in l and "%(po)s" not in l and "%(poss)s" not in l]
            return _tl(renpy.random.choice(_ld_lines))

        # BF sexual history denial: references what she has/hasn't done with BF
        # 40% chance on sexual actions (not kiss/touch/flirt) to add variety
        if cat not in ("kiss", "touch", "flirt") and renpy.random.random() < 0.40:
            hist_line = _get_bf_history_line(girl, action, "denial")
            if hist_line:
                return hist_line

        # Tier escalation denial: she's done lighter stuff but this is too far
        # Only fires when tier gap is the reason (raw attitude would allow, but tier reduces it)
        action_tier = _cheat_action_tier(action)
        max_tier = int(getattr(girl, "CheatMaxTier", 0))
        if action_tier > max_tier and raw_att >= 3:
            tier_line = _get_tier_escalation_line(girl, action, "denial")
            if tier_line:
