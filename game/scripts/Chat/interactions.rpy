                store._condom_last_trait = frozenset((trait,))
                return _format_partner_line(girl, _tl(renpy.random.choice(lines)))
        store._condom_last_trait = frozenset()
        return _format_partner_line(girl, _tl(renpy.random.choice(pools["_default"])))

