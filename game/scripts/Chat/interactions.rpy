                _conf_react_tier = "friendly" if _conf_ftier == "friendly" else "neutral"
                _confess_pool = NPC_CONFIDE_CONFESS_LINES.get(_conf_react_tier, NPC_CONFIDE_CONFESS_LINES["neutral"])
