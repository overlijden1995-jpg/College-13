    def partner_fmt(girl):
        """Every key of a line about her partner (_format_partner_line, and the pools that format by hand): he / she
        (gender_fmt), the partner noun and the words that agree with it (partner_label_fmt), his name (%(pn)s %(Pn)s)."""
        _is_f = girl.get_flag("partner_is_female") if hasattr(girl, "get_flag") else False
        _pl = girl.partner_label() if hasattr(girl, "partner_label") else _tr("partner")
        _pn = girl.partner_name() if hasattr(girl, "partner_name") else _pl
        _d = gender_fmt(_is_f)
        _d.update(partner_label_fmt(_is_f, _pl))
        _d["pn"] = _pn
        # first letter only: str.capitalize() lowercases the rest and would mangle "Mary Jane" / "MJ"
        _d["Pn"] = (_pn or _pl)[:1].upper() + (_pn or _pl)[1:]
        return _d

    def _format_partner_line(girl, line):
        """Translate a line about her partner and fill its keys (partner_fmt: %(pl)s boyfriend / girlfriend, %(pn)s his
        name, %(pp)s he / she..., the PT / ES endings, the Russian "r_" forms). The TRANSLATION decides whether there
        is something to fill: a language that declines (Russian) writes keys where the English has none."""
        if not line:
            return line
        _t = _tl(line)
        if "%(" not in _t:
            return _t
        return fmt_safe(_t, partner_fmt(girl), line)

