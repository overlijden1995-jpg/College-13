        # Playable girl partner watching as witness
        _wg = getattr(store, "_witness_girl", None)
        if _wg is not None and getattr(store, "_witness_watching", False):
            _gp_id = getattr(girl, "girl_partner_id", None)
            if _gp_id and _wg.gid == _gp_id:
                return (True, _wg.Name, "watching")
        # NPC partner just caught them — must belong to THIS girl
        if getattr(store, "_npc_witness_detected", False):
            _npc = getattr(store, "_npc_witness_npc", None)
            if _npc and hasattr(girl, "has_npc_partner") and girl.has_npc_partner():
                _girl_npc = get_npc_partner_for(girl) if callable(globals().get("get_npc_partner_for")) else None
                if _girl_npc is _npc:
                    return (True, getattr(_npc, "Name", "partner"), "just_caught")
        # NPC partner actually visible on scene (skip during threesomes — NPC can't be present)
