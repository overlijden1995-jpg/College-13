        _npc_girl = GIRL_BY_ID.get(npc.girl_gid)
        if not _npc_girl:
            renpy.return_statement()
        _npc_name = npc.name
        _girl_name = _npc_girl.Name
        # She is standing right here (he just saw you flirt with her, or you talked to him in front of her)
        _npc_girl_here = _npc_girl.loc == store.CurrentLocation
        debug_log("[NPC_SUSPICION] %s suspicion reached 100! Triggering confrontation for %s (here=%s)" % (_npc_name, _girl_name, _npc_girl_here))

    python:
        if _npc_girl_here:
            _susp_lines = [
                _("%s. Outside. Now."),
                _("We're leaving, %s. We need to talk."),
                _("I've seen enough. %s, let's go."),
            ]
        else:
            _susp_lines = [
                _("Something doesn't add up. I need to talk to %s."),
                _("I've been thinking... and I need answers. From %s."),
                _("Tell %s I'm coming to talk. Now."),
            ]
    $ Say_Line(npc, _tl_fmt(renpy.random.choice(_susp_lines), _girl_name))

    "[_npc_name] looks at you with cold eyes, then walks away."

    python:
        _npc_girl._npc_suspicion_pending = True
        _npc_girl.set_temp_status("unavailable", 1, reason="talking_to_partner")
        debug_log("[NPC_SUSPICION] %s set _npc_suspicion_pending=True, unavailable 1 day" % _girl_name)
        npc.hide_sprite()
        roster_remove(npc)   # out of the near slots too, or her leaving below slides him back in
        store._npc_on_scene = None

    if _npc_girl_here:
        $ set_scene_expression(_npc_girl, "worried")
        python:
            _leave_line = renpy.random.choice([
                _("%(Pn)s, wait! It's not what you think!"),
                _("I... I have to go after %(po)s."),
                _("Great. Just great. Don't follow me."),
            ])
        $ Say_Line(_npc_girl, _format_partner_line(_npc_girl, _leave_line))
        $ npc.loc = roster_girl_leaves(_npc_girl)

    "You have a feeling [_girl_name] is going to have a rough night."

    return

