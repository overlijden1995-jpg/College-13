    def bf_accept_line(girl, action):
        """Returns a {hint}%(pl)s{/hint}-aware acceptance line based on cheat count and tier crossing.
        Uses per-type count so 'only this once' properly evolves per act type."""
        _discover_partner(girl)
        att = get_effective_cheat_attitude(girl, action=action)
        cat = _bf_action_cat(action)
        acts = getattr(girl, "CheatActs", {})
        total = sum(acts.values())

        # Per-type count: how many times she cheated with THIS specific type
        _type_count = acts.get(str(action), 0)

        # Lesbian: dedicated accept lines (skip BF history / tier escalation)
        if girl.has_trait("lesbian"):
            _la_pool = LESBIAN_ACCEPT_LINES["repeat"] if _type_count > 0 else LESBIAN_ACCEPT_LINES["first"]
            _la_lines = list(_la_pool.get(cat, _la_pool["sexual"]))
            if not girl.has_npc_partner():
                _la_lines = [l for l in _la_lines if "%(pl)s" not in l and "%(pp)s" not in l and "%(Pp)s" not in l and "%(po)s" not in l and "%(poss)s" not in l]
            girl.discover("discovered_trait_lesbian")   # her accept states it ("doesn't make me straight")
            return _tl(renpy.random.choice(_la_lines))

        # Abandoned: player had history then neglected, girl found a partner
        if getattr(girl, "_hc_was_abandoned", False):
            _ab_cat = cat if cat in ("kiss", "touch", "flirt") else "sexual"
            _ab_lines = list(HC_ABANDONED_ACCEPT.get(_ab_cat, HC_ABANDONED_ACCEPT["sexual"]))
            return _tl(renpy.random.choice(_ab_lines))

        # Tier crossing: first time doing something heavier than before
        action_tier = _cheat_action_tier(action)
        max_tier = int(getattr(girl, "CheatMaxTier", 0))
        if action_tier > max_tier and not _is_cheater(girl):
            tier_line = _get_tier_escalation_line(girl, action, "accept")
            if tier_line:
                return tier_line

        # BF sexual history acceptance: first time doing this act, reference BF history
        # Only on first time (type_count == 0) and sexual actions
        if _type_count == 0 and cat == "sexual" and not _is_cheater(girl):
            hist_line = _get_bf_history_line(girl, action, "accept")
            if hist_line:
                return hist_line

        # Standard acceptance pools — degrading lines only after many repetitions
        # of THIS specific act type. First times always feel guilty/nervous.
        if _is_cheater(girl):
            # accepting with a partner: the deed plus her cheater pool's relish reveal it
            if hasattr(girl, "has_npc_partner") and girl.has_npc_partner():
                girl.discover("discovered_trait_cheater")
            # Cheater trait: still acknowledges novelty on first/second time per act
            if _type_count == 0:
                pool = BF_ATTITUDE_LINES["cheater_first_time"]
            elif _type_count == 1:
                pool = BF_ATTITUDE_LINES["cheater_second_time"]
            else:
                pool = BF_ATTITUDE_LINES["love_cheating"]
        elif _type_count == 0:
            # First time doing THIS act — guilt/nervousness regardless of attitude
            pool = BF_ATTITUDE_LINES["first_time_accept"]
        elif _type_count == 1:
            # Second time — "I promised I wouldn't do this again"
            pool = BF_ATTITUDE_LINES["second_time_accept"]
        elif _type_count >= 5 and att >= 6:
            # Veteran at this act + loves cheating — bf degradation lines
            pool = BF_ATTITUDE_LINES["love_cheating"]
        elif _type_count >= 5 or (att >= 6 and total >= 12):
            # Done it enough times to stop caring — casual acceptance
            pool = BF_ATTITUDE_LINES["easy_accept"]
        elif _type_count >= 2:
            # Repeated pattern (3rd-4th time) — past the guilt, becoming a habit
            pool = BF_ATTITUDE_LINES["repeat_accept"]
        else:
            # Should not reach here, but fallback
            pool = BF_ATTITUDE_LINES["second_time_accept"]

        lines = pool.get(cat, pool.get("sexual", ["...Fine."]))
        return _tl(renpy.random.choice(lines))

