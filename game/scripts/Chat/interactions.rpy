        Also stores the matched trait(s) in store._condom_last_trait for consistency checks."""
        _gt = getattr(girl, "traits", set()) or set()
        _in_public = _is_public_location()
        _girl_has_bf = hasattr(girl, "has_npc_partner") and girl.has_npc_partner()
        _anyone_dating = _girl_has_bf or player_has_girlfriend(store.ALL_GIRLS)
        # Check combos first (largest combo wins)
        _rec_active = getattr(store, "_recording_active", False)
        if combo_pools:
            for combo in sorted(combo_pools, key=len, reverse=True):
                if combo.issubset(_gt):
                    # Skip location-bound combos when not in public
                    if not _in_public and combo & _LOCATION_BOUND_TRAITS:
                        continue
                    # Skip bf-bound combos when nobody is in a relationship
                    if not _anyone_dating and combo & _BF_BOUND_TRAITS:
                        continue
                    # Skip camera_lover combos when not recording
                    if "camera_lover" in combo and not _rec_active:
                        continue
                    # Discover traits revealed by combo lines
