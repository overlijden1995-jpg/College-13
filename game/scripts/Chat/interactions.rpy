                    return _format_partner_line(girl, _tl(renpy.random.choice(combo_pools[combo])))
        # Single trait
        for trait, lines in pools.items():
            if trait == "_default":
                continue
            # Skip location-bound traits when not in public
            if not _in_public and trait in _LOCATION_BOUND_TRAITS:
                continue
            # Skip bf-bound traits when nobody is in a relationship
            if not _anyone_dating and trait in _BF_BOUND_TRAITS:
