    python:
        _gossip_targets = []
        for _og in ALL_GIRLS:
            if _og.gid != girl.gid:
                _friendship = girl.get_like_for(_og.gid)
                _gossip_targets.append(("%s (%s: %d)" % (_og.Name, _tr("Friendship"), _friendship), _og))
        _gossip_targets.append((_tl(_("Back")), "_back"))
        _chosen = renpy.display_menu(_gossip_targets)

    if _chosen == "_back":
        return

    python:
        _target = _chosen
        _old_val = girl.get_like_for(_target.gid)
        girl.add_like_for(_target.gid, -100)
        _new_val = girl.get_like_for(_target.gid)
        store._gossip_used_today = True

        # Pick reaction line and expression based on friendship level
        if _old_val >= 800:
            _gossip_expr = "sad"
            _gossip_lines = [
                _("Hmm... she's my best friend, but I guess you have a point..."),
                _("Really? She'd never... would she? That's hard to hear."),
                _("I don't want to believe that about her... but thanks for telling me, I guess."),
            ]
        elif _old_val >= 500:
            _gossip_expr = "worried"
            _gossip_lines = [
                _("Huh. I didn't know that about her. Interesting..."),
                _("Yeah? That's kind of messed up if true."),
                _("Thanks for the heads up. I'll keep my guard up around her."),
            ]
        elif _old_val >= 200:
            _gossip_expr = "serious"
            _gossip_lines = [
                _("That doesn't surprise me at all. She's always been shady."),
                _("Yeah, I already had my doubts about her. This confirms it."),
                _("Figures. I never really trusted her anyway."),
            ]
        else:
            _gossip_expr = "smirk"
            _gossip_lines = [
                _("You're telling ME? I already can't stand her."),
                _("One more reason to hate her. Thanks."),
                _("I know. I know exactly what kind of person she is."),
            ]

    $ set_scene_expression(girl, _gossip_expr)
    $ Say_Line(girl, _tl(renpy.random.choice(_gossip_lines)))
    $ set_scene_expression(girl, "normal")
    "You spread some gossip about [_target.Name]. [girl.Name]'s opinion of her dropped."
    return

