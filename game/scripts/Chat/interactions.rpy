                _stoke_line = _tl(renpy.random.choice(_stoke_pool))
            $ Say_Line(npc, _stoke_line)
            $ Change_NPC_Status(npc, "friendship_with_player", -5)
            $ Change_NPC_Status(npc, "suspicion", 15)
