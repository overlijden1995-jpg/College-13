            $ Say_Line(npc, _confess_line)
            $ Change_NPC_Status(npc, "friendship_with_player", -300)
            python:
                _conf_susp_delta = 100 - getattr(npc, "suspicion", 0)
                if _conf_susp_delta > 0:
                    Change_NPC_Status(npc, "suspicion", _conf_susp_delta)
                debug_log("[NPC_CONFIDE] Player CONFESSED to %s! friendship -300, suspicion → 100" % _conf_npc_name)
            if _conf_react_tier == "friendly":
                $ Narration(_tl(_("%s stares at you in disbelief, then turns and walks away without another word.")) % _conf_npc_name)
            else:
                $ Narration(_tl(_("%s's fists clench. You brace yourself, but %s just storms off without another word.")) % (_conf_npc_name, _conf_npc_name))
            call npc_suspicion_confrontation(npc) from _call_npc_suspicion_confront_confide
